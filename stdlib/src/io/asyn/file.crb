//! Asynchronous file operations dispatched to the runtime's blocking workers.

#(if: target.os == "linux" && target.arch == "x86_64" && target.pointer_width == "64" || target.os == "macos" && target.arch == "aarch64" || target.os == "macos" && target.arch == "x86_64" || target.os == "windows" && target.arch == "aarch64" || target.os == "windows" && target.arch == "x86_64")
    use std::io::{File as BlockingFile, FileError as BlockingError, FilePerm, FileStats, SeekFrom};

    /// Owns a blocking file handle and exposes operations that await worker completion.
    pub struct File {
        /// Owned platform-specific object used to dispatch this portable wrapper's operations.
        inner: BlockingFile,
    }

    /// Reports file errors or the runtime's failure to launch a worker.
    pub enum FileError {
        /// The supplied path violates the platform path-input contract.
        InvalidPath,
        /// The requested open-mode combination is invalid.
        InvalidOptions,
        /// Preserves the native operating-system error code in code.
        Os {
            /// Native operating-system status code preserved by this error.
            code: i64
        },
        /// The runtime could not launch the blocking worker.
        LaunchFailed,
    }

    /// Converts a backend error to the corresponding error of this API.
    fn translate_error(error: BlockingError) -> FileError {
        match error {
            BlockingError.InvalidPath => { FileError.InvalidPath },
            BlockingError.InvalidOptions => { FileError.InvalidOptions },
            BlockingError.Os { code: code } => { FileError.Os { code: code } },
        }
    }

    /// Opens or creates the blocking file from a worker task.
    async fn open_on_worker(path: &[u8], mode: i64, create: bool, perm: FilePerm) -> Result<BlockingFile, BlockingError> {
        if create { return BlockingFile::create(path, mode, perm); }
        BlockingFile::open(path, mode)
    }

    /// Launches and awaits the open worker, then wraps the owned file handle.
    async fn open_file(path: &[u8], mode: i64, create: bool, perm: FilePerm) -> Result<File, FileError> {
        let worker = runtime::spawn_blocking(open_on_worker(path, mode, create, perm));
        match worker.await {
            Ok(result) => {
                match result {
                    Ok(inner) => { Ok(File { inner: inner }) },
                    Err(error) => { Err(translate_error(error)) },
                }
            },
            Err(error) => { drop(error); Err(FileError.LaunchFailed) },
        }
    }

    /// Reads into the supplied buffer from a blocking worker.
    async fn read_on_worker(file: &mut BlockingFile, buffer: &mut [u8]) -> Result<usize, BlockingError> {
        file.read(buffer)
    }

    /// Writes from the supplied buffer on a blocking worker.
    async fn write_on_worker(file: &mut BlockingFile, buffer: &[u8]) -> Result<usize, BlockingError> {
        file.write(buffer)
    }

    /// Moves the file cursor on a blocking worker.
    async fn seek_on_worker(file: &mut BlockingFile, from: SeekFrom) -> Result<u64, BlockingError> {
        file.seek(from)
    }

    /// Renames the filesystem entry on a blocking worker.
    async fn rename_on_worker(source: &[u8], destination: &[u8]) -> Result<(), BlockingError> {
        BlockingFile::rename(source, destination)
    }

    /// Reads file metadata on a blocking worker.
    async fn stats_on_worker(file: &BlockingFile) -> Result<FileStats, BlockingError> {
        file.stats()
    }

    /// Removes the file on a blocking worker.
    async fn delete_on_worker(path: &[u8]) -> Result<(), BlockingError> {
        BlockingFile::delete(path)
    }

    impl File {
        /// Awaits opening an existing file with the selected mode. The path needs one trailing NUL.
        async fn open(path: &[u8], mode: i64) -> Result<File, FileError> {
            open_file(path, mode, false, FilePerm.DefaultMode).await
        }

        /// Awaits opening or creating a file with the selected mode and permissions. The path needs one trailing NUL.
        async fn create(path: &[u8], mode: i64, perm: FilePerm) -> Result<File, FileError> {
            open_file(path, mode, true, perm).await
        }

        /// Awaits a read into the caller's buffer and returns the actual byte count.
        async fn read(&mut self, buffer: &mut [u8]) -> Result<usize, FileError> {
            if buffer.len() == 0 { return Ok(0); }
            let inner = &mut (*self).inner;
            let worker = runtime::spawn_blocking(read_on_worker(inner, buffer));
            match worker.await {
                Ok(result) => {
                    match result {
                        Ok(count) => { Ok(count) },
                        Err(error) => { Err(translate_error(error)) },
                    }
                },
                Err(error) => { drop(error); Err(FileError.LaunchFailed) },
            }
        }

        /// Awaits a write from the caller's buffer and returns the actual byte count.
        async fn write(&mut self, buffer: &[u8]) -> Result<usize, FileError> {
            if buffer.len() == 0 { return Ok(0); }
            let inner = &mut (*self).inner;
            let worker = runtime::spawn_blocking(write_on_worker(inner, buffer));
            match worker.await {
                Ok(result) => {
                    match result {
                        Ok(count) => { Ok(count) },
                        Err(error) => { Err(translate_error(error)) },
                    }
                },
                Err(error) => { drop(error); Err(FileError.LaunchFailed) },
            }
        }

        /// Awaits moving the file cursor and returns the new absolute byte offset.
        async fn seek(&mut self, from: SeekFrom) -> Result<u64, FileError> {
            let inner = &mut (*self).inner;
            let worker = runtime::spawn_blocking(seek_on_worker(inner, from));
            match worker.await {
                Ok(result) => {
                    match result {
                        Ok(position) => { Ok(position) },
                        Err(error) => { Err(translate_error(error)) },
                    }
                },
                Err(error) => { drop(error); Err(FileError.LaunchFailed) },
            }
        }

        /// Awaits a snapshot of the open file's metadata.
        async fn stats(&self) -> Result<FileStats, FileError> {
            let inner = &(*self).inner;
            let worker = runtime::spawn_blocking(stats_on_worker(inner));
            match worker.await {
                Ok(result) => {
                    match result {
                        Ok(stats) => { Ok(stats) },
                        Err(error) => { Err(translate_error(error)) },
                    }
                },
                Err(error) => { drop(error); Err(FileError.LaunchFailed) },
            }
        }

        /// Awaits moving a filesystem entry to a different path.
        async fn rename(source: &[u8], destination: &[u8]) -> Result<(), FileError> {
            let worker = runtime::spawn_blocking(rename_on_worker(source, destination));
            match worker.await {
                Ok(result) => {
                    match result {
                        Ok(()) => { Ok(()) },
                        Err(error) => { Err(translate_error(error)) },
                    }
                },
                Err(error) => { drop(error); Err(FileError.LaunchFailed) },
            }
        }

        /// Awaits removing a file by path.
        async fn delete(path: &[u8]) -> Result<(), FileError> {
            let worker = runtime::spawn_blocking(delete_on_worker(path));
            match worker.await {
                Ok(result) => {
                    match result {
                        Ok(()) => { Ok(()) },
                        Err(error) => { Err(translate_error(error)) },
                    }
                },
                Err(error) => { drop(error); Err(FileError.LaunchFailed) },
            }
        }
    }
#(endif)
