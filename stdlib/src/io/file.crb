// SPDX-License-Identifier: MIT OR Apache-2.0
//! Portable blocking file I/O, open modes, permissions and seek origins.

#(if: target.os == "linux" && target.arch == "x86_64" && target.pointer_width == "64" || target.os == "macos" && target.arch == "aarch64" || target.os == "macos" && target.arch == "x86_64")
    use std::sys::unix::{File as PlatformFile, FileError as PlatformError};
#(endif)
#(if: target.os == "windows" && target.arch == "aarch64" || target.os == "windows" && target.arch == "x86_64")
    use std::sys::win::{File as PlatformFile, FileError as PlatformError};
#(endif)

#(if: target.os == "linux" && target.arch == "x86_64" && target.pointer_width == "64" || target.os == "macos" && target.arch == "aarch64" || target.os == "macos" && target.arch == "x86_64" || target.os == "windows" && target.arch == "aarch64" || target.os == "windows" && target.arch == "x86_64")
    /// Owns an open file and closes the platform handle when destroyed.
    pub struct File {
        /// Owned platform-specific object used to dispatch this portable wrapper's operations.
        inner: PlatformFile,
        /// Original access/append flags, retained for positioned-operation validation.
        mode: i64,
    }

    /// Reports invalid path or options, or an error code from the operating system.
    pub enum FileError {
        /// The supplied path violates the platform path-input contract.
        InvalidPath,
        /// The requested open-mode combination is invalid.
        InvalidOptions,
        /// Preserves the native operating-system error code in code.
        Os {
            /// Native operating-system status code preserved by this error.
            code: i64
        },
    }

    /// Converts a backend error to the corresponding error of this API.
    fn translate_error(error: PlatformError) -> FileError {
        match error {
            PlatformError.InvalidPath => { FileError.InvalidPath },
            PlatformError.Os { code: code } => { FileError.Os { code: code } },
        }
    }


    /// Copies a UTF-8 path into bounded syscall storage and adds its NUL.
    /// Public paths exclude NUL; empty paths, embedded NUL and paths over
    /// 32767 UTF-8 bytes are rejected before any OS call.
    fn prepare_path(path: &str, terminated: &mut [u8]) -> bool {
        let bytes = path.as_bytes();
        let length = bytes.len();
        if length == 0 || length >= terminated.len() { return false; }
        let mut i: usize = 0;
        while i < length {
            if bytes[i] == 0 { return false; }
            terminated[i] = bytes[i];
            i += 1;
        }
        terminated[length] = 0;
        true
    }

    /// Validates independent public mode bits and maps access to the native ABI.
    fn open_file(path: &str, mode: i64, perm: u32) -> Result<File, FileError> {
        if mode < 0 || (mode & 127) != mode { return Err(FileError.InvalidOptions); }
        let access = mode & 3;
        let write = (access & 2) != 0;
        let create = (mode & 16) != 0;
        if access == 0 || (!write && (mode & 12) != 0)
            || ((mode & 32) != 0 && !create) {
            return Err(FileError.InvalidOptions);
        }
        let native_access: i64 = if access == 1 { 0 } else if access == 2 { 1 } else { 2 };
        let native_mode = native_access | (mode & 124);
        let bytes = path.as_bytes();
        let length = bytes.len();
        let mut terminated: [u8; 32768] = [0; 32768];
        if !prepare_path(path, &mut terminated[..]) { return Err(FileError.InvalidPath); }
        match PlatformFile::open(&terminated[..length + 1], native_mode, create, perm) {
            Ok(inner) => { Ok(File { inner: inner, mode: native_mode }) },
            Err(error) => { Err(translate_error(error)) },
        }
    }

    impl File {
        /// Opens a UTF-8 path with independent OR-combined FileMode flags.
        /// CREATE uses default creation permissions; no trailing NUL is required.
        fn open(path: &str, mode: i64) -> Result<File, FileError> {
            open_file(path, mode, 0xffffffff)
        }

        /// Opens or creates a UTF-8 path with explicit creation permissions.
        /// CREATE is implied; TRUNCATE and EXCLUSIVE remain explicit flags.
        fn create(path: &str, mode: i64, perm: FilePerm) -> Result<File, FileError> {
            let bits: u32 = match perm {
                FilePerm.DefaultMode => { 0xffffffff },
                FilePerm.Perm(bits) => {
                    if bits > 0x1ff { return Err(FileError.InvalidOptions); }
                    bits
                },
            };
            open_file(path, mode | 16, bits)
        }

        /// Reads into the caller's slice and returns the bytes copied. An empty buffer returns zero.
        fn read(&mut self, buffer: &mut [u8]) -> Result<usize, FileError> {
            let inner = &mut (*self).inner;
            match inner.read(buffer) {
                Ok(count) => { Ok(count) },
                Err(error) => { Err(translate_error(error)) },
            }
        }

        /// Writes bytes from the caller's slice and returns the number accepted, which may be less than its length.
        fn write(&mut self, buffer: &[u8]) -> Result<usize, FileError> {
            let inner = &mut (*self).inner;
            match inner.write(buffer) {
                Ok(count) => { Ok(count) },
                Err(error) => { Err(translate_error(error)) },
            }
        }

        /// Reads into the caller's buffer at offset without moving the cursor; short transfers are allowed.
        /// Rejects unrepresentable ranges and write-only mode. Valid empty ranges return zero.
        fn read_at(&self, buffer: &mut [u8], offset: u64) -> Result<usize, FileError> {
            if copy(offset) > 9223372036854775807 || buffer.len() as u64 > 9223372036854775807 - copy(offset) {
                return Err(FileError.InvalidOptions);
            }
            if buffer.len() == 0 { return Ok(0); }
            if ((*self).mode & 3) == 1 { return Err(FileError.InvalidOptions); }
            let inner = &(*self).inner;
            match inner.read_at(buffer, offset) {
                Ok(count) => { Ok(count) },
                Err(error) => { Err(translate_error(error)) },
            }
        }

        /// Writes from the caller's buffer at offset without moving the cursor; short transfers are allowed.
        /// Rejects unrepresentable ranges and read-only/append modes. Valid empty ranges return zero.
        fn write_at(&self, buffer: &[u8], offset: u64) -> Result<usize, FileError> {
            if copy(offset) > 9223372036854775807 || buffer.len() as u64 > 9223372036854775807 - copy(offset) {
                return Err(FileError.InvalidOptions);
            }
            if buffer.len() == 0 { return Ok(0); }
            if ((*self).mode & 3) == 0 || ((*self).mode & 4) != 0 { return Err(FileError.InvalidOptions); }
            let inner = &(*self).inner;
            match inner.write_at(buffer, offset) {
                Ok(count) => { Ok(count) },
                Err(error) => { Err(translate_error(error)) },
            }
        }

        /// Moves the file cursor relative to the supplied origin and returns its new absolute position.
        fn seek(&mut self, from: SeekFrom) -> Result<u64, FileError> {
            let mut origin: i64 = 0;
            let offset = match from {
                SeekFrom.Start(offset) => {
                    if copy(offset) < 0 { return Err(FileError.InvalidOptions); }
                    offset
                },
                SeekFrom.Current(offset) => { origin = 1; offset },
                SeekFrom.End(offset) => { origin = 2; offset },
            };
            let inner = &mut (*self).inner;
            match inner.seek(offset, origin) {
                Ok(position) => { Ok(position) },
                Err(error) => { Err(translate_error(error)) },
            }
        }

        /// Persists this file's contents/metadata; does not sync a parent directory or create a transaction.
        fn sync_all(&mut self) -> Result<(), FileError> {
            let inner = &mut (*self).inner;
            match inner.sync_all() {
                Ok(()) => { Ok(()) },
                Err(error) => { Err(translate_error(error)) },
            }
        }

        /// Sets the file length, preserving the cursor. Sizes beyond i64::MAX are invalid.
        fn truncate(&mut self, length: u64) -> Result<(), FileError> {
            if copy(length) > 9223372036854775807 { return Err(FileError.InvalidOptions); }
            let inner = &mut (*self).inner;
            match inner.truncate(length) {
                Ok(()) => { Ok(()) },
                Err(error) => { Err(translate_error(error)) },
            }
        }

        /// Returns a snapshot of file metadata from its open handle.
        fn stats(&self) -> Result<FileStats, FileError> {
            let inner = &(*self).inner;
            match inner.size() {
                Ok(size) => { Ok(FileStats { size_bytes: size }) },
                Err(error) => { Err(translate_error(error)) },
            }
        }

        /// Renames a file from the source path to the destination path using platform semantics.
        fn rename(source: &str, destination: &str) -> Result<(), FileError> {
            let source_bytes = source.as_bytes();
            let source_length = source_bytes.len();
            let destination_bytes = destination.as_bytes();
            let destination_length = destination_bytes.len();
            let mut source_z: [u8; 32768] = [0; 32768];
            let mut destination_z: [u8; 32768] = [0; 32768];
            if !prepare_path(source, &mut source_z[..]) || !prepare_path(destination, &mut destination_z[..]) { return Err(FileError.InvalidPath); }
            match PlatformFile::rename(&source_z[..source_length + 1], &destination_z[..destination_length + 1]) {
                Ok(()) => { Ok(()) },
                Err(error) => { Err(translate_error(error)) },
            }
        }

        /// Removes the file named by the supplied path.
        fn delete(path: &str) -> Result<(), FileError> {
            let bytes = path.as_bytes();
            let length = bytes.len();
            let mut terminated: [u8; 32768] = [0; 32768];
            if !prepare_path(path, &mut terminated[..]) { return Err(FileError.InvalidPath); }
            match PlatformFile::delete(&terminated[..length + 1]) {
                Ok(()) => { Ok(()) },
                Err(error) => { Err(translate_error(error)) },
            }
        }
    }
#(endif)
