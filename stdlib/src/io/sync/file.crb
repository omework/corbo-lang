//! Portable blocking file I/O, open modes, permissions and seek origins.

#(if: target.os == "linux" && target.arch == "x86_64" && target.pointer_width == "64" || target.os == "macos" && target.arch == "aarch64" || target.os == "macos" && target.arch == "x86_64")
    use std::sys::unix::{File as PlatformFile, FileError as PlatformError};
#(endif)
#(if: target.os == "windows" && target.arch == "aarch64" || target.os == "windows" && target.arch == "x86_64")
    use std::sys::win::{File as PlatformFile, FileError as PlatformError};
#(endif)

#(if: target.os == "linux" && target.arch == "x86_64" && target.pointer_width == "64" || target.os == "macos" && target.arch == "aarch64" || target.os == "macos" && target.arch == "x86_64" || target.os == "windows" && target.arch == "aarch64" || target.os == "windows" && target.arch == "x86_64")
    /// Owns an open file and closes the platform handle when destroyed.
    pub struct File {
        /// Owned platform-specific object used to dispatch this portable wrapper's operations.
        inner: PlatformFile,
    }

    /// Reports invalid path or options, or an error code from the operating system.
    pub enum FileError {
        /// The supplied path violates the platform path-input contract.
        InvalidPath,
        /// The requested open-mode combination is invalid.
        InvalidOptions,
        /// Preserves the native operating-system error code in code.
        Os {
            /// Native operating-system status code preserved by this error.
            code: i64
        },
    }

    /// Converts a backend error to the corresponding error of this API.
    fn translate_error(error: PlatformError) -> FileError {
        match error {
            PlatformError.InvalidPath => { FileError.InvalidPath },
            PlatformError.Os { code: code } => { FileError.Os { code: code } },
        }
    }

    use std::io::{FileStats, FilePerm, SeekFrom, FileMode};

    /// Validates the access mode and flags before dispatching to the platform backend.
    fn open_file(path: &[u8], mode: i64, create: bool, perm: u32) -> Result<File, FileError> {
        if copy(mode) < 0 || copy(mode) > 15 { return Err(FileError.InvalidOptions); }
        let access = copy(mode) & 3;
        let flags = copy(mode) & 12;
        if copy(access) == 3 || (access == 0 && copy(flags) != 0) || flags == 12 {
            return Err(FileError.InvalidOptions);
        }
        match PlatformFile::open(path, mode, create, perm) {
            Ok(inner) => { Ok(File { inner: inner }) },
            Err(error) => { Err(translate_error(error)) },
        }
    }

    impl File {
        /// Opens an existing file with the requested access mode and flags. The path needs one trailing NUL.
        fn open(path: &[u8], mode: i64) -> Result<File, FileError> { open_file(path, mode, false, 0xffffffff) }

        /// Opens or creates a file with the requested mode and creation permissions. The path needs one trailing NUL.
        fn create(path: &[u8], mode: i64, perm: FilePerm) -> Result<File, FileError> {
            let bits: u32 = match perm {
                FilePerm.DefaultMode => { 0xffffffff },
                FilePerm.Perm(bits) => {
                    if copy(bits) > 0x1ff { return Err(FileError.InvalidOptions); }
                    bits
                },
            };
            open_file(path, mode, true, bits)
        }

        /// Reads into the caller's slice and returns the bytes copied. An empty buffer returns zero.
        fn read(&mut self, buffer: &mut [u8]) -> Result<usize, FileError> {
            let inner = &mut (*self).inner;
            match inner.read(buffer) {
                Ok(count) => { Ok(count) },
                Err(error) => { Err(translate_error(error)) },
            }
        }

        /// Writes bytes from the caller's slice and returns the number accepted, which may be less than its length.
        fn write(&mut self, buffer: &[u8]) -> Result<usize, FileError> {
            let inner = &mut (*self).inner;
            match inner.write(buffer) {
                Ok(count) => { Ok(count) },
                Err(error) => { Err(translate_error(error)) },
            }
        }

        /// Moves the file cursor relative to the supplied origin and returns its new absolute position.
        fn seek(&mut self, from: SeekFrom) -> Result<u64, FileError> {
            let mut origin: i64 = 0;
            let offset = match from {
                SeekFrom.Start(offset) => {
                    if copy(offset) < 0 { return Err(FileError.InvalidOptions); }
                    offset
                },
                SeekFrom.Current(offset) => { origin = 1; offset },
                SeekFrom.End(offset) => { origin = 2; offset },
            };
            let inner = &mut (*self).inner;
            match inner.seek(offset, origin) {
                Ok(position) => { Ok(position) },
                Err(error) => { Err(translate_error(error)) },
            }
        }

        /// Returns a snapshot of file metadata from its open handle.
        fn stats(&self) -> Result<FileStats, FileError> {
            let inner = &(*self).inner;
            match inner.size() {
                Ok(size) => { Ok(FileStats { size_bytes: size }) },
                Err(error) => { Err(translate_error(error)) },
            }
        }

        /// Renames a file from the source path to the destination path using platform semantics.
        fn rename(source: &[u8], destination: &[u8]) -> Result<(), FileError> {
            match PlatformFile::rename(source, destination) {
                Ok(()) => { Ok(()) },
                Err(error) => { Err(translate_error(error)) },
            }
        }

        /// Removes the file named by the supplied path.
        fn delete(path: &[u8]) -> Result<(), FileError> {
            match PlatformFile::delete(path) {
                Ok(()) => { Ok(()) },
                Err(error) => { Err(translate_error(error)) },
            }
        }
    }
#(endif)
