//! Errors returned by checked UTF-8 text slicing with `try_slice`.

/// Describes why a requested byte range cannot form a borrowed UTF-8 view.
pub enum SliceError {
    /// A bound is negative, reversed, or greater than the source byte length.
    OutOfBounds;
    /// The bounds are in range, but one cuts through a UTF-8 encoded character.
    NotCharBoundary;
}
