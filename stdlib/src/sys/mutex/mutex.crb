//! Trusted runtime mutex bindings; native handles are opaque resource identities.

/// Allocates stable native state for the selected blocking or asynchronous policy.
pub fn create(asynchronous: bool) -> usize {
    let mut raw: usize = 0;
    @unchecked { @c { ${raw}=mutex_create(${asynchronous}); } }
    raw
}
/// Acquires the synchronous native mutex on this thread.
pub fn acquire(raw: usize) { @unchecked { @c { mutex_acquire(${raw}); } } }
/// Releases a native-thread guard or an asynchronous logical guard.
pub fn release(raw: usize) { @unchecked { @c { mutex_release(${raw}); } } }
/// Destroys native state once no guard or pending lock future can use it.
pub fn destroy(raw: usize) { @unchecked { @c { mutex_destroy(${raw}); } } }
/// Runtime-designated poll suspension point; callers must keep the owner alive.
pub async fn wait(raw: usize) -> i64 { runtime::wait_mutex(raw) }
