    pub fn write_at(handle: u64, buffer: &[u8], offset: u64) -> (i64, usize) {
        let mut length = buffer.len();
        if length == 0 { return (0, 0); }
        if length > 4294967295 { length = 4294967295; }
        let mut event: u64 = 0;
        let mut count: usize = 0;
        let mut error: i64 = 0;
        @unchecked {
            @asm {
                sub rsp, 32
                xor ecx, ecx
                mov edx, 1
                xor r8d, r8d
                xor r9d, r9d
                call CreateEventW
                test rax, rax
                jz 1f
                mov ${event}, rax
                jmp 2f
                1:
                call GetLastError
                mov eax, eax
                mov ${error}, rax
                2:
                add rsp, 32
            }
        }
        if error != 0 { return (error, 0); }
        @unchecked {
            let address = addr(&buffer[0]);
            @asm {
                sub rsp, 80
                mov QWORD PTR [rsp + 40], 0
                mov QWORD PTR [rsp + 48], 0
                mov rax, ${offset}
                mov QWORD PTR [rsp + 56], rax
                mov rax, ${event}
                mov QWORD PTR [rsp + 64], rax
                mov DWORD PTR [rsp + 72], 0
                mov rcx, ${handle}
                mov rdx, ${address}
                mov r8, ${length}
                lea r9, [rsp + 72]
                lea rax, [rsp + 40]
                mov QWORD PTR [rsp + 32], rax
                call WriteFile
                test eax, eax
                jnz 3f
                call GetLastError
                cmp eax, 997
                je 3f
                mov eax, eax
                mov ${error}, rax
                jmp 5f
                3:
                mov rcx, ${handle}
                lea rdx, [rsp + 40]
                lea r8, [rsp + 72]
                mov r9d, 1
                call GetOverlappedResult
                test eax, eax
                jz 4f
                mov eax, DWORD PTR [rsp + 72]
                mov ${count}, rax
                jmp 5f
                4:
                call GetLastError
                mov eax, eax
                mov ${error}, rax
                5:
                add rsp, 80
