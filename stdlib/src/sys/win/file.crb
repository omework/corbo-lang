//! Windows file ownership and translation of native file errors.

#(if: target.os == "windows" && target.arch == "aarch64" || target.os == "windows" && target.arch == "x86_64")
    /// Owns sequential and OVERLAPPED Windows file HANDLEs; destruction closes both.
    pub struct File {
        // Win64 HANDLE is an opaque 64-bit value.
        /// Owned Windows HANDLE value; drop closes it once after a move.
        handle: u64;
        /// Owned OVERLAPPED companion used only for explicit-offset requests.
        positioned: u64;

        /// Opens or creates a Windows file with the supplied mode and permissions.
        pub fn open(path: &[u8], mode: i64, create: bool, perm: u32) Result<File, FileError> {
            let saved_mode = copy(mode);
            let (valid, error, handle) = std::sys::win::native::open(path, mode, create, perm);
            if !valid {
                return Err(FileError::InvalidPath);
            }
            if error != 0 {
                return Err(FileError::Os { code: -error });
            }
            let (positioned_error, positioned) = std::sys::win::native::reopen_positioned(copy(handle), saved_mode);
            if positioned_error != 0 {
                std::sys::win::native::close(handle);
                return Err(FileError::Os { code: -positioned_error });
            }
            Ok(File { handle: handle, positioned: positioned })
        }

        /// Reads into the caller's slice and returns the bytes copied. An empty buffer returns zero.
        pub fn read(&mut self, buffer: &mut [u8]) Result<usize, FileError> {
            let handle = (*self).handle;
            let (raw, count) = std::sys::win::native::read(handle, buffer);
            if raw != 0 {
                return Err(FileError::Os { code: -raw });
            }
            Ok(count)
        }

        /// Writes bytes from the caller's slice and returns the number accepted, which may be less than its length.
        pub fn write(&mut self, buffer: &[u8]) Result<usize, FileError> {
            let (raw, count) = std::sys::win::native::write((*self).handle, buffer);
            if raw != 0 { return Err(FileError::Os { code: -raw }); }
            Ok(count)
        }

        /// Performs a positioned read without changing the original descriptor/handle cursor.
        pub fn read_at(&self, buffer: &mut [u8], offset: u64) Result<usize, FileError> {
            let (raw, count) = std::sys::win::native::read_at((*self).positioned, buffer, offset);
            if raw != 0 { return Err(FileError::Os { code: -raw }); }
            Ok(count)
        }

        /// Performs a positioned write without changing the original descriptor/handle cursor.
        pub fn write_at(&self, buffer: &[u8], offset: u64) Result<usize, FileError> {
            let (raw, count) = std::sys::win::native::write_at((*self).positioned, buffer, offset);
            if raw != 0 { return Err(FileError::Os { code: -raw }); }
            Ok(count)
        }

        /// Seeks relative to the native origin and returns the resulting offset.
        pub fn seek(&mut self, offset: i64, origin: i64) Result<u64, FileError> {
            let (raw, position) = std::sys::win::native::seek((*self).handle, offset, origin);
            if raw != 0 { return Err(FileError::Os { code: -raw }); }
            Ok(position)
        }

        /// Persists file contents and metadata, propagating native flush failures.
        pub fn sync_all(&mut self) Result<(), FileError> {
            let raw = std::sys::win::native::sync_all((*self).handle);
            if raw != 0 { return Err(FileError::Os { code: -raw }); }
            Ok(())
        }

        /// Changes file length without moving the cursor; growth is zero-filled by the OS.
        pub fn truncate(&mut self, length: u64) Result<(), FileError> {
            let raw = std::sys::win::native::truncate((*self).handle, length);
            if raw != 0 { return Err(FileError::Os { code: -raw }); }
            Ok(())
        }

        /// Queries the file size from the open HANDLE.
        pub fn size(&self) Result<u64, FileError> {
            let (raw, count) = std::sys::win::native::stats((*self).handle);
            if raw != 0 { return Err(FileError::Os { code: -raw }); }
            Ok(count)
        }

        /// Renames a filesystem entry using the Windows backend.
        pub fn rename(source: &[u8], destination: &[u8]) Result<(), FileError> {
            let (valid, raw) = std::sys::win::native::rename(source, destination);
            if !valid { return Err(FileError::InvalidPath); }
            if raw != 0 { return Err(FileError::Os { code: -raw }); }
            Ok(())
        }

        /// Removes the named file using the Windows backend.
        pub fn delete(path: &[u8]) Result<(), FileError> {
            let (valid, raw) = std::sys::win::native::delete(path);
            if !valid { return Err(FileError::InvalidPath); }
            if raw != 0 { return Err(FileError::Os { code: -raw }); }
            Ok(())
        }

        /// Releases the native resource owned by the value.
        fn drop(&mut self) {
            std::sys::win::native::close((*self).positioned);
            std::sys::win::native::close((*self).handle);
        }

}

    /// Reports an invalid path or native Windows error code.
    pub enum FileError {
        /// The supplied path violates the platform path-input contract.
        InvalidPath;
        /// Preserves the native operating-system error code in code.
        Os {
            /// Native operating-system status code preserved by this error.
            code: i64;
        };
    }

#(endif)
