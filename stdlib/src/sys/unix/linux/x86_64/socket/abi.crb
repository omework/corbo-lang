//! Linux x86-64 socket operations and address layouts using the syscall ABI.

#(if: target.os == "linux" && target.arch == "x86_64" && target.pointer_width == "64")
    /// Initializes the platform socket subsystem where initialization is required.
    pub fn startup() -> i64 { 0 }

    /// Releases platform socket subsystem state acquired by startup.
    pub fn cleanup() {}

    /// Creates a Linux IPv4 socket of the requested kind and returns its status and descriptor.
    pub fn open(kind: i64) -> (i64, u64) {
        let mut socket: u64 = 0;
        let mut status: i64 = 0;
        @unchecked {
            @asm {
                mov rdi, 2
                mov rsi, ${kind}
                mov rdx, 0
                or esi, 0x80000
                mov eax, 41
                syscall
                mov ${socket}, rax
                test rax, rax
                jns 2f
                mov ${status}, rax
                2:
            }
        }
        (status, socket)
    }

    /// Requests a connection to the IPv4 address and port and returns a native status.
    pub fn connect(socket: u64, ipv4: u32, port: u16) -> i64 {
        let port_bits = port as usize;
        let ipv4_bits = ipv4 as usize;
        let mut raw: i64 = 0;
        @unchecked {
            @asm {
                sub rsp, 16
                mov DWORD PTR [rsp + 0], 2
                mov rax, ${port_bits}
                ror ax, 8
                mov WORD PTR [rsp + 2], ax
                mov rax, ${ipv4_bits}
                bswap eax
                mov DWORD PTR [rsp + 4], eax
                mov QWORD PTR [rsp + 8], 0
                mov rdi, ${socket}
                lea rsi, [rsp + 0]
                mov rdx, 16
                mov eax, 42
                syscall
                mov ${raw}, rax
                add rsp, 16
            }
        }
        raw
    }

    /// Associates a socket with a local IPv4 address and port and returns a native status.
    pub fn bind(socket: u64, ipv4: u32, port: u16) -> i64 {
        let port_bits = port as usize;
        let ipv4_bits = ipv4 as usize;
        let mut raw: i64 = 0;
        @unchecked {
            @asm {
                sub rsp, 16
                mov DWORD PTR [rsp + 0], 2
                mov rax, ${port_bits}
                ror ax, 8
                mov WORD PTR [rsp + 2], ax
                mov rax, ${ipv4_bits}
                bswap eax
                mov DWORD PTR [rsp + 4], eax
                mov QWORD PTR [rsp + 8], 0
                mov rdi, ${socket}
                lea rsi, [rsp + 0]
                mov rdx, 16
                mov eax, 49
                syscall
                mov ${raw}, rax
                add rsp, 16
            }
        }
        raw
    }

    /// Marks a bound stream socket as listening using the supplied backlog.
    pub fn listen(socket: u64, backlog: i32) -> i64 {
        let backlog_bits = backlog as i64;
        let mut raw: i64 = 0;
        @unchecked {
            @asm {
                mov rdi, ${socket}
                mov rsi, ${backlog_bits}
                mov eax, 50
                syscall
                mov ${raw}, rax
            }
        }
        raw
    }

    /// Accepts a native socket and returns its status and handle.
    pub fn accept(socket: u64) -> (i64, u64) {
        let mut accepted: u64 = 0;
        let mut error: i64 = 0;
        @unchecked {
            @asm {
                mov rdi, ${socket}
                mov rsi, 0
                mov rdx, 0
                mov r10, 524288
                mov eax, 288
                syscall
                mov ${accepted}, rax
                test rax, rax
                jns 2f
                mov ${error}, rax
                2:
            }
        }
        (error, accepted)
    }

    /// Closes the Linux socket descriptor.
    pub fn close(socket: u64) {
        @unchecked {
            @asm {
                mov rdi, ${socket}
                mov eax, 3
                syscall
            }
        }
    }

    /// Sets the native socket to nonblocking mode.
    pub fn nonblocking(socket: u64) -> i64 {
        let mut status: i64 = 0;
        @unchecked {
            @asm {
                mov rdi, ${socket}
                mov esi, 4
                mov edx, 2048
                mov eax, 72
                syscall
                mov ${status}, rax
            }
        }
        status
    }

    /// Reads the native error pending after a nonblocking connect.
    pub fn connect_status(socket: u64) -> i64 {
        let mut status: i64 = 0;
        @unchecked {
            @asm {
                sub rsp, 16
                mov DWORD PTR [rsp], 0
                mov DWORD PTR [rsp + 8], 4
                mov rdi, ${socket}
                mov esi, 1
                mov edx, 4
                mov r10, rsp
                lea r8, [rsp + 8]
                mov eax, 55
                syscall
                test rax, rax
                js 1f
                mov eax, DWORD PTR [rsp]
                neg rax
                1:
                mov ${status}, rax
                add rsp, 16
            }
        }
        status
    }

    /// Applies the platform socket options needed by this backend.
    pub fn configure(socket: u64) -> i64 { drop(socket); 0 }

    /// Queries the local or peer IPv4 endpoint and returns its native address representation.
    pub fn endpoint(socket: u64, remote: u64) -> (i64, u64) {
        let mut raw: i64 = 0;
        let mut peer_port: u16 = 0;
        let mut peer_ip: u32 = 0;
        @unchecked {
            @asm {
                sub rsp, 32
                mov QWORD PTR [rsp + 0], 0
                mov DWORD PTR [rsp + 16], 16
                mov rdi, ${socket}
                lea rsi, [rsp + 0]
                lea rdx, [rsp + 16]
                mov eax, 51
                mov r10, ${remote}
                test r10, r10
                je 1f
                mov eax, 52
                1:
                syscall
                mov ${raw}, rax
                movzx eax, WORD PTR [rsp + 2]
                ror ax, 8
                mov ${peer_port}, ax
                mov eax, DWORD PTR [rsp + 4]
                bswap eax
                mov ${peer_ip}, eax
                add rsp, 32
            }
        }
        (raw, ((peer_ip as u64) << 16) | (peer_port as u64))
    }

    /// Extracts packed IPv4 bits and a host-order port from the native endpoint.
    pub fn decode_peer(peer: u64) -> (u32, u16) {
        let mut ip: u32 = 0;
        let mut port: u16 = 0;
        @unchecked {
            @asm {
                mov rax, ${peer}
                mov ${port}, ax
                shr rax, 16
                mov ${ip}, eax
            }
        }
        (ip, port)
    }

    /// Sends bytes to the connected endpoint and returns status and byte count.
    pub fn send(socket: u64, buffer: &[u8], length: usize) -> (i64, usize) {
        let mut raw: i64 = 0;
        let mut count: usize = 0;
        @unchecked {
            let address = addr(&buffer[0]);
            @asm {
                sub rsp, 16
                mov rdi, ${socket}
                mov rsi, ${address}
                mov rdx, ${length}
                mov r10, 16384
                mov r8, 0
                mov r9, 0
                mov eax, 44
                syscall
                mov ${count}, rax
                mov ${raw}, rax
                add rsp, 16
            }
        }
        if raw < 0 { return (raw, 0); }
        return (0, count);
    }

    /// Reads from a connected socket and returns status and byte count.
    pub fn receive(socket: u64, buffer: &mut [u8]) -> (i64, usize) {
        let mut length = buffer.len();
        if length == 0 { return (0, 0); }
        let mut raw: i64 = 0;
        let mut count: usize = 0;
        @unchecked {
            let address = addr(&buffer[0]);
            @asm {
                mov rdi, ${socket}
                mov rsi, ${address}
                mov rdx, ${length}
                mov r10, 0
                mov r8, 0
                mov r9, 0
                mov eax, 45
                syscall
                mov ${count}, rax
                mov ${raw}, rax
            }
        }
        if raw < 0 { return (raw, 0); }
        return (0, count);
    }

    /// Sends bytes to a specified native endpoint and returns status and byte count.
    pub fn send_to(socket: u64, buffer: &[u8], length: usize, ipv4: u32, port: u16) -> (i64, usize) {
        let mut raw: i64 = 0;
        let mut count: usize = 0;
        let port_bits = port as usize;
        let ipv4_bits = ipv4 as usize;
        @unchecked {
            let address = addr(&buffer[0]);
            @asm {
                sub rsp, 16
                mov DWORD PTR [rsp + 0], 2
                mov rax, ${port_bits}
                ror ax, 8
                mov WORD PTR [rsp + 2], ax
                mov rax, ${ipv4_bits}
                bswap eax
                mov DWORD PTR [rsp + 4], eax
                mov QWORD PTR [rsp + 8], 0
                mov rdi, ${socket}
                mov rsi, ${address}
                mov rdx, ${length}
                mov r10, 16384
                lea r8, [rsp + 0]
                mov r9, 16
                mov eax, 44
                syscall
                mov ${count}, rax
                mov ${raw}, rax
                add rsp, 16
            }
        }
        if raw < 0 { return (raw, 0); }
        return (0, count);
    }

    /// Reads one datagram and returns status, byte count and native sender address.
    pub fn receive_from(socket: u64, buffer: &mut [u8]) -> (i64, usize, u64) {
        let mut length = buffer.len();
        let mut raw: i64 = 0;
        let mut count: usize = 0;
        let mut peer_ip: u32 = 0;
        let mut peer_port: u16 = 0;
        @unchecked {
            let address = addr(&buffer[0]);
            @asm {
                sub rsp, 32
                mov rdi, ${socket}
                mov rsi, ${address}
                mov rdx, ${length}
                mov r10, 32
                mov DWORD PTR [rsp + 16], 16
                lea r8, [rsp + 0]
                lea r9, [rsp + 16]
                mov eax, 45
                syscall
                mov ${count}, rax
                mov ${raw}, rax
                movzx eax, WORD PTR [rsp + 2]
                ror ax, 8
                mov ${peer_port}, ax
                mov eax, DWORD PTR [rsp + 4]
                bswap eax
                mov ${peer_ip}, eax
                add rsp, 32
            }
        }
        if raw < 0 { return (raw, 0, 0); }
        if count > length { return (-65536, 0, 0); }
        let peer = ((peer_ip as u64) << 16) | (peer_port as u64);
        return (0, count, peer);
    }
#(endif)
