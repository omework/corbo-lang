//! Darwin ARM64 and x86-64 native socket bindings and IPv4 address layouts.

#(if: target.os == "macos" && target.arch == "aarch64")
    /// Initializes the platform socket subsystem where initialization is required.
    pub fn startup() i64 { 0 }

    /// Releases platform socket subsystem state acquired by startup.
    pub fn cleanup() {}

    /// Creates a Darwin IPv4 socket and returns the native status and descriptor.
    pub fn open(kind: i64) (i64, u64) {
        let mut socket: u64 = 0;
        let mut status: i64 = 0;
        @unchecked {
            @asm {
                mov x0, #2
                mov x1, ${kind}
                mov x2, #0
                bl _socket
                sxtw x0, w0
                mov ${socket}, x0
                tbz x0, #63, 1f
                bl ___error
                ldr w0, [x0]
                neg x0, x0
                1:
                tbz x0, #63, 2f
                mov ${status}, x0
                2:
            }
        }
        (status, socket)
    }

    /// Requests a connection to the IPv4 address and port and returns a native status.
    pub fn connect(socket: u64, ipv4: u32, port: u16) i64 {
        let port_bits = port as usize;
        let ipv4_bits = ipv4 as usize;
        let mut raw: i64 = 0;
        @unchecked {
            @asm {
                sub sp, sp, #16
                mov w9, #528
                str w9, [sp, #0]
                mov x9, ${port_bits}
                rev16 w9, w9
                strh w9, [sp, #2]
                mov x9, ${ipv4_bits}
                rev w9, w9
                str w9, [sp, #4]
                str xzr, [sp, #8]
                mov x0, ${socket}
                add x1, sp, #0
                mov x2, #16
                bl _connect
                sxtw x0, w0
                tbz x0, #63, 1f
                bl ___error
                ldr w0, [x0]
                neg x0, x0
                1:
                mov ${raw}, x0
                add sp, sp, #16
            }
        }
        raw
    }

    /// Associates a socket with a local IPv4 address and port and returns a native status.
    pub fn bind(socket: u64, ipv4: u32, port: u16) i64 {
        let port_bits = port as usize;
        let ipv4_bits = ipv4 as usize;
        let mut raw: i64 = 0;
        @unchecked {
            @asm {
                sub sp, sp, #16
                mov w9, #528
                str w9, [sp, #0]
                mov x9, ${port_bits}
                rev16 w9, w9
                strh w9, [sp, #2]
                mov x9, ${ipv4_bits}
                rev w9, w9
                str w9, [sp, #4]
                str xzr, [sp, #8]
                mov x0, ${socket}
                add x1, sp, #0
                mov x2, #16
                bl _bind
                sxtw x0, w0
                tbz x0, #63, 1f
                bl ___error
                ldr w0, [x0]
                neg x0, x0
                1:
                mov ${raw}, x0
                add sp, sp, #16
            }
        }
        raw
    }

    /// Marks a bound stream socket as listening using the supplied backlog.
    pub fn listen(socket: u64, backlog: i32) i64 {
        let backlog_bits = backlog as i64;
        let mut raw: i64 = 0;
        @unchecked {
            @asm {
                mov x0, ${socket}
                mov x1, ${backlog_bits}
                bl _listen
                sxtw x0, w0
                tbz x0, #63, 1f
                bl ___error
                ldr w0, [x0]
                neg x0, x0
                1:
                mov ${raw}, x0
            }
        }
        raw
    }

    /// Accepts a native socket and returns its status and handle.
    pub fn accept(socket: u64) (i64, u64) {
        let mut accepted: u64 = 0;
        let mut error: i64 = 0;
        @unchecked {
            @asm {
                mov x0, ${socket}
                mov x1, #0
                mov x2, #0
                bl _accept
                sxtw x0, w0
                mov ${accepted}, x0
                tbz x0, #63, 1f
                bl ___error
                ldr w0, [x0]
                neg x0, x0
                1:
                tbz x0, #63, 2f
                mov ${error}, x0
                2:
            }
        }
        (error, accepted)
    }

    /// Closes the Darwin socket descriptor.
    pub fn close(socket: u64) {
        @unchecked {
            @asm {
                mov x0, ${socket}
                bl _close
            }
        }
    }

    /// Sets the native socket to nonblocking mode.
    pub fn nonblocking(socket: u64) i64 {
        let mut status: i64 = 0;
        @unchecked {
            @asm {
                sub sp, sp, #16
                mov x9, #4
                str x9, [sp]
                mov x0, ${socket}
                mov x1, #4
                bl _fcntl
                cbz w0, 1f
                bl ___error
                ldr w0, [x0]
                neg x0, x0
                1:
                mov ${status}, x0
                add sp, sp, #16
            }
        }
        status
    }

    /// Reads the native error pending after a nonblocking connect.
    pub fn connect_status(socket: u64) i64 {
        let mut status: i64 = 0;
        @unchecked {
            @asm {
                sub sp, sp, #16
                str wzr, [sp]
                mov w9, #4
                str w9, [sp, #8]
                mov x0, ${socket}
                mov w1, #65535
                mov w2, #4103
                mov x3, sp
                add x4, sp, #8
                bl _getsockopt
                cbz w0, 1f
                bl ___error
                ldr w0, [x0]
                b 2f
                1:
                ldr w0, [sp]
                2:
                neg x0, x0
                mov ${status}, x0
                add sp, sp, #16
            }
        }
        status
    }

    /// Applies the platform socket options needed by this backend.
    pub fn configure(socket: u64) i64 {
        let mut raw: i64 = 0;
        @unchecked {
            @asm {
                sub sp, sp, #16
                mov w9, #1
                str w9, [sp, #0]
                mov x0, ${socket}
                mov x1, #65535
                mov x2, #4130
                add x3, sp, #0
                mov x4, #4
                bl _setsockopt
                sxtw x0, w0
                tbz x0, #63, 1f
                bl ___error
                ldr w0, [x0]
                neg x0, x0
                1:
                mov ${raw}, x0
                add sp, sp, #16
            }
        }
        raw
    }

    /// Queries the local or peer IPv4 endpoint and returns its native address representation.
    pub fn endpoint(socket: u64, remote: u64) (i64, u64) {
        let mut raw: i64 = 0;
        let mut peer_port: u16 = 0;
        let mut peer_ip: u32 = 0;
        @unchecked {
            @asm {
                sub sp, sp, #32
                str xzr, [sp, #0]
                mov w9, #16
                str w9, [sp, #16]
                mov x0, ${socket}
                add x1, sp, #0
                add x2, sp, #16
                mov x9, ${remote}
                cbz x9, 3f
                bl _getpeername
                b 4f
                3:
                bl _getsockname
                4:
                sxtw x0, w0
                tbz x0, #63, 1f
                bl ___error
                ldr w0, [x0]
                neg x0, x0
                1:
                mov ${raw}, x0
                ldrh w9, [sp, #2]
                rev16 w9, w9
                mov ${peer_port}, w9
                ldr w9, [sp, #4]
                rev w9, w9
                mov ${peer_ip}, w9
                add sp, sp, #32
            }
        }
        (raw, ((peer_ip as u64) << 16) | (peer_port as u64))
    }

    /// Extracts packed IPv4 bits and a host-order port from the native endpoint.
    pub fn decode_peer(peer: u64) (u32, u16) {
        let mut ip: u32 = 0;
        let mut port: u16 = 0;
        @unchecked {
            @asm {
                mov x9, ${peer}
                mov ${port}, w9
                lsr x9, x9, #16
                mov ${ip}, w9
            }
        }
        (ip, port)
    }

    /// Sends bytes to the connected endpoint and returns status and byte count.
    pub fn send(socket: u64, buffer: &[u8], length: usize) (i64, usize) {
        let mut raw: i64 = 0;
        let mut count: usize = 0;
        @unchecked {
            let address = addr(&buffer[0]);
            @asm {
                sub sp, sp, #16
                mov x0, ${socket}
                mov x1, ${address}
                mov x2, ${length}
                mov x3, #0
                bl _send
                mov ${count}, x0
                tbz x0, #63, 1f
                bl ___error
                ldr w0, [x0]
                neg x0, x0
                1:
                mov ${raw}, x0
                add sp, sp, #16
            }
        }
        if raw < 0 { return (raw, 0); }
        return (0, count);
    }

    /// Reads from a connected socket and returns status and byte count.
    pub fn receive(socket: u64, buffer: &mut [u8]) (i64, usize) {
        let mut length = buffer.len();
        if length == 0 { return (0, 0); }
        let mut raw: i64 = 0;
        let mut count: usize = 0;
        @unchecked {
            let address = addr(&buffer[0]);
            @asm {
                mov x0, ${socket}
                mov x1, ${address}
                mov x2, ${length}
                mov x3, #0
                bl _recv
                mov ${count}, x0
                tbz x0, #63, 1f
                bl ___error
                ldr w0, [x0]
                neg x0, x0
                1:
                mov ${raw}, x0
            }
        }
        if raw < 0 { return (raw, 0); }
        return (0, count);
    }

    /// Sends bytes to a specified native endpoint and returns status and byte count.
    pub fn send_to(socket: u64, buffer: &[u8], length: usize, ipv4: u32, port: u16) (i64, usize) {
        let mut raw: i64 = 0;
        let mut count: usize = 0;
        let port_bits = port as usize;
        let ipv4_bits = ipv4 as usize;
        @unchecked {
            let address = addr(&buffer[0]);
            @asm {
                sub sp, sp, #16
                mov w9, #528
                str w9, [sp, #0]
                mov x9, ${port_bits}
                rev16 w9, w9
                strh w9, [sp, #2]
                mov x9, ${ipv4_bits}
                rev w9, w9
                str w9, [sp, #4]
                str xzr, [sp, #8]
                mov x0, ${socket}
                mov x1, ${address}
                mov x2, ${length}
                mov x3, #0
                add x4, sp, #0
                mov x5, #16
                bl _sendto
                mov ${count}, x0
                tbz x0, #63, 1f
                bl ___error
                ldr w0, [x0]
                neg x0, x0
                1:
                mov ${raw}, x0
                add sp, sp, #16
            }
        }
        if raw < 0 { return (raw, 0); }
        return (0, count);
    }

    /// Reads one datagram and returns status, byte count and native sender address.
    pub fn receive_from(socket: u64, buffer: &mut [u8]) (i64, usize, u64) {
        let mut length = buffer.len();
        let mut raw: i64 = 0;
        let mut count: usize = 0;
        let mut peer_ip: u32 = 0;
        let mut peer_port: u16 = 0;
        @unchecked {
            let address = addr(&buffer[0]);
            @asm {
                sub sp, sp, #80
                str xzr, [sp, #0]
                str xzr, [sp, #8]
                str xzr, [sp, #16]
                str xzr, [sp, #24]
                str xzr, [sp, #32]
                str xzr, [sp, #40]
                add x9, sp, #64
                str x9, [sp, #0]
                mov w9, #16
                str w9, [sp, #8]
                add x9, sp, #48
                str x9, [sp, #16]
                mov w9, #1
                str w9, [sp, #24]
                mov x9, ${address}
                str x9, [sp, #48]
                mov x9, ${length}
                str x9, [sp, #56]
                mov x0, ${socket}
                add x1, sp, #0
                mov x2, #0
                bl _recvmsg
                mov ${count}, x0
                tbz x0, #63, 1f
                bl ___error
                ldr w0, [x0]
                neg x0, x0
                1:
                tbnz x0, #63, 2f
                ldr w9, [sp, #44]
                tbz w9, #4, 2f
                mov x0, #-65536
                2:
                mov ${raw}, x0
                ldrh w9, [sp, #66]
                rev16 w9, w9
                mov ${peer_port}, w9
                ldr w9, [sp, #68]
                rev w9, w9
                mov ${peer_ip}, w9
                add sp, sp, #80
            }
        }
        if raw < 0 { return (raw, 0, 0); }
        let peer = ((peer_ip as u64) << 16) | (peer_port as u64);
        return (0, count, peer);
    }
#(endif)

#(if: target.os == "macos" && target.arch == "x86_64")
    /// Initializes the platform socket subsystem where initialization is required.
    pub fn startup() i64 { 0 }

    /// Releases platform socket subsystem state acquired by startup.
    pub fn cleanup() {}

    /// Creates a Darwin IPv4 socket and returns the native status and descriptor.
    pub fn open(kind: i64) (i64, u64) {
        let mut socket: u64 = 0;
        let mut status: i64 = 0;
        @unchecked {
            @asm {
                mov rdi, 2
                mov rsi, ${kind}
                mov rdx, 0
                call _socket
                cdqe
                mov ${socket}, rax
                test rax, rax
                jns 1f
                call ___error
                mov eax, DWORD PTR [rax]
                neg rax
                1:
                test rax, rax
                jns 2f
                mov ${status}, rax
                2:
            }
        }
        (status, socket)
    }

    /// Requests a connection to the IPv4 address and port and returns a native status.
    pub fn connect(socket: u64, ipv4: u32, port: u16) i64 {
        let port_bits = port as usize;
        let ipv4_bits = ipv4 as usize;
        let mut raw: i64 = 0;
        @unchecked {
            @asm {
                sub rsp, 16
                mov DWORD PTR [rsp + 0], 528
                mov rax, ${port_bits}
                ror ax, 8
                mov WORD PTR [rsp + 2], ax
                mov rax, ${ipv4_bits}
                bswap eax
                mov DWORD PTR [rsp + 4], eax
                mov QWORD PTR [rsp + 8], 0
                mov rdi, ${socket}
                lea rsi, [rsp + 0]
                mov rdx, 16
                call _connect
                cdqe
                test rax, rax
                jns 1f
                call ___error
                mov eax, DWORD PTR [rax]
                neg rax
                1:
                mov ${raw}, rax
                add rsp, 16
            }
        }
        raw
    }

    /// Associates a socket with a local IPv4 address and port and returns a native status.
    pub fn bind(socket: u64, ipv4: u32, port: u16) i64 {
        let port_bits = port as usize;
        let ipv4_bits = ipv4 as usize;
        let mut raw: i64 = 0;
        @unchecked {
            @asm {
                sub rsp, 16
                mov DWORD PTR [rsp + 0], 528
                mov rax, ${port_bits}
                ror ax, 8
                mov WORD PTR [rsp + 2], ax
                mov rax, ${ipv4_bits}
                bswap eax
                mov DWORD PTR [rsp + 4], eax
                mov QWORD PTR [rsp + 8], 0
                mov rdi, ${socket}
                lea rsi, [rsp + 0]
                mov rdx, 16
                call _bind
                cdqe
                test rax, rax
                jns 1f
                call ___error
                mov eax, DWORD PTR [rax]
                neg rax
                1:
                mov ${raw}, rax
                add rsp, 16
            }
        }
        raw
    }

    /// Marks a bound stream socket as listening using the supplied backlog.
    pub fn listen(socket: u64, backlog: i32) i64 {
        let backlog_bits = backlog as i64;
        let mut raw: i64 = 0;
        @unchecked {
            @asm {
                mov rdi, ${socket}
                mov rsi, ${backlog_bits}
                call _listen
                cdqe
                test rax, rax
                jns 1f
                call ___error
                mov eax, DWORD PTR [rax]
                neg rax
                1:
                mov ${raw}, rax
            }
        }
        raw
    }

    /// Accepts a native socket and returns its status and handle.
    pub fn accept(socket: u64) (i64, u64) {
        let mut accepted: u64 = 0;
        let mut error: i64 = 0;
        @unchecked {
            @asm {
                mov rdi, ${socket}
                mov rsi, 0
                mov rdx, 0
                call _accept
                cdqe
                mov ${accepted}, rax
                test rax, rax
                jns 1f
                call ___error
                mov eax, DWORD PTR [rax]
                neg rax
                1:
                test rax, rax
                jns 2f
                mov ${error}, rax
                2:
            }
        }
        (error, accepted)
    }

    /// Closes the Darwin socket descriptor.
    pub fn close(socket: u64) {
        @unchecked {
            @asm {
                mov rdi, ${socket}
                call _close
            }
        }
    }

    /// Sets the native socket to nonblocking mode.
    pub fn nonblocking(socket: u64) i64 {
        let mut status: i64 = 0;
        @unchecked {
            @asm {
                mov rdi, ${socket}
                mov esi, 4
                mov edx, 4
                xor eax, eax
                call _fcntl
                test eax, eax
                jz 1f
                call ___error
                mov eax, DWORD PTR [rax]
                neg rax
                1:
                mov ${status}, rax
            }
        }
        status
    }

    /// Reads the native error pending after a nonblocking connect.
    pub fn connect_status(socket: u64) i64 {
        let mut status: i64 = 0;
        @unchecked {
            @asm {
                sub rsp, 16
                mov DWORD PTR [rsp], 0
                mov DWORD PTR [rsp + 8], 4
                mov rdi, ${socket}
                mov esi, 65535
                mov edx, 4103
                mov rcx, rsp
                lea r8, [rsp + 8]
                call _getsockopt
                test eax, eax
                jz 1f
                call ___error
                mov eax, DWORD PTR [rax]
                jmp 2f
                1:
                mov eax, DWORD PTR [rsp]
                2:
                neg rax
                mov ${status}, rax
                add rsp, 16
            }
        }
        status
    }

    /// Applies the platform socket options needed by this backend.
    pub fn configure(socket: u64) i64 {
        let mut raw: i64 = 0;
        @unchecked {
            @asm {
                sub rsp, 16
                mov eax, 1
                mov DWORD PTR [rsp + 0], eax
                mov rdi, ${socket}
                mov rsi, 65535
                mov rdx, 4130
                lea rcx, [rsp + 0]
                mov r8, 4
                call _setsockopt
                cdqe
                test rax, rax
                jns 1f
                call ___error
                mov eax, DWORD PTR [rax]
                neg rax
                1:
                mov ${raw}, rax
                add rsp, 16
            }
        }
        raw
    }

    /// Queries the local or peer IPv4 endpoint and returns its native address representation.
    pub fn endpoint(socket: u64, remote: u64) (i64, u64) {
        let mut raw: i64 = 0;
        let mut peer_port: u16 = 0;
        let mut peer_ip: u32 = 0;
        @unchecked {
            @asm {
                sub rsp, 32
                mov QWORD PTR [rsp + 0], 0
                mov DWORD PTR [rsp + 16], 16
                mov rdi, ${socket}
                lea rsi, [rsp + 0]
                lea rdx, [rsp + 16]
                mov r10, ${remote}
                test r10, r10
                je 3f
                call _getpeername
                jmp 4f
                3:
                call _getsockname
                4:
                cdqe
                test rax, rax
                jns 1f
                call ___error
                mov eax, DWORD PTR [rax]
                neg rax
                1:
                mov ${raw}, rax
                movzx eax, WORD PTR [rsp + 2]
                ror ax, 8
                mov ${peer_port}, ax
                mov eax, DWORD PTR [rsp + 4]
                bswap eax
                mov ${peer_ip}, eax
                add rsp, 32
            }
        }
        (raw, ((peer_ip as u64) << 16) | (peer_port as u64))
    }

    /// Extracts packed IPv4 bits and a host-order port from the native endpoint.
    pub fn decode_peer(peer: u64) (u32, u16) {
        let mut ip: u32 = 0;
        let mut port: u16 = 0;
        @unchecked {
            @asm {
                mov rax, ${peer}
                mov ${port}, ax
                shr rax, 16
                mov ${ip}, eax
            }
        }
        (ip, port)
    }

    /// Sends bytes to the connected endpoint and returns status and byte count.
    pub fn send(socket: u64, buffer: &[u8], length: usize) (i64, usize) {
        let mut raw: i64 = 0;
        let mut count: usize = 0;
        @unchecked {
            let address = addr(&buffer[0]);
            @asm {
                sub rsp, 16
                mov rdi, ${socket}
                mov rsi, ${address}
                mov rdx, ${length}
                mov rcx, 0
                call _send
                mov ${count}, rax
                test rax, rax
                jns 1f
                call ___error
                mov eax, DWORD PTR [rax]
                neg rax
                1:
                mov ${raw}, rax
                add rsp, 16
            }
        }
        if raw < 0 { return (raw, 0); }
        return (0, count);
    }

    /// Reads from a connected socket and returns status and byte count.
    pub fn receive(socket: u64, buffer: &mut [u8]) (i64, usize) {
        let mut length = buffer.len();
