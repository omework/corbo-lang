                mov DWORD PTR [rsp + 0], 528
                mov rax, ${port_bits}
                ror ax, 8
                mov WORD PTR [rsp + 2], ax
                mov rax, ${ipv4_bits}
                bswap eax
                mov DWORD PTR [rsp + 4], eax
                mov QWORD PTR [rsp + 8], 0
                mov rdi, ${socket}
                mov rsi, ${address}
                mov rdx, ${length}
                mov rcx, 0
                lea r8, [rsp + 0]
                mov r9, 16
                call _sendto
                mov ${count}, rax
                test rax, rax
                jns 1f
                call ___error
                mov eax, DWORD PTR [rax]
                neg rax
                1:
                mov ${raw}, rax
                add rsp, 16
            }
        }
        if raw < 0 { return (raw, 0); }
        return (0, count);
    }

    /// Reads one datagram and returns status, byte count and native sender address.
    pub fn receive_from(socket: u64, buffer: &mut [u8]) (i64, usize, u64) {
        let mut length = buffer.len();
        let mut raw: i64 = 0;
        let mut count: usize = 0;
        let mut peer_ip: u32 = 0;
        let mut peer_port: u16 = 0;
        @unchecked {
            let address = addr(&buffer[0]);
            @asm {
                sub rsp, 80
                mov QWORD PTR [rsp + 0], 0
                mov QWORD PTR [rsp + 8], 0
                mov QWORD PTR [rsp + 16], 0
                mov QWORD PTR [rsp + 24], 0
                mov QWORD PTR [rsp + 32], 0
                mov QWORD PTR [rsp + 40], 0
                lea rax, [rsp + 64]
                mov QWORD PTR [rsp + 0], rax
                mov DWORD PTR [rsp + 8], 16
                lea rax, [rsp + 48]
                mov QWORD PTR [rsp + 16], rax
                mov DWORD PTR [rsp + 24], 1
                mov rax, ${address}
                mov QWORD PTR [rsp + 48], rax
                mov rax, ${length}
                mov QWORD PTR [rsp + 56], rax
                mov rdi, ${socket}
                lea rsi, [rsp + 0]
                mov rdx, 0
                call _recvmsg
                mov ${count}, rax
                test rax, rax
                jns 1f
                call ___error
                mov eax, DWORD PTR [rax]
                neg rax
                1:
                test rax, rax
                js 2f
                test DWORD PTR [rsp + 44], 16
                jz 2f
                mov rax, -65536
                2:
                mov ${raw}, rax
                movzx eax, WORD PTR [rsp + 66]
                ror ax, 8
                mov ${peer_port}, ax
                mov eax, DWORD PTR [rsp + 68]
                bswap eax
                mov ${peer_ip}, eax
                add rsp, 80
            }
        }
        if raw < 0 { return (raw, 0, 0); }
        let peer = ((peer_ip as u64) << 16) | (peer_port as u64);
        return (0, count, peer);
    }
#(endif)
