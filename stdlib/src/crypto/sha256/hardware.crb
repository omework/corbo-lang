//! Hardware feature detection and assembly compression for SHA-256.

#(if: target.os == "macos" && target.arch == "aarch64")
    /// Reports whether the SHA-256 hardware path is available on the selected target.
    fn hardware_available() bool {
        // hw.optional.arm.FEAT_SHA256
        let feature: [u8; 28] = [104,119,46,111,112,116,105,111,110,97,108,46,97,114,
                                 109,46,70,69,65,84,95,83,72,65,50,53,54,0];
        let mut supported: u64 = 0;
        @unchecked {
            let name = addr(&feature[0]);
            @asm {
                sub sp, sp, #16
                str xzr, [sp]
                mov x9, #4
                str x9, [sp, #8]
                mov x0, ${name}
                mov x1, sp
                add x2, sp, #8
                mov x3, #0
                mov x4, #0
                bl _sysctlbyname
                cbnz w0, 1f
                ldr w9, [sp]
                mov ${supported}, x9
                1:
                add sp, sp, #16
            }
        }
        supported != 0
    }

    /// Compresses a SHA-256 block using the instruction backend selected by the target.
    fn hardware_rounds(state: &mut [u64; 8], words: &[u64; 64]) {
        @unchecked {
            let output = addr(&mut (*state)[0]);
            let schedule = addr(&(*words)[0]);
            @asm {
                mov x8, ${output}
                mov x9, ${schedule}
                ldp q0, q4, [x8]
                xtn v0.2s, v0.2d
                xtn2 v0.4s, v4.2d
                ldp q1, q4, [x8, #32]
                xtn v1.2s, v1.2d
                xtn2 v1.4s, v4.2d
                mov v2.16b, v0.16b
                mov v3.16b, v1.16b
                mov w10, #16
                1:
                ldp q4, q5, [x9], #32
                xtn v4.2s, v4.2d
                xtn2 v4.4s, v5.2d
                mov v5.16b, v0.16b
                sha256h q0, q1, v4.4s
                sha256h2 q1, q5, v4.4s
                subs w10, w10, #1
                b.ne 1b
                add v0.4s, v0.4s, v2.4s
                add v1.4s, v1.4s, v3.4s
                uxtl v4.2d, v0.2s
                uxtl2 v5.2d, v0.4s
                stp q4, q5, [x8]
                uxtl v4.2d, v1.2s
                uxtl2 v5.2d, v1.4s
                stp q4, q5, [x8, #32]
            }
        }
    }
#(endif)

#(if: target.arch == "x86_64" && target.pointer_width == "64" && target.os == "linux" || target.arch == "x86_64" && target.os == "macos" || target.arch == "x86_64" && target.os == "windows")
    /// Reports whether the SHA-256 hardware path is available on the selected target.
    fn hardware_available() bool {
        let mut supported: u64 = 0;
        @unchecked {
            @asm {
                push rbx
                xor eax, eax
                cpuid
                cmp eax, 7
                jb 1f
                mov eax, 1
                cpuid
                and ecx, 0x80200
                cmp ecx, 0x80200
                jne 1f
                mov eax, 7
                xor ecx, ecx
                cpuid
                shr ebx, 29
                and ebx, 1
                mov ${supported}, rbx
                1:
                pop rbx
            }
        }
        supported != 0
    }

    /// Compresses a SHA-256 block using the instruction backend selected by the target.
    fn hardware_rounds(state: &mut [u64; 8], words: &[u64; 64]) {
        @unchecked {
            let output = addr(&mut (*state)[0]);
            let schedule = addr(&(*words)[0]);
            @asm {
                mov r8, ${output}
                mov r9, ${schedule}
                movdqu xmm1, [r8]
                movdqu xmm3, [r8 + 16]
                shufps xmm1, xmm3, 0x88
                movdqu xmm2, [r8 + 32]
                movdqu xmm3, [r8 + 48]
                shufps xmm2, xmm3, 0x88
                // Convert ABCD and EFGH to the two SHA-NI state vectors.
                pshufd xmm3, xmm1, 0xb1
                pshufd xmm2, xmm2, 0x1b
                movdqa xmm1, xmm3
                palignr xmm1, xmm2, 8
                pblendw xmm2, xmm3, 0xf0
                movdqa xmm4, xmm1
                movdqa xmm5, xmm2
                mov ecx, 16
                1:
                movdqu xmm0, [r9]
                movdqu xmm3, [r9 + 16]
                shufps xmm0, xmm3, 0x88
                sha256rnds2 xmm2, xmm1, xmm0
                pshufd xmm0, xmm0, 0x0e
                sha256rnds2 xmm1, xmm2, xmm0
                add r9, 32
                dec ecx
                jnz 1b
                paddd xmm1, xmm4
                paddd xmm2, xmm5
                pshufd xmm3, xmm1, 0x1b
                pshufd xmm2, xmm2, 0xb1
                movdqa xmm1, xmm3
                pblendw xmm1, xmm2, 0xf0
                palignr xmm2, xmm3, 8
                pxor xmm0, xmm0
                movdqa xmm3, xmm1
                punpckldq xmm1, xmm0
                punpckhdq xmm3, xmm0
                movdqu [r8], xmm1
                movdqu [r8 + 16], xmm3
                movdqa xmm3, xmm2
                punpckldq xmm2, xmm0
                punpckhdq xmm3, xmm0
                movdqu [r8 + 32], xmm2
                movdqu [r8 + 48], xmm3
            }
        }
    }
#(endif)

#(if: target.arch == "aarch64" && target.os == "linux" || target.arch == "aarch64" && target.os == "windows" || target.pointer_width == "32")
    /// Reports whether the SHA-256 hardware path is available on the selected target.
    fn hardware_available() bool { false }

    /// Compresses a SHA-256 block using the instruction backend selected by the target.
    fn hardware_rounds(state: &mut [u64; 8], words: &[u64; 64]) {
        portable_rounds(&mut *state, &*words);
    }
#(endif)
