//! Portable SHA-256 message scheduling and compression rounds.

/// Mask for reducing intermediate values to a SHA-256 word.
const WORD_MASK: u64 = 0xffffffff;

/// Rotates a 32-bit SHA-256 word right by the requested count.
fn rotate(word: u64, count: u64) u64 {
    (copy(word) >> copy(count)) | ((word << (32 - count)) & WORD_MASK)
}

/// Expands a 64-byte input block to the 64 SHA-256 schedule words.
fn schedule(input: &[u8; 64]) [u64; 64] {
    let constants: [u64; 64] = [
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
    ];
    let mut words: [u64; 64] = [0; 64];
    let mut index: u64 = 0;
    while index < 16 {
        let offset = index * 4;
        words[index] = (((*input)[offset] as u64) << 24)
                     | (((*input)[offset + 1] as u64) << 16)
                     | (((*input)[offset + 2] as u64) << 8)
                     | ((*input)[offset + 3] as u64);
        index = index + 1;
    }
    while index < 64 {
        let x = words[index - 15];
        let y = words[index - 2];
        let s0 = rotate(copy(x), 7) ^ rotate(copy(x), 18) ^ (x >> 3);
        let s1 = rotate(copy(y), 17) ^ rotate(copy(y), 19) ^ (y >> 10);
        let word = words[index - 16] + s0 + words[index - 7] + s1;
        words[index] = word & WORD_MASK;
        index = index + 1;
    }
    index = 0;
    while index < 64 {
        let word = words[index];
        words[index] = (word + constants[index]) & WORD_MASK;
        index = index + 1;
    }
    words
}

/// Updates the SHA-256 chaining words with the scheduled compression rounds.
fn compress_rounds(state: &mut [u64; 8], words: &[u64; 64], accelerated: bool) {
    if accelerated {
        hardware_rounds(&mut *state, &*words);
    } else {
        portable_rounds(&mut *state, &*words);
    }
}

/// Processes one block with the portable SHA-256 schedule and rounds.
fn portable_rounds(state: &mut [u64; 8], words: &[u64; 64]) {
    let mut a = (*state)[0];
    let mut b = (*state)[1];
    let mut c = (*state)[2];
    let mut d = (*state)[3];
    let mut e = (*state)[4];
    let mut f = (*state)[5];
    let mut g = (*state)[6];
    let mut h = (*state)[7];
    let mut index: u64 = 0;
    while index < 64 {
        let sum1 = rotate(copy(e), 6) ^ rotate(copy(e), 11) ^ rotate(copy(e), 25);
        let choose = (e & f) ^ ((e ^ WORD_MASK) & g);
        let t1 = h + sum1 + choose + (*words)[index];
        let sum0 = rotate(copy(a), 2) ^ rotate(copy(a), 13) ^ rotate(copy(a), 22);
        let majority = (a & b) ^ (a & c) ^ (b & c);
        h = g;
        g = f;
        f = e;
        e = (d + t1) & WORD_MASK;
        d = c;
        c = b;
        b = a;
        a = (t1 + sum0 + majority) & WORD_MASK;
        index = index + 1;
    }
    let output = &mut (*state)[0];
    *output = (*output + a) & WORD_MASK;
    let output = &mut (*state)[1];
    *output = (*output + b) & WORD_MASK;
    let output = &mut (*state)[2];
    *output = (*output + c) & WORD_MASK;
    let output = &mut (*state)[3];
    *output = (*output + d) & WORD_MASK;
    let output = &mut (*state)[4];
    *output = (*output + e) & WORD_MASK;
    let output = &mut (*state)[5];
    *output = (*output + f) & WORD_MASK;
    let output = &mut (*state)[6];
    *output = (*output + g) & WORD_MASK;
    let output = &mut (*state)[7];
    *output = (*output + h) & WORD_MASK;
}
