//! Streaming and one-shot SHA-256 hashing.

/// Largest byte count encodable as the SHA-256 message bit length.
const SHA256_MAX_INPUT_BYTES: u64 = 0x1fffffffffffffff;

/// Reports that the input length exceeds the SHA-256 limit.
pub enum HashError {
    /// Input length exceeds the algorithm's supported counter or encoding limit.
    InputTooLong;
}

/// Holds SHA-256 chaining state, byte count and pending block.
pub struct Sha256 {
    /// Internal chaining or sponge state retained between updates.
    state: [u64; 8];
    /// Pending input block; update compresses full blocks before reusing this storage.
    block: [u8; 64];
    /// Total input bytes incorporated by this hash instance.
    bytes: u64;
    /// Whether this instance uses the available hardware compression/encryption path.
    accelerated: bool;

    /// Creates a fresh SHA-256 hasher that uses portable compression.
    pub fn portable() Sha256 {
        Sha256 {
            state: [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
                    0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19],
            block: [0; 64],
            bytes: 0,
            accelerated: false,
        }
    }

    /// Creates a fresh SHA-256 hasher and selects an available compression backend.
    pub fn new() Sha256 {
        let mut hash = Sha256::portable();
        let enabled = &mut hash.accelerated;
        *enabled = hardware_available();
        hash
    }

    /// Reports whether this hasher uses the hardware compression path.
    pub fn hardware_accelerated(&self) bool { (*self).accelerated }

    /// Computes the digest of the bytes seen so far while keeping the hasher available.
    pub fn snapshot(&self) [u8; 32] {
        let mut hash = Sha256::portable();
        let count = &mut hash.bytes;
        *count = (*self).bytes;
        let accelerated = &mut hash.accelerated;
        *accelerated = (*self).accelerated;
        let mut index: usize = 0;
        while index < 8 {
            let word = &mut hash.state[index];
            *word = (*self).state[index];
            index = index + 1;
        }
        index = 0;
        while index < 64 {
            let byte = &mut hash.block[index];
            *byte = (*self).block[index];
            index = index + 1;
        }
        hash.finish()
    }

    /// Feeds a byte slice into the hash, compressing full blocks and retaining the remainder.
    pub fn update(&mut self, input: &[u8]) Result<(), HashError> {
        let length = input.len() as u64;
        let bytes = (*self).bytes;
        if length > SHA256_MAX_INPUT_BYTES - bytes { return Err(HashError::InputTooLong); }

        let mut offset = bytes % 64;
        let mut index: u64 = 0;
        while index < length {
            let byte = &mut (*self).block[offset];
            *byte = input[index];
            offset = offset + 1;
            if offset == 64 {
                compress_block(&mut *self);
                offset = 0;
            }
            index = index + 1;
        }
        let total = &mut (*self).bytes;
        *total = bytes + length;
        Ok(())
    }

    /// Consumes the hasher and returns its 32-byte digest after padding the message.
    pub fn finish(mut self: Sha256) [u8; 32] {
        let bits = self.bytes * 8;
        let used = self.bytes % 64;
        let separator = &mut self.block[used];
        *separator = 128;
        let mut position = used + 1;
        if position > 56 {
            while position < 64 {
                let byte = &mut self.block[position];
                *byte = 0;
                position = position + 1;
            }
            compress_block(&mut self);
            position = 0;
        }
        while position < 56 {
            let byte = &mut self.block[position];
            *byte = 0;
            position = position + 1;
        }
        while position < 64 {
            let byte = &mut self.block[position];
            *byte = byte_at(copy(bits), (63 - position) * 8);
            position = position + 1;
        }
        compress_block(&mut self);

        let mut digest: [u8; 32] = [0; 32];
        let mut index: u64 = 0;
        while index < 32 {
            digest[index] = byte_at(self.state[index / 4], (3 - index % 4) * 8);
            index = index + 1;
        }
        digest
    }
}


/// Compresses one complete block using the hasher's selected backend.
fn compress_block(hash: &mut Sha256) {
    let words = schedule(&(*hash).block);
    let accelerated = (*hash).accelerated;
    compress_rounds(&mut (*hash).state, &words, accelerated);
}

/// Computes a SHA-256 digest in one call.
pub fn digest(input: &[u8]) Result<[u8; 32], HashError> {
    let mut hash = Sha256::new();
    match hash.update(input) {
        Ok(()) => { Ok(hash.finish()) },
        Err(error) => { Err(error) },
    }
}

// The core's exact casts cannot narrow an integer. Assemble the eight
// bits directly without an unchecked conversion or a lookup table.
/// Extracts one byte at the given offset within a serialized SHA-256 word.
fn byte_at(word: u64, shift: u64) u8 {
    let mut value = word >> shift;
    let mut byte: u8 = 0;
    let mut bit: u64 = 0;
    while bit < 8 {
        let low: u8 = if (value & 1) == 0 { 0 } else { 1 };
        byte = byte | (low << bit);
        value = value >> 1;
        bit = bit + 1;
    }
    byte
}
