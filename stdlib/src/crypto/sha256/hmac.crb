//! HMAC authentication using SHA-256.

// RFC 2104. Keep the message fragments separate so callers need no
// concatenation buffer, including when the context string is large.
/// Computes HMAC over the concatenation of its input fragments.
pub fn hmac_parts(key: &[u8], prefix: &[u8], message: &[u8], suffix: &[u8]) Result<[u8; 32], HashError> {
    let length = key.len();
    let mut pad: [u8; 64] = [0; 64];
    let mut i: usize = 0;
    if length > 64 {
        match digest(&key[0..length]) {
            Err(error) => { return Err(error); },
            Ok(hashed) => {
                while i < 32 {
                    pad[i] = hashed[i];
                    i = i + 1;
                }
            },
        };
    } else {
        while i < length {
            pad[i] = key[i];
            i = i + 1;
        }
    }

    i = 0;
    while i < 64 {
        pad[i] = pad[i] ^ 0x36;
        i = i + 1;
    }
    let mut inner = Sha256::new();
    match inner.update(&pad[..]) {
        Err(error) => { return Err(error); },
        Ok(()) => {},
    };
    match inner.update(prefix) {
        Err(error) => { return Err(error); },
        Ok(()) => {},
    };
    match inner.update(message) {
        Err(error) => { return Err(error); },
        Ok(()) => {},
    };
    match inner.update(suffix) {
        Err(error) => { return Err(error); },
        Ok(()) => {},
    };
    let tag = inner.finish();

    // 0x36 XOR 0x5c turns the inner pad into the outer pad.
    i = 0;
    while i < 64 {
        pad[i] = pad[i] ^ 0x6a;
        i = i + 1;
    }
    let mut outer = Sha256::new();
    match outer.update(&pad[..]) {
        Err(error) => { return Err(error); },
        Ok(()) => {},
    };
    match outer.update(&tag[..]) {
        Err(error) => { Err(error) },
        Ok(()) => { Ok(outer.finish()) },
    }
}

/// Computes the HMAC authentication tag of a message with the supplied key.
pub fn hmac(key: &[u8], message: &[u8]) Result<[u8; 32], HashError> {
    let prefix: [u8; 0] = [];
    let suffix: [u8; 0] = [];
    hmac_parts(key, &prefix[..], message, &suffix[..])
}
