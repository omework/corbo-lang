//! Shared SHA-384 and SHA-512 message schedule and compression rounds.

/// Mask for the low 32 bits of a 64-bit compression word.
const LOW_32_BITS: u64 = 0xffffffff;
/// Largest 64-bit value used when computing modular addition.
const U64_MAX: u64 = 0xffffffffffffffff;

// The SHA-512 family adds words modulo 2^64. Each intermediate sum
// occupies at most 33 bits and therefore fits Corbo's checked arithmetic.
/// Adds two compression words modulo 2^64.
fn add_word(left: u64, right: u64) u64 {
    let low = (left & LOW_32_BITS) + (right & LOW_32_BITS);
    let high = (left >> 32) + (right >> 32) + (low >> 32);
    ((high & LOW_32_BITS) << 32) | (low & LOW_32_BITS)
}

/// Rotates a 64-bit compression word to the right.
fn rotate_right(word: u64, count: u64) u64 {
    let shift: u64 = 64 - copy(count);
    (word >> count) | ((word & (U64_MAX >> copy(shift))) << shift)
}

/// Expands one 128-byte block into 80 SHA-512 schedule words.
fn schedule(block: &[u8; 128]) [u64; 80] {
    let mut words: [u64; 80] = [0; 80];
    let mut i: u64 = 0;
    while i < 16 {
        let mut word: u64 = 0;
        let mut byte: u64 = 0;
        while byte < 8 {
            word = (word << 8) | ((*block)[i * 8 + byte] as u64);
            byte = byte + 1;
        }
        words[i] = word;
        i = i + 1;
    }
    while i < 80 {
        let x = words[i - 15];
        let y = words[i - 2];
        let s0 = rotate_right(copy(x), 1) ^ rotate_right(copy(x), 8) ^ (x >> 7);
        let s1 = rotate_right(copy(y), 19) ^ rotate_right(copy(y), 61) ^ (y >> 6);
        words[i] = add_word(add_word(words[i - 16], s0), add_word(words[i - 7], s1));
        i = i + 1;
    }
    words
}

/// Applies 80 compression rounds and adds the result to the chaining state.
fn compress_rounds(state: &mut [u64; 8], words: &[u64; 80]) {
    let constants: [u64; 80] = [
        0x428a2f98d728ae22, 0x7137449123ef65cd, 0xb5c0fbcfec4d3b2f, 0xe9b5dba58189dbbc,
        0x3956c25bf348b538, 0x59f111f1b605d019, 0x923f82a4af194f9b, 0xab1c5ed5da6d8118,
        0xd807aa98a3030242, 0x12835b0145706fbe, 0x243185be4ee4b28c, 0x550c7dc3d5ffb4e2,
        0x72be5d74f27b896f, 0x80deb1fe3b1696b1, 0x9bdc06a725c71235, 0xc19bf174cf692694,
        0xe49b69c19ef14ad2, 0xefbe4786384f25e3, 0x0fc19dc68b8cd5b5, 0x240ca1cc77ac9c65,
        0x2de92c6f592b0275, 0x4a7484aa6ea6e483, 0x5cb0a9dcbd41fbd4, 0x76f988da831153b5,
        0x983e5152ee66dfab, 0xa831c66d2db43210, 0xb00327c898fb213f, 0xbf597fc7beef0ee4,
        0xc6e00bf33da88fc2, 0xd5a79147930aa725, 0x06ca6351e003826f, 0x142929670a0e6e70,
        0x27b70a8546d22ffc, 0x2e1b21385c26c926, 0x4d2c6dfc5ac42aed, 0x53380d139d95b3df,
        0x650a73548baf63de, 0x766a0abb3c77b2a8, 0x81c2c92e47edaee6, 0x92722c851482353b,
        0xa2bfe8a14cf10364, 0xa81a664bbc423001, 0xc24b8b70d0f89791, 0xc76c51a30654be30,
        0xd192e819d6ef5218, 0xd69906245565a910, 0xf40e35855771202a, 0x106aa07032bbd1b8,
        0x19a4c116b8d2d0c8, 0x1e376c085141ab53, 0x2748774cdf8eeb99, 0x34b0bcb5e19b48a8,
        0x391c0cb3c5c95a63, 0x4ed8aa4ae3418acb, 0x5b9cca4f7763e373, 0x682e6ff3d6b2b8a3,
        0x748f82ee5defb2fc, 0x78a5636f43172f60, 0x84c87814a1f0ab72, 0x8cc702081a6439ec,
        0x90befffa23631e28, 0xa4506cebde82bde9, 0xbef9a3f7b2c67915, 0xc67178f2e372532b,
        0xca273eceea26619c, 0xd186b8c721c0c207, 0xeada7dd6cde0eb1e, 0xf57d4f7fee6ed178,
        0x06f067aa72176fba, 0x0a637dc5a2c898a6, 0x113f9804bef90dae, 0x1b710b35131c471b,
        0x28db77f523047d84, 0x32caab7b40c72493, 0x3c9ebe0a15c9bebc, 0x431d67c49c100d4c,
        0x4cc5d4becb3e42b6, 0x597f299cfc657e2a, 0x5fcb6fab3ad6faec, 0x6c44198c4a475817,
    ];
    let mut a = (*state)[0];
    let mut b = (*state)[1];
    let mut c = (*state)[2];
    let mut d = (*state)[3];
    let mut e = (*state)[4];
    let mut f = (*state)[5];
    let mut g = (*state)[6];
    let mut h = (*state)[7];
    let mut i: u64 = 0;
    while i < 80 {
        let sum1 = rotate_right(copy(e), 14) ^ rotate_right(copy(e), 18) ^ rotate_right(copy(e), 41);
        let choose = (e & f) ^ ((e ^ U64_MAX) & g);
        let t1 = add_word(add_word(h, sum1), add_word(choose, add_word(constants[i], (*words)[i])));
        let sum0 = rotate_right(copy(a), 28) ^ rotate_right(copy(a), 34) ^ rotate_right(copy(a), 39);
        let majority = (a & b) ^ (a & c) ^ (b & c);
        h = g;
        g = f;
        f = e;
        e = add_word(d, copy(t1));
        d = c;
        c = b;
        b = a;
        a = add_word(t1, add_word(sum0, majority));
        i = i + 1;
    }

    let output = &mut (*state)[0];
    *output = add_word(*output, a);
    let output = &mut (*state)[1];
    *output = add_word(*output, b);
    let output = &mut (*state)[2];
    *output = add_word(*output, c);
    let output = &mut (*state)[3];
    *output = add_word(*output, d);
    let output = &mut (*state)[4];
    *output = add_word(*output, e);
    let output = &mut (*state)[5];
    *output = add_word(*output, f);
    let output = &mut (*state)[6];
    *output = add_word(*output, g);
    let output = &mut (*state)[7];
    *output = add_word(*output, h);
}
