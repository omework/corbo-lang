// SPDX-License-Identifier: MIT OR Apache-2.0
//! MD5 checksums for compatibility with formats that require RFC 1321.

/// Mask for a word in the modulo-2^32 compression arithmetic.
const WORD_MASK: u64 = 0xffffffff;

/// Byte count mask for the modulo-2^64 bit length encoded by MD5.
const BYTE_COUNT_MASK: u64 = 0x1fffffffffffffff;

/// Streaming state for a legacy 16-byte MD5 checksum.
pub struct Md5 {
    /// Internal chaining or sponge state retained between updates.
    state: [u64; 4],
    /// Pending input block; update compresses full blocks before reusing this storage.
    block: [u8; 64],
    /// Total input bytes incorporated by this hash instance.
    bytes: u64,
}

impl Md5 {
    /// Creates a hasher with the standard MD5 initial state.
    fn new() -> Md5 {
        Md5 {
            state: [0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476],
            block: [0; 64],
            bytes: 0,
        }
    }

    /// Absorbs input bytes and compresses full blocks as they become available.
    fn update(&mut self, input: &[u8]) {
        let length = input.len() as u64;
        let bytes = (*self).bytes;
        let mut offset = bytes % 64;
        let mut index: u64 = 0;
        while index < length {
            let byte = &mut (*self).block[offset];
            *byte = input[index];
            offset = offset + 1;
            if offset == 64 {
                compress_md5(&mut *self);
                offset = 0;
            }
            index = index + 1;
        }
        let total = &mut (*self).bytes;
        *total = (bytes + (length & BYTE_COUNT_MASK)) & BYTE_COUNT_MASK;
    }

    /// Consumes the state, adds MD5 padding and returns the checksum.
    fn finish(mut self: Md5) -> [u8; 16] {
        let bits = self.bytes * 8;
        let used = self.bytes % 64;
        let separator = &mut self.block[used];
        *separator = 128;
        let mut position = used + 1;
        if position > 56 {
            while position < 64 {
                let byte = &mut self.block[position];
                *byte = 0;
                position = position + 1;
            }
            compress_md5(&mut self);
            position = 0;
        }
        while position < 56 {
            let byte = &mut self.block[position];
            *byte = 0;
            position = position + 1;
        }
        while position < 64 {
            let byte = &mut self.block[position];
            *byte = word_byte(copy(bits), (position - 56) * 8);
            position = position + 1;
        }
        compress_md5(&mut self);
        let mut output: [u8; 16] = [0; 16];
        let mut i: u64 = 0;
        while i < 16 {
            output[i] = word_byte(self.state[i / 4], (i % 4) * 8);
            i = i + 1;
        }
        output
    }
}

/// Extracts the eight bits starting at the supplied shift.
fn word_byte(word: u64, shift: u64) -> u8 {
    let mut value = word >> shift;
    let mut output: u8 = 0;
    let mut bit: u64 = 0;
    while bit < 8 {
        let low: u8 = if (value & 1) == 0 { 0 } else { 1 };
        output = output | (low << bit);
        value = value >> 1;
        bit = bit + 1;
    }
    output
}

/// Executes the 64 MD5 steps over a complete little-endian message block.
fn compress_md5(hash: &mut Md5) {
    // RFC 1321 constants: floor(2^32 * abs(sin(i))), for i from 1 to 64.
    let constants: [u64; 64] = [
        0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee,
        0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501,
        0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be,
        0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821,
        0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa,
        0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8,
        0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed,
        0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a,
        0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c,
        0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70,
        0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05,
        0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665,
        0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039,
        0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1,
        0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1,
        0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391,
    ];
    let rotations: [u64; 16] = [7,12,17,22, 5,9,14,20, 4,11,16,23, 6,10,15,21];
    let mut words: [u64; 16] = [0; 16];
    let mut i: u64 = 0;
    while i < 64 {
        words[i / 4] = words[i / 4] | (((*hash).block[i] as u64) << ((i % 4) * 8));
        i = i + 1;
    }
    let mut a = (*hash).state[0];
    let mut b = (*hash).state[1];
    let mut c = (*hash).state[2];
    let mut d = (*hash).state[3];
    i = 0;
    while i < 64 {
        let round = i / 16;
        let mixed = if round == 0 { (copy(b) & copy(c)) | ((copy(b) ^ WORD_MASK) & copy(d)) }
                    else if round == 1 { (copy(d) & copy(b)) | ((copy(d) ^ WORD_MASK) & copy(c)) }
                    else if round == 2 { copy(b) ^ copy(c) ^ copy(d) }
                    else { copy(c) ^ (copy(b) | (copy(d) ^ WORD_MASK)) };
        let word_index = if round == 0 { copy(i) }
                         else if round == 1 { (5 * i + 1) % 16 }
                         else if round == 2 { (3 * i + 5) % 16 }
                         else { (7 * i) % 16 };
        let sum = (a + mixed + constants[i] + words[word_index]) & WORD_MASK;
        let shift = rotations[round * 4 + i % 4];
        let rotated = ((copy(sum) << copy(shift)) & WORD_MASK) | (sum >> (32 - shift));
        a = d;
        d = c;
        c = copy(b);
        b = (b + rotated) & WORD_MASK;
        i = i + 1;
    }
    let addends: [u64; 4] = [a, b, c, d];
    i = 0;
    while i < 4 {
        let updated = ((*hash).state[i] + addends[i]) & WORD_MASK;
        let word = &mut (*hash).state[i];
        *word = updated;
        i = i + 1;
    }
}

/// Computes a 16-byte MD5 checksum for interoperability.
pub fn digest(input: &[u8]) -> [u8; 16] {
    let mut hash = Md5::new();
    hash.update(input);
    hash.finish()
}
