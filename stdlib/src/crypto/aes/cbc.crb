//! Padded AES-256-CBC for interoperable private-key containers.

/// Reports insufficient storage, invalid ciphertext length, or invalid CBC padding.
pub enum CbcError {
    /// The caller-provided output buffer cannot hold the result.
    BufferTooSmall;
    /// The ciphertext length or padding is invalid.
    InvalidCiphertext;
}

/// Computes the inverse AES S-box using the inverse affine transform and field inversion.
fn inverse_substitute(value: u8) u8 {
    field_inverse(rotate_byte(copy(value), 1) ^ rotate_byte(copy(value), 3) ^ rotate_byte(value, 6) ^ 5)
}

/// Applies inverse MixColumns to a column after the round key has been added.
fn inverse_column(state: &mut [u8; 16], at: u64) {
    let a = (*state)[at];
    let b = (*state)[at + 1];
    let c = (*state)[at + 2];
    let d = (*state)[at + 3];
    let parity_a = xtime(xtime(a ^ c));
    let parity_b = xtime(xtime(b ^ d));
    let x0 = a ^ parity_a;
    let x1 = b ^ parity_b;
    let x2 = c ^ parity_a;
    let x3 = d ^ parity_b;
    let parity = x0 ^ x1 ^ x2 ^ x3;
    let r0 = &mut (*state)[at];
    *r0 = x0 ^ parity ^ xtime(x0 ^ x1);
    let r1 = &mut (*state)[at + 1];
    *r1 = x1 ^ parity ^ xtime(x1 ^ x2);
    let r2 = &mut (*state)[at + 2];
    *r2 = x2 ^ parity ^ xtime(x2 ^ x3);
    let r3 = &mut (*state)[at + 3];
    *r3 = x3 ^ parity ^ xtime(x3 ^ x0);
}

/// Decrypts one AES-256 block using the existing expanded encryption key.
fn decrypt_cbc_block(schedule: &[u8; 240], block: &mut [u8; 16]) {
    let mut round: u64 = 14;
    let mut i: u64 = 0;
    while i < 16 {
        let byte = &mut (*block)[i];
        *byte = *byte ^ (*schedule)[224 + i];
        i = i + 1;
    }
    let mut state: [u8; 16] = [0; 16];
    while round > 0 {
        round = round - 1;
        i = 0;
        while i < 16 {
            let row = i % 4;
            let column = (i / 4 + 4 - row) % 4;
            state[i] = inverse_substitute((*block)[4 * column + row]) ^ (*schedule)[round * 16 + i];
            i = i + 1;
        }
        if round > 0 {
            i = 0;
            while i < 16 {
                inverse_column(&mut state, copy(i));
                i = i + 4;
            }
        }
        i = 0;
        while i < 16 {
            let byte = &mut (*block)[i];
            *byte = state[i];
            i = i + 1;
        }
    }
}

/// Expands the supplied AES-256 key into round-key storage.
fn cbc_schedule(key: &[u8; 32]) [u8; 240] {
    let mut schedule: [u8; 240] = [0; 240];
    let mut at: u64 = 0;
    while at < 32 {
        schedule[at] = (*key)[at];
        at = at + 1;
    }
    expand_key(32, &mut schedule);
    schedule
}

/// Encrypts bytes with AES-256-CBC and PKCS#7 padding and returns the ciphertext length.
pub fn cbc_encrypt_padded(key: &[u8; 32], iv: &[u8; 16], input: &[u8],
                          output: &mut [u8]) Result<usize, CbcError> {
    let size = input.len();
    let extra: usize = 16 - size % 16;
    let capacity = output.len();
    if size > capacity || extra > capacity - size { return Err(CbcError.BufferTooSmall); }
    let total = size + extra;
    // The padding byte is bounded by the block width.
    let pad = public_byte(extra as u64);
    let schedule = cbc_schedule(&*key);
    let accelerated = hardware_available();
    let mut block: [u8; 16] = [0; 16];
    let mut i: usize = 0;
    while i < 16 {
        block[i] = (*iv)[i];
        i = i + 1;
    }
    let mut at: usize = 0;
    while at < total {
        i = 0;
        while i < 16 {
            let value: u8 = if at + i < size { input[at + i] } else { copy(pad) };
            block[i] = block[i] ^ value;
            i = i + 1;
        }
        encrypt_block(&schedule, 14, copy(accelerated), &mut block);
        i = 0;
        while i < 16 {
            output[at + i] = block[i];
            i = i + 1;
        }
        at = at + 16;
    }
    Ok(total)
}

/// Decrypts padded AES-256-CBC. Invalid padding clears the decrypted region of output.
/// On success, the returned length excludes the padding.
pub fn cbc_decrypt_padded(key: &[u8; 32], iv: &[u8; 16], input: &[u8],
                          output: &mut [u8]) Result<usize, CbcError> {
    let size = input.len();
    if size < 16 || size % 16 != 0 { return Err(CbcError.InvalidCiphertext); }
    if size > output.len() { return Err(CbcError.BufferTooSmall); }
    let schedule = cbc_schedule(&*key);
    let mut block: [u8; 16] = [0; 16];
    let mut at: usize = 0;
    while at < size {
        let mut i: usize = 0;
        while i < 16 {
            block[i] = input[at + i];
            i = i + 1;
        }
        decrypt_cbc_block(&schedule, &mut block);
        i = 0;
        while i < 16 {
            let previous = if at == 0 { (*iv)[i] } else { input[at - 16 + i] };
            output[at + i] = block[i] ^ previous;
            i = i + 1;
        }
        at = at + 16;
    }
    let pad = output[size - 1];
    let mut difference: u64 = 0;
    let mut i: usize = 0;
    while i < 16 {
        // The mask is all eight bits at positions covered by the padding.
        let mask = ((255 + (pad as u64) - (i as u64)) >> 8) * 255;
        let byte = output[size - 1 - i] as u64;
        difference = difference | ((byte ^ (pad as u64)) & mask);
        i = i + 1;
    }
    if pad == 0 || pad > 16 || difference != 0 {
        i = 0;
        while i < size { output[i] = 0; i = i + 1; }
        return Err(CbcError.InvalidCiphertext);
    }
    i = size - pad as usize;
    while i < size { output[i] = 0; i = i + 1; }
    Ok(size - pad as usize)
}
