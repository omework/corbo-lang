//! P-256 key generation, ephemeral key agreement and deterministic ECDSA.

use std::crypto::random::fill;
use std::encoding::der::der;
use std::encoding::pem::{decode as decode_pem, Error as PemError};

/// Reports invalid keys or signatures, input limits, output capacity or system entropy errors.
pub enum Error {
    /// The caller-provided output buffer cannot hold the result.
    BufferTooSmall;
    /// The system random source could not provide the required bytes.
    RandomFailed;
    /// The encoded/private scalar material is invalid for this key format.
    InvalidPrivateKey;
    /// The public point/key encoding is invalid or outside the supported curve.
    InvalidPublicKey;
    /// The signature encoding or scalar values are invalid.
    InvalidSignature;
    /// Input length exceeds the algorithm's supported counter or encoding limit.
    InputTooLong;
}

/// Holds a private P-256 scalar for one consuming ECDHE agreement.
pub struct EphemeralKey {
    /// Private scalar limbs; never expose these through a public borrowed view.
    secret: [u64; 8];

    /// Creates a key using a private scalar sampled from system entropy.
    pub fn generate() Result<EphemeralKey, Error> {
        let mut bytes: [u8; 32] = [0; 32];
        match random_scalar(&mut bytes[..]) {
            Ok(()) => {},
            Err(error) => { return Err(error); },
        };
        ephemeral_from_bytes(&bytes[..])
    }

    /// Derives the public point corresponding to this private scalar.
    pub fn public_key(&self) PublicKey {
        let secret = private_words(&(*self).secret);
        derive_public(&secret[..])
    }

    /// Consumes the ephemeral key and writes the 32-byte ECDHE shared secret.
    pub fn agree(self: EphemeralKey, peer: &PublicKey, output: &mut [u8; 32]) Result<(), Error> {
        let scalar = private_words(&self.secret);
        let point = public_words(&(*peer).point);
        let shared = scalar_multiply(&point[..], &scalar[..]);
        let z = coordinate(&shared[..], 16);
        if zero_bit(&z[..]) == 1 { return Err(Error::InvalidPublicKey); }
        let x = affine_x(&shared[..]);
        let mut bytes: [u8; 32] = [0; 32];
        write_words(&x[..], &mut bytes[..], 0);
        let mut i: usize = 0;
        while i < 32 {
            let byte = &mut (*output)[i];
            *byte = bytes[i];
            i = i + 1;
        }
        Ok(())
    }
}

/// Holds a P-256 private scalar used to derive a public key and sign messages.
pub struct SigningKey {
    /// Private scalar limbs; never expose these through a public borrowed view.
    secret: [u64; 8];

    /// Creates a key using a private scalar sampled from system entropy.
    pub fn generate() Result<SigningKey, Error> {
        let mut bytes: [u8; 32] = [0; 32];
        match random_scalar(&mut bytes[..]) {
            Ok(()) => {},
            Err(error) => { return Err(error); },
        };
        SigningKey::from_bytes(&bytes)
    }

    /// Imports a 32-byte big-endian private scalar after checking its range.
    pub fn from_bytes(input: &[u8; 32]) Result<SigningKey, Error> {
        let mut bytes: [u8; 32] = [0; 32];
        let mut index: usize = 0;
        while index < 32 {
            bytes[index] = (*input)[index];
            index = index + 1;
        }
        let scalar = read_words(&bytes[..], 0);
        if !valid_scalar(&scalar[..]) { return Err(Error::InvalidPrivateKey); }
        let mut key = SigningKey { secret: [0; 8] };
        let mut i: u64 = 0;
        while i < 8 {
            let limb = &mut key.secret[i];
            *limb = scalar[i];
            i = i + 1;
        }
        Ok(key)
    }

    /// Derives the public point corresponding to this private scalar.
    pub fn public_key(&self) PublicKey {
        let secret = private_words(&(*self).secret);
        derive_public(&secret[..])
    }

    /// Signs a message with deterministic ECDSA and writes the DER signature.
    pub fn sign_sha256(&self, message: &[u8], output: &mut [u8; 72]) Result<usize, Error> {
        let secret = private_words(&(*self).secret);
        let length = message.len();
        let mut der: [u8; 72] = [0; 72];
        match sign_message(&secret[..], &message[0..length], &mut der[..]) {
            Err(error) => { Err(error) },
            Ok(size) => {
                let mut i: usize = 0;
                while i < size {
                    let byte = &mut (*output)[i];
                    *byte = der[i];
                    i = i + 1;
                }
                Ok(size)
            },
        }
    }

    /// Imports a P-256 signing key from unencrypted PKCS#8 or SEC1 DER.
    pub fn from_der(input: &[u8]) Result<SigningKey, Error> {
        let size = input.len() as u64;
        let outer = der(&input[0..size], 0, copy(size), 48);
        if outer.end == 0 || outer.end != size { return Err(Error::InvalidPrivateKey); }
        if version_is(&input[0..size], outer.body, copy(size), 1) {
            return read_sec1(&input[0..size], false);
        }
        read_pkcs8(&input[0..size])
    }

    /// Imports one PRIVATE KEY or EC PRIVATE KEY block. The scratch buffer retains private DER.
    pub fn from_pem(input: &[u8], scratch: &mut [u8]) Result<SigningKey, Error> {
        let size = input.len();
        let capacity = scratch.len();
        let standard: [u8; 11] = [80,82,73,86,65,84,69,32,75,69,89]; // PRIVATE KEY
        match decode_pem(&input[0..size], &standard[..], &mut scratch[0..capacity]) {
            Ok(length) => { return read_pkcs8(&scratch[0..length]); },
            Err(error) => {
                match error {
                    PemError::BufferTooSmall => { return Err(Error::BufferTooSmall); },
                    PemError::InvalidEnvelope => {},
                    PemError::InvalidBase64 => { return Err(Error::InvalidPrivateKey); },
                };
            },
        };
        let legacy: [u8; 14] = [69,67,32,80,82,73,86,65,84,69,32,75,69,89]; // EC PRIVATE KEY
        match decode_pem(&input[0..size], &legacy[..], &mut scratch[0..capacity]) {
            Ok(length) => { read_sec1(&scratch[0..length], false) },
            Err(error) => {
                match error {
                    PemError::BufferTooSmall => { Err(Error::BufferTooSmall) },
                    PemError::InvalidEnvelope => { Err(Error::InvalidPrivateKey) },
                    PemError::InvalidBase64 => { Err(Error::InvalidPrivateKey) },
                }
            },
        }
    }

    /// Writes an unencrypted PKCS#8 PrivateKeyInfo and returns its DER length.
    pub fn to_der(&self, output: &mut [u8]) Result<usize, Error> {
        if output.len() < 138 { return Err(Error::BufferTooSmall); }
        let header: [u8; 6] = [48,129,135,2,1,0];
        let algorithm = p256_algorithm_identifier();
        copy_der_field(&header[..], &mut output[0..6]);
        copy_der_field(&algorithm[..], &mut output[6..27]);
        output[27] = 4;
        output[28] = 109;
        write_sec1(&*self, false, &mut output[29..138]);
        Ok(138)
    }

    /// Writes an unencrypted SEC1 ECPrivateKey and returns its DER length.
    pub fn to_sec1_der(&self, output: &mut [u8]) Result<usize, Error> {
        if output.len() < 121 { return Err(Error::BufferTooSmall); }
        write_sec1(&*self, true, &mut output[0..121]);
        Ok(121)
    }

    /// Writes a PRIVATE KEY PEM block containing an unencrypted PKCS#8 key.
    pub fn to_pem(&self, output: &mut [u8]) Result<usize, Error> {
        let mut bytes: [u8; 138] = [0; 138];
        let length = match self.to_der(&mut bytes[..]) {
            Ok(size) => { size },
            Err(error) => { return Err(error); },
        };
        let label: [u8; 11] = [80,82,73,86,65,84,69,32,75,69,89]; // PRIVATE KEY
        write_key_pem(&bytes[..length], &label[..], output)
    }

    /// Writes an EC PRIVATE KEY PEM block containing an unencrypted SEC1 key.
    pub fn to_sec1_pem(&self, output: &mut [u8]) Result<usize, Error> {
        let mut bytes: [u8; 121] = [0; 121];
        let length = match self.to_sec1_der(&mut bytes[..]) {
            Ok(size) => { size },
            Err(error) => { return Err(error); },
        };
        let label: [u8; 14] = [69,67,32,80,82,73,86,65,84,69,32,75,69,89]; // EC PRIVATE KEY
        write_key_pem(&bytes[..length], &label[..], output)
    }
}

/// Holds a validated P-256 curve point.
pub struct PublicKey {
    /// Encoded internal elliptic-curve point representation.
    point: [u64; 24];

    /// Parses a 65-byte SEC1 point and checks its coordinates and curve equation.
    pub fn from_sec1_uncompressed(input: &[u8]) Result<PublicKey, Error> {
        if input.len() != 65 { return Err(Error::InvalidPublicKey); }
        if input[0] != 4 { return Err(Error::InvalidPublicKey); }
        let x = read_words(&input[0..65], 1);
        let y = read_words(&input[0..65], 33);
        let prime = modulus(false);
        if less_than(&x[..], &prime[..]) == 0 || less_than(&y[..], &prime[..]) == 0 {
            return Err(Error::InvalidPublicKey);
        }
        let xm = to_montgomery(&x[..], false);
        let ym = to_montgomery(&y[..], false);
        if !on_curve(&xm[..], &ym[..]) { return Err(Error::InvalidPublicKey); }
        // P-256 has cofactor one. Every finite point on the curve is
        // in the prime-order subgroup.
        let one = montgomery_one(false);
        let point = point_new(&xm[..], &ym[..], &one[..]);
        let key = public_from_point(&point[..]);
        Ok(key)
    }

    /// Serializes the public point in uncompressed SEC1 form.
    pub fn to_sec1_uncompressed(&self) [u8; 65] {
        let point = public_words(&(*self).point);
        let mut output: [u8; 65] = [0; 65];
        serialize_point(&point[..], &mut output[..]);
        output
    }

    /// Imports a P-256 SubjectPublicKeyInfo with an uncompressed point.
    pub fn from_der(input: &[u8]) Result<PublicKey, Error> {
        let size = input.len() as u64;
        let sequence = der(&input[0..size], 0, copy(size), 48);
        if sequence.end == 0 || sequence.end != size { return Err(Error::InvalidPublicKey); }
        let point = spki_point_offset(&input[0..size], sequence.body, sequence.end);
        if point == 0 { return Err(Error::InvalidPublicKey); }
        PublicKey::from_sec1_uncompressed(&input[point..point + 65])
    }

    /// Decodes one PUBLIC KEY block into scratch and imports its P-256 public point.
    pub fn from_pem(input: &[u8], scratch: &mut [u8]) Result<PublicKey, Error> {
        let size = input.len();
        let capacity = scratch.len();
        let label: [u8; 10] = [80,85,66,76,73,67,32,75,69,89]; // PUBLIC KEY
        match decode_pem(&input[0..size], &label[..], &mut scratch[0..capacity]) {
            Ok(length) => { PublicKey::from_der(&scratch[0..length]) },
            Err(error) => {
                match error {
                    PemError::BufferTooSmall => { Err(Error::BufferTooSmall) },
                    PemError::InvalidEnvelope => { Err(Error::InvalidPublicKey) },
                    PemError::InvalidBase64 => { Err(Error::InvalidPublicKey) },
                }
            },
        }
    }

    /// Writes a DER SubjectPublicKeyInfo with an uncompressed P-256 point.
    pub fn to_der(&self, output: &mut [u8]) Result<usize, Error> {
        if output.len() < 91 { return Err(Error::BufferTooSmall); }
        let algorithm = p256_algorithm_identifier();
        let point = self.to_sec1_uncompressed();
        output[0] = 48;
        output[1] = 89;
        copy_der_field(&algorithm[..], &mut output[2..23]);
        output[23] = 3;
        output[24] = 66;
        output[25] = 0;
        copy_der_field(&point[..], &mut output[26..91]);
        Ok(91)
    }

    /// Writes a PUBLIC KEY PEM block with a P-256 SubjectPublicKeyInfo.
    pub fn to_pem(&self, output: &mut [u8]) Result<usize, Error> {
        let mut bytes: [u8; 91] = [0; 91];
        let length = match self.to_der(&mut bytes[..]) {
            Ok(size) => { size },
            Err(error) => { return Err(error); },
        };
        let label: [u8; 10] = [80,85,66,76,73,67,32,75,69,89]; // PUBLIC KEY
        write_key_pem(&bytes[..length], &label[..], output)
    }
}

/// Writes the private scalar in big-endian form into a pre-sized 32-byte slice.
fn write_signing_scalar(key: &SigningKey, output: &mut [u8]) {
    let words = private_words(&(*key).secret);
    write_words(&words[..], output, 0);
}

/// Checks that a scalar is nonzero and smaller than the curve order.
fn valid_scalar(words: &[u64]) bool {
    let order = modulus(true);
    let nonzero: u64 = zero_bit(&words[0..8]) ^ 1;
    let below_order: u64 = less_than(&words[0..8], &order[..]);
    let valid: u64 = nonzero & below_order;
    return valid == 1;
}

/// Samples a private scalar from system entropy and rejects out-of-range candidates.
fn random_scalar(output: &mut [u8]) Result<(), Error> {
    while true {
        let size = output.len();
        match fill(&mut output[0..size]) {
            Ok(()) => {},
            Err(cause) => { drop(cause); return Err(Error::RandomFailed); },
        };
        let scalar = read_words(&output[0..32], 0);
        if valid_scalar(&scalar[..]) { return Ok(()); }
    }
    Ok(())
}

/// Builds an ephemeral agreement key after checking the scalar range.
fn ephemeral_from_bytes(input: &[u8]) Result<EphemeralKey, Error> {
    let scalar = read_words(&input[0..32], 0);
    if !valid_scalar(&scalar[..]) { return Err(Error::InvalidPrivateKey); }
    let mut key = EphemeralKey { secret: [0; 8] };
    let mut i: u64 = 0;
    while i < 8 {
        let limb = &mut key.secret[i];
        *limb = scalar[i];
        i = i + 1;
    }
    Ok(key)
}

/// Stores an internal point in the public key representation.
fn public_from_point(point: &[u64]) PublicKey {
    let mut key = PublicKey { point: [0; 24] };
    let mut i: u64 = 0;
    while i < 24 {
        let limb = &mut key.point[i];
        *limb = point[i];
        i = i + 1;
    }
    key
}

/// Multiplies the P-256 generator by the private scalar to derive its public key.
fn derive_public(secret: &[u64]) PublicKey {
    let base = generator();
    let point = scalar_multiply(&base[..], &secret[0..8]);
    public_from_point(&point[..])
}





/// Verifies a DER-encoded P-256 ECDSA signature over a SHA-256 message digest.
pub fn verify_sha256(key: &PublicKey, message: &[u8], signature: &[u8]) Result<bool, Error> {
    let point = public_words(&(*key).point);
    let size = message.len();
    let sig_size = signature.len();
    verify_message(&point[..], &message[0..size], &signature[0..sig_size])
}

/// Copies a fixed-size private scalar into the arithmetic representation.
fn private_words(words: &[u64; 8]) [u64; 8] {
    let mut result: [u64; 8] = [0; 8];
    let mut i: u64 = 0;
    while i < 8 {
        result[i] = (*words)[i];
        i = i + 1;
    }
    result
}

/// Copies the public point coordinates into the arithmetic representation.
fn public_words(words: &[u64; 24]) [u64; 24] {
    let mut result: [u64; 24] = [0; 24];
    let mut i: u64 = 0;
    while i < 24 {
        result[i] = (*words)[i];
        i = i + 1;
    }
    result
}
