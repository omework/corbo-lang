//! DER and PEM serialization for P-256 signing keys and public keys.

use std::encoding::der::{der, bytes_equal};
use std::encoding::pem::{encode as encode_pem};

/// Returns the DER algorithm identifier for id-ecPublicKey on the P-256 curve.
fn p256_algorithm_identifier() -> [u8; 21] {
    let identifier: [u8; 21] = [48,19,6,7,42,134,72,206,61,2,1, 6,8,42,134,72,206,61,3,1,7];
    identifier
}

/// Matches the DER algorithm identifier for id-ecPublicKey on the P-256 curve.
fn p256_algorithm(input: &[u8], start: u64, end: u64) -> bool {
    let algorithm = p256_algorithm_identifier();
    bytes_equal(&input[start..end], &algorithm[..])
}

// Input range contains the contents of SubjectPublicKeyInfo.
/// Returns the SEC1 point offset inside P-256 SubjectPublicKeyInfo, or zero on invalid framing.
pub fn spki_point_offset(input: &[u8], start: u64, end: u64) -> u64 {
    if end > input.len() as u64 || start > end || end - start != 89 { return 0; }
    if !p256_algorithm(&input[0..end], copy(start), start + 21) { return 0; }
    let bits = der(&input[0..end], start + 21, copy(end), 3);
    if bits.end != end || bits.end - bits.body != 66 || input[bits.body] != 0 { return 0; }
    bits.body + 1
}

/// Checks a DER INTEGER version against a one-byte expected value.
fn version_is(input: &[u8], start: u64, limit: u64, value: u8) -> bool {
    let version = der(&input[0..limit], start, copy(limit), 2);
    version.end != 0 && version.end - version.body == 1 && input[version.body] == value
}

/// Parses an ECPrivateKey and checks its curve and any supplied public point.
fn read_sec1(input: &[u8], outer_parameters: bool) -> Result<SigningKey, Error> {
    let size = input.len() as u64;
    let sequence = der(&input[0..size], 0, copy(size), 48);
    if sequence.end == 0 || sequence.end != size
       || !version_is(&input[0..size], sequence.body, copy(size), 1) {
        return Err(Error.InvalidPrivateKey);
    }
    let secret = der(&input[0..size], sequence.body + 3, copy(size), 4);
    if secret.end == 0 || secret.end - secret.body != 32 {
        return Err(Error.InvalidPrivateKey);
    }
    let mut at = secret.end;
    if at < size && input[at] == 160 {
        let scope = der(&input[0..size], copy(at), copy(size), 160);
        let curve: [u8; 10] = [6,8,42,134,72,206,61,3,1,7];
        if scope.end == 0 || !bytes_equal(&input[scope.body..scope.end], &curve[..]) {
            return Err(Error.InvalidPrivateKey);
        }
        at = scope.end;
    } else if !outer_parameters { return Err(Error.InvalidPrivateKey); }

    let mut scalar: [u8; 32] = [0; 32];
    let mut index: u64 = 0;
    while index < 32 {
        scalar[index] = input[secret.body + index];
        index = index + 1;
    }
    let key = match SigningKey::from_bytes(&scalar) {
        Ok(value) => { value },
        Err(error) => { return Err(error); },
    };
    if at < size {
        let scope = der(&input[0..size], at, copy(size), 161);
        if scope.end != size { return Err(Error.InvalidPrivateKey); }
        let public = der(&input[0..size], scope.body, copy(size), 3);
        if public.end != size || public.end - public.body != 66 || input[public.body] != 0 {
            return Err(Error.InvalidPrivateKey);
        }
        let actual = key.public_key();
        let bytes = actual.to_sec1_uncompressed();
        if !bytes_equal(&input[public.body + 1..size], &bytes[..]) { return Err(Error.InvalidPrivateKey); }
    }
    Ok(key)
}

/// Parses PKCS#8 PrivateKeyInfo and checks its P-256 algorithm identifier before opening the SEC1 payload.
fn read_pkcs8(input: &[u8]) -> Result<SigningKey, Error> {
    let size = input.len() as u64;
    let outer = der(&input[0..size], 0, copy(size), 48);
    if outer.end == 0 || outer.end != size || !version_is(&input[0..size], outer.body, copy(size), 0) {
        return Err(Error.InvalidPrivateKey);
    }
    let start = outer.body + 3;
    let algorithm = der(&input[0..size], copy(start), copy(size), 48);
    if algorithm.end == 0 || !p256_algorithm(&input[0..size], start, algorithm.end) {
        return Err(Error.InvalidPrivateKey);
    }
    let private = der(&input[0..size], algorithm.end, copy(size), 4);
    if private.end != size { return Err(Error.InvalidPrivateKey); }
    read_sec1(&input[private.body..private.end], true)
}

/// Copies a serialized field into a pre-sized DER output slice.
fn copy_der_field(input: &[u8], output: &mut [u8]) {
    let size = input.len();
    let mut i: usize = 0;
    while i < size {
        output[i] = input[i];
        i = i + 1;
    }
}

/// Writes an ECPrivateKey with a public point and optional named curve parameters.
fn write_sec1(key: &SigningKey, with_curve: bool, output: &mut [u8]) {
    let size = output.len();
    let header: [u8; 7] = [48, 107, 2, 1, 1, 4, 32];
    copy_der_field(&header[..], &mut output[0..7]);
    write_signing_scalar(&*key, &mut output[7..39]);
    let mut at: usize = 39;
    if with_curve {
        let curve: [u8; 12] = [160,10,6,8,42,134,72,206,61,3,1,7];
        output[1] = 119;
        copy_der_field(&curve[..], &mut output[39..51]);
        at = 51;
    }
    let bits: [u8; 5] = [161,68,3,66,0];
    copy_der_field(&bits[..], &mut output[at..at + 5]);
    let public = key.public_key();
    let point = public.to_sec1_uncompressed();
    copy_der_field(&point[..], &mut output[at + 5..size]);
}

/// Encodes a P-256 DER key with a standard PEM label into the caller's output.
fn write_key_pem(input: &[u8], label: &[u8], output: &mut [u8]) -> Result<usize, Error> {
    match encode_pem(input, label, output) {
        Ok(written) => { Ok(written) },
        // The label and DER length are fixed by the caller in this module.
        Err(error) => { drop(error); Err(Error.BufferTooSmall) },
    }
}
