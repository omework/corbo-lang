// SPDX-License-Identifier: MIT OR Apache-2.0
//! Standalone vector descriptors and region-backed data. The compiler selects
//! this ordinary owned object for bare Vector<T>; pooled Vector payloads retain
//! their existing representation. Element moves and retained dependencies are tracked by the compiler.

/// Owns one stable region registration. The movable fixed-size descriptor stays
/// in the datastack; its payload uses the construction scope's growing region.
#(type: T)
pub struct VectorValue<T> {
    /// Private runtime registration; moving the object transfers its cleanup.
    raw: usize;

    /// Creates an empty region-backed vector without a user-facing pool.
    pub fn new() VectorValue<T> {
        let raw = new_vector_region();
        VectorValue { raw: raw }
    }

    /// Returns the number of initialized elements.
    pub fn len(&self) usize {
        let raw = (*self).raw;
        let mut length: usize = 0;
        @unchecked { @c++(includes={"corbo_runtime.hpp"}) {
            ${length}=((CorboRegion*)${raw})->len;
        } }
        length
    }

    /// Reports whether the vector contains no initialized elements.
    pub fn is_empty(&self) bool { self.len() == 0 }

    /// Appends a moved value, enforcing the retained region budget.
    pub fn push(&mut self, value: T) {
        let raw = (*self).raw;
        let mut retained: Option<T> = Some(value);
        @unchecked { @c++(includes={"corbo_runtime.hpp","string.h"}) {
            CorboRegion *region=(CorboRegion*)${raw};
            __typeof__((${retained}).value) element=(${retained}).value;
            if(!region->len)region->width=sizeof(element);
            if(region->width!=sizeof(element))abort();
            memcpy(corbo_region_push(region),&element,sizeof(element));
            (${retained}).some=false;
        } }
    }

    /// Removes and returns the last element, or None when empty.
    pub fn pop(&mut self) Option<T> {
        let raw = (*self).raw;
        let mut result: Option<T> = None;
        @unchecked { @c++(includes={"corbo_runtime.hpp"}) {
            (${result}).some=vector_pop((CorboRegion*)${raw},&(${result}).value);
        } }
        result
    }

    /// Destroys remaining elements before reclaiming the region's cursor.
    pub fn clear(&mut self) {
        let raw = (*self).raw;
        loop {
            let mut removed: Option<T> = None;
            @unchecked { @c++(includes={"corbo_runtime.hpp"}) {
                (${removed}).some=vector_pop((CorboRegion*)${raw},&(${removed}).value);
            } }
            match removed {
                Some(value) => { drop(value); },
                None => { break; },
            }
        }
    }

    /// Destroys remaining elements, then releases region and registration once.
    pub fn drop(&mut self) {
        let raw = (*self).raw;
        loop {
            let mut removed: Option<T> = None;
            @unchecked { @c++(includes={"corbo_runtime.hpp"}) {
                (${removed}).some=vector_pop((CorboRegion*)${raw},&(${removed}).value);
            } }
            match removed {
                Some(value) => { drop(value); },
                None => { break; },
            }
        }
        release_vector_region(raw);
    }

}

/// Allocates stable registration storage through the ordinary datastack runtime.
fn new_vector_region() usize {
    let mut raw: usize = 0;
    @unchecked { @c++(includes={"corbo_runtime.hpp"}) {
        ${raw} = (uintptr_t)corbo_region_register(1);
    } }
    raw
}

/// Releases payload ownership before its fixed registration storage.
fn release_vector_region(raw: usize) {
    @unchecked { @c++(includes={"corbo_runtime.hpp"}) {
        corbo_region_unregister((CorboRegion*)${raw});
    } }
}
