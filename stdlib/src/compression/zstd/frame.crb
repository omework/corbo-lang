//! Bounded frame envelope scanning for the streaming decoder.

/// Finds the end of one standard or skippable frame without interpreting its entropy payload.
fn frame_size(input:&[u8])Result<usize,Error>{
    let size=input.len() as u64;if size<4{return Ok(0);}
    let magic=little(&input[0..input.len()],0,4);
    if magic>=0x184d2a50 && magic<=0x184d2a5f {
        if size<8{return Ok(0);}let count=little(&input[0..input.len()],4,4);
        if count>size-8{return Ok(0);}return Ok((count+8) as usize);
    }
    if magic!=0xfd2fb528{return Err(Error.InvalidData);}if size<5{return Ok(0);}
    let flags=input[4] as u64;if (flags&8)!=0{return Err(Error.InvalidData);}
    let single=(flags&32)!=0;let mut at:u64=5;if !single{at=at+1;}
    let dict_flag=flags&3;let dictionary:u64=if dict_flag==0{0}else{1<<(dict_flag-1)};
    let flag=flags>>6;let width:u64=if flag==0{if single{1}else{0}}else{1<<flag};
    at=at+dictionary+width;if at>size{return Ok(0);}
    loop {
        if size-at<3{return Ok(0);}let block=little(&input[0..input.len()],copy(at),3);at=at+3;
        let kind=(block>>1)&3;let count=block>>3;if kind==3 || count>131072{return Err(Error.InvalidData);}
        let stored:u64=if kind==1{1}else{count};if stored>size-at{return Ok(0);}at=at+stored;
        if (block&1)!=0{break;}
    }
    if (flags&4)!=0{if size-at<4{return Ok(0);}at=at+4;}Ok(at as usize)
}
