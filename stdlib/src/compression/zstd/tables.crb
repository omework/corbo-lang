/// Copies the RFC predefined literal-length, offset or match-length decoding table.
fn predefined(kind: u64, output: &mut [u64]) {
    if kind == 0 {
        let entries: [u64; 64] = [1024,1049600,2098433,1283,1284,1286,1287,1289,1290,1292,1550,1296,1298,1299,1301,1302,1304,2098457,1306,1563,1565,1567,2098176,1025,1282,2098436,1285,2098439,1288,2098442,1291,1549,2098448,1297,2098451,1300,2098454,1303,1049,1049625,2098458,1564,1566,3146752,1049601,2098434,2098435,2098437,2098438,2098440,2098441,2098443,2098444,1551,2098449,2098450,2098452,2098453,2098455,2098456,1571,1570,1569,1568];
        let mut i: u64 = 0; while i < 64 { output[i] = entries[i]; i = i + 1; }
    }
    else if kind == 1 {
        let entries: [u64; 32] = [1280,1030,1289,1295,1301,1283,1031,1292,1298,1303,1285,1032,1294,1300,1282,1049607,1291,1297,1302,1284,1049608,1293,1299,1281,1049606,1290,1296,1308,1307,1306,1305,1304];
        let mut i: u64 = 0; while i < 32 { output[i] = entries[i]; i = i + 1; }
    }
    else if kind == 2 {
        let entries: [u64; 64] = [1536,1025,2098434,1283,1285,1286,1288,1546,1549,1552,1555,1558,1561,1564,1567,1569,1571,1573,1575,1577,1579,1581,1049601,1026,2098435,1284,2098438,1287,1545,1548,1551,1554,1557,1560,1563,1566,1568,1570,1572,1574,1576,1578,1580,2098177,3146753,1049602,2098436,2098437,2098439,2098440,1547,1550,1553,1556,1559,1562,1565,1588,1587,1586,1585,1584,1583,1582];
        let mut i: u64 = 0; while i < 64 { output[i] = entries[i]; i = i + 1; }
    }
}
