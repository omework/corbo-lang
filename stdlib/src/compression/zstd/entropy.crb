//! Bounded native Huffman construction and entropy encoding.

/// Builds bounded Huffman code lengths from frequencies; returns false when a depth limit would be exceeded.
fn entropy_lengths(frequencies: &[u64], lengths: &mut [u64], maximum: u64) bool {
    let count = frequencies.len() as u64;
    if count > 288 || (lengths.len() as u64) < count { return false; }
    let mut weights: [u64;576] = [0;576]; let mut parents: [u64;576] = [0;576];
    let mut used: u64 = 0; let mut i: u64 = 0;
    while i < count { weights[i] = frequencies[i]; if weights[i] != 0 { used = used + 1; } i = i + 1; }
    if used == 0 { return false; }
    if used == 1 {
        i = 0; while i < count && weights[i] != 0 { i = i + 1; }
        if i == count { return false; } weights[i] = 1; used = 2;
    }
    let mut next = copy(count); let mut merged: u64 = 1;
    while merged < used {
        let mut first: u64 = 576; let mut second: u64 = 576; i = 0;
        while i < next {
            if weights[i] != 0 && parents[i] == 0 {
                if first == 576 || weights[i] < weights[first] { second = first; first = copy(i); }
                else if second == 576 || weights[i] < weights[second] { second = copy(i); }
            }
            i = i + 1;
        }
        if first == 576 || second == 576 { return false; }
        weights[next] = weights[first] + weights[second]; parents[first] = next + 1; parents[second] = next + 1;
        next = next + 1; merged = merged + 1;
    }
    i = 0;
    while i < count {
        lengths[i] = 0;
        if weights[i] != 0 {
            let mut node = copy(i); let mut depth: u64 = 0;
            while parents[node] != 0 { node = parents[node] - 1; depth = depth + 1; }
            if depth == 0 || depth > maximum { return false; } lengths[i] = depth;
        }
        i = i + 1;
    }
    true
}

/// Emits one or four reversed Huffman literal streams when they beat a raw block; zero means raw fallback.
fn entropy_block(input: &[u8], output: &mut [u8], start: u64, last: bool) u64 {
    let count = input.len() as u64;
    if count < 64 || count > 131072 { return 0; }
    let mut frequencies: [u64;256] = [0;256]; let mut lengths: [u64;256] = [0;256];
    let mut highest: u64 = 0; let mut i: u64 = 0;
    while i < count { let symbol = input[i] as u64; frequencies[symbol] = frequencies[symbol] + 1; if symbol > highest { highest = symbol; } i = i + 1; }
    // A direct RFC weight header carries at most 128 explicit weights.
    if highest > 128 || !entropy_lengths(&frequencies[..], &mut lengths[..], 11) { return 0; }
    highest = 0; let mut maximum: u64 = 0; i = 0;
    while i < 256 { if lengths[i] != 0 { highest = copy(i); if lengths[i] > maximum { maximum = lengths[i]; } } i = i + 1; }
    if highest == 0 || highest > 128 { return 0; }
    let mut marks: [u64;12] = [0;12]; let mut codes: [u64;256] = [0;256]; i = 0;
    while i <= highest { if lengths[i] != 0 { let weight = maximum + 1 - lengths[i]; marks[weight] = marks[weight] + 1; } i = i + 1; }
    let mut next: u64 = 0; i = 1;
    while i <= maximum { let begin = copy(next); next = next + (marks[i] << (i - 1)); marks[i] = begin; i = i + 1; }
    i = 0;
    while i <= highest {
        if lengths[i] != 0 { let weight = maximum + 1 - lengths[i]; codes[i] = marks[weight] >> (weight - 1); marks[weight] = marks[weight] + (1 << (weight - 1)); }
        i = i + 1;
    }
    let streams: u64 = if count <= 1023 { 1 } else { 4 };
    let each = (count + streams - 1) / streams;
    let mut sizes: [u64;4] = [0;4]; let tree_bytes = 1 + (highest + 1) / 2;
    let mut compressed = copy(tree_bytes); let mut stream: u64 = 0;
    if streams == 4 { compressed = compressed + 6; }
    while stream < streams {
        let begin = stream * each; let end = if begin + each < count { begin + each } else { copy(count) };
        let mut bit_count: u64 = 1; i = begin;
        while i < end { bit_count = bit_count + lengths[input[i] as u64]; i = i + 1; }
        sizes[stream] = (bit_count + 7) / 8; compressed = compressed + sizes[stream]; stream = stream + 1;
    }
    let header: u64 = if streams == 1 { 3 } else if count < 16384 && compressed < 16384 { 4 } else { 5 };
    let payload = header + compressed + 1;
    if payload >= count || payload > 131072 || start > output.len() as u64 || output.len() as u64 - start < payload + 3 { return 0; }
    let final: u64 = if last { 1 } else { 0 };
    put_little(&mut output[0..output.len()], copy(start), (payload << 3) | 4 | final, 3);
    let mut at = start + 3;
    let literal_header: u64 = if header == 3 { 2 | (count << 4) | (compressed << 14) }
        else if header == 4 { 10 | (count << 4) | (compressed << 18) } else { 14 | (count << 4) | (compressed << 22) };
    put_little(&mut output[0..output.len()], copy(at), literal_header, copy(header)); at = at + header;
    output[at] = byte(127 + highest); at = at + 1; i = 0;
    while i < highest {
        let a: u64 = if lengths[i] == 0 { 0 } else { maximum + 1 - lengths[i] };
        let mut b: u64 = 0;
        if i + 1 < highest && lengths[i + 1] != 0 { b = maximum + 1 - lengths[i + 1]; }
        output[at] = byte((a << 4) | b); at = at + 1; i = i + 2;
    }
    if streams == 4 {
        put_little(&mut output[0..output.len()], copy(at), sizes[0], 2);
        put_little(&mut output[0..output.len()], at + 2, sizes[1], 2);
        put_little(&mut output[0..output.len()], at + 4, sizes[2], 2); at = at + 6;
    }
    stream = 0;
    while stream < streams {
        let begin = stream * each; let end = if begin + each < count { begin + each } else { copy(count) };
        let mut cursor = at * 8; i = end;
        while i > begin { i = i - 1; let symbol = input[i] as u64; cursor = put_bits(&mut output[0..output.len()], cursor, codes[symbol], lengths[symbol]); }
        drop(put_bits(&mut output[0..output.len()], cursor, 1, 1));
        at = at + sizes[stream]; stream = stream + 1;
    }
    output[at] = 0; at + 1
}
