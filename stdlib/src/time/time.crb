//! Monotonic durations, instants and deadline waits; no wall-clock/calendar semantics.
use std::sys::time::clock;

/// Reports clock, sleep or asynchronous worker-launch failure.
pub enum Error {
    /// The system monotonic clock could not be read.
    ClockFailure;
    /// The system sleep call failed for a reason other than interruption.
    WaitFailure;
    /// The asynchronous runtime could not start the blocking worker.
    LaunchFailed;
}

/// A nonnegative span with nanosecond units and checked arithmetic.
pub struct Duration {
    /// Span in nanoseconds; private so constructors define the representation.
    nanos: u64;

    /// Constructs a span from nanoseconds.
    pub fn from_nanos(nanos: u64) Duration { Duration { nanos: nanos } }
    /// Constructs a span from milliseconds; integer overflow follows checked arithmetic.
    pub fn from_millis(millis: u64) Duration { Duration { nanos: millis * 1000000 } }
    /// Constructs a span from seconds; integer overflow follows checked arithmetic.
    pub fn from_secs(seconds: u64) Duration { Duration { nanos: seconds * 1000000000 } }
    /// Returns the span in nanoseconds without changing it.
    pub fn as_nanos(&self) u64 { (*self).nanos }
}

/// An opaque monotonic timestamp; not a date or portable serialized timestamp.
pub struct Instant {
    /// Platform clock expressed in nanoseconds; clock resolution remains platform-specific.
    ticks: u64;

    /// Reads the current monotonic timestamp.
    pub fn now() Result<Instant, Error> {
        let (status, ticks) = clock();
        if status != 0 { return Err(Error::ClockFailure); }
        Ok(Instant { ticks: ticks })
    }
    /// Returns an instant after this one; addition uses checked integer arithmetic.
    pub fn after(&self, duration: Duration) Instant {
        Instant { ticks: (*self).ticks + duration.as_nanos() }
    }
    /// Measures time since this instant, saturating a backward platform reading at zero.
    pub fn elapsed(&self) Result<Duration, Error> {
        let now = Instant::now()?;
        let current = now.ticks;
        let start = (*self).ticks;
        Ok(Duration { nanos: if copy(current) >= copy(start) { current - start } else { 0 } })
    }
    /// Measures the remaining span until this instant, saturating past deadlines at zero.
    pub fn remaining(&self) Result<Duration, Error> {
        let now = Instant::now()?;
        let current = now.ticks;
        let deadline = (*self).ticks;
        Ok(Duration { nanos: if copy(deadline) > copy(current) { deadline - current } else { 0 } })
    }
}



use std::sys::time::pause;

/// A reusable monotonic deadline; waiting does not consume it.
pub struct Timer {
    /// Absolute monotonic timestamp of the deadline.
    deadline: Instant;

    /// Creates a timer that becomes ready after the given span.
    pub fn after(duration: Duration) Result<Timer, Error> {
        let now = Instant::now()?;
        let deadline = now.after(duration);
        Ok(Timer { deadline: deadline })
    }
    /// Creates a timer for an existing monotonic deadline.
    pub fn at(deadline: Instant) Timer { Timer { deadline: deadline } }
    /// Blocks this thread until the deadline, retrying interruptions and early wakes.
    pub fn wait(&self) Result<(), Error> {
        loop {
            let deadline = &(*self).deadline;
            let span = deadline.remaining()?;
            let remaining = span.as_nanos();
            if copy(remaining) == 0 { return Ok(()); }
            let chunk: u64 = if copy(remaining) > 60000000000 { 60000000000 } else { remaining };
            if pause(chunk) != 0 { return Err(Error::WaitFailure); }
        };
        Err(Error::WaitFailure)
    }
}

/// Blocks the current thread for at least the given monotonic span.
pub fn sleep(duration: Duration) Result<(), Error> {
    let timer = Timer::after(duration)?;
    timer.wait()
}
