//! Content equality for borrowed byte slices.

// Implementation of &[u8].content_eq().
/// Compares all bytes and the length of two slices, with an early return on a difference.
fn content_eq(left: &[u8], right: &[u8]) -> bool {
    if left.len() != right.len() { return false; }

    let mut index: usize = 0;
    while index < left.len() {
        if left[index] != right[index] { return false; }
        index = index + 1;
    }
    true
}
