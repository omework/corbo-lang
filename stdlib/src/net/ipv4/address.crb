// SPDX-License-Identifier: MIT OR Apache-2.0
//! IPv4 addresses and socket endpoints with dotted-decimal parsing.

/// Stores an IPv4 address as four packed octets.
pub struct Addr {
    /// IPv4 address bits in the representation used by from_parts and octet accessors.
    bits: u32;

    /// Packs four IPv4 octets in network order.
    pub fn new(a: u8, b: u8, c: u8, d: u8) Addr {
        Addr { bits: ((a as u32) << 24) | ((b as u32) << 16) | ((c as u32) << 8) | (d as u32) }
    }
}

/// Pairs a packed IPv4 address with a 16-bit port.
pub struct SocketAddr {
    /// IPv4 address bits in the representation used by from_parts and octet accessors.
    bits: u32;
    /// Transport port number, including zero before OS port allocation.
    port_number: u16;

    /// Pairs an IPv4 address with the supplied port number.
    pub fn new(ip: Addr, port: u16) SocketAddr {
        SocketAddr { bits: ip.bits, port_number: port }
    }

    /// Returns the address with the first IPv4 octet in the high byte.
    pub fn ipv4_bits(&self) u32 { (*self).bits }

    /// Returns the socket endpoint's port number.
    pub fn port(&self) u16 { (*self).port_number }

    /// Parses an IPv4 endpoint written as four decimal octets, a colon and a decimal port.
    pub fn parse(text: &str) Result<SocketAddr, ParseError> {
        let bytes = text.as_bytes();
        let mut index: usize = 0;
        let mut octets: usize = 0;
        let mut ip: u32 = 0;
        let mut value: u16 = 0;
        let mut has_digit = false;

        while index < bytes.len() {
            let byte = bytes[index];
            if byte >= 48 && byte <= 57 {
                let limit: u16 = if octets == 4 { 65535 } else { 255 };
                let digit = byte as u16 - 48;
                if value > (limit - digit) / 10 { return Err(ParseError::InvalidAddress); }
                value = value * 10 + digit;
                has_digit = true;
            } else {
                if !has_digit || octets == 4 { return Err(ParseError::InvalidAddress); }
                if octets == 3 {
                    if byte != 58 { return Err(ParseError::InvalidAddress); }
                } else {
                    if byte != 46 { return Err(ParseError::InvalidAddress); }
                }
                ip = (ip << 8) | (value as u32);
                octets += 1;
                value = 0;
                has_digit = false;
            }
            index += 1;
        }

        if octets != 4 || !has_digit { return Err(ParseError::InvalidAddress); }
        Ok(from_parts(ip, value))
    }
}

/// Reports invalid IPv4 endpoint syntax or an out-of-range address component.
pub enum ParseError {
    /// The IPv4 address or port text is malformed or out of range.
    InvalidAddress;
}



/// Constructs a socket endpoint from packed IPv4 bits and a port.
pub fn from_parts(ip: u32, port: u16) SocketAddr {
    SocketAddr { bits: ip, port_number: port }
}
