//! Asynchronous IPv4 TCP connections, listeners and borrowed stream halves.

#(if: target.os == "linux" && target.arch == "x86_64" && target.pointer_width == "64" || target.os == "macos" && target.arch == "aarch64" || target.os == "macos" && target.arch == "x86_64" || target.os == "windows" && target.arch == "aarch64" || target.os == "windows" && target.arch == "x86_64")
    use std::net::SocketError;
    use std::net::ipv4::{SocketAddr, from_parts};
    use std::sys::net::{PlatformSocket, open_listener, socket_descriptor};

    use std::sys::net::asyn::{prepare_async, accept_nonblocking, connect_nonblocking, read_nonblocking, write_nonblocking};

    /// Owns the socket used by asynchronous TCP reads and writes.
    pub struct Connection {
        /// Owned native socket storage; the connection/listener closes it on destruction.
        __din_package_socket: PlatformSocket;
        /// Cached local IPv4 endpoint, including any OS-assigned port.
        local_address: SocketAddr;
        /// Cached remote IPv4 endpoint.
        remote_address: SocketAddr;
        /// Descriptor view reserved for the read half; the connection retains closure responsibility.
        read_descriptor: u64;
        /// Descriptor view reserved for the write half; the connection retains closure responsibility.
        write_descriptor: u64;

        /// Borrows separate read and write views from the connection, which still owns the socket.
        fn split(&mut self) (ReadHalf, WriteHalf) {
            let read = &mut (*self).read_descriptor;
            let write = &mut (*self).write_descriptor;
            (ReadHalf { descriptor: read }, WriteHalf { descriptor: write })
        }

        /// Returns the local IPv4 address and port, including a port assigned by the OS.
        fn addr(&self) SocketAddr {
            let local = &(*self).local_address;
            from_parts(local.ipv4_bits(), local.port())
        }

        /// Returns the remote IPv4 address and port associated with the connection.
        fn peer(&self) SocketAddr {
            let remote = &(*self).remote_address;
            from_parts(remote.ipv4_bits(), remote.port())
        }

        /// Awaits a write from the borrowed slice and returns the actual byte count.
        async fn write(&mut self, buffer: &[u8]) Result<usize, SocketError> {
            if buffer.len() == 0 { return Ok(0); }
            let inner = &(*self).__din_package_socket;
            write_nonblocking(socket_descriptor(inner), buffer).await
        }

        /// Awaits bytes into the borrowed output slice. Zero indicates EOF when the slice is nonempty.
        async fn read(&mut self, buffer: &mut [u8]) Result<usize, SocketError> {
            let inner = &(*self).__din_package_socket;
            read_nonblocking(socket_descriptor(inner), buffer).await
        }

}

    /// Borrows the portion of a TCP connection needed to read without owning its socket.
    pub struct ReadHalf {
        /// Borrowed native descriptor view; its owning connection must outlive this half.
        descriptor: &mut u64;

        /// Awaits bytes into the borrowed output slice. Zero indicates EOF when the slice is nonempty.
        async fn read(&mut self, buffer: &mut [u8]) Result<usize, SocketError> {
            read_nonblocking(*(*self).descriptor, buffer).await
        }

}

    /// Borrows the portion of a TCP connection needed to write without owning its socket.
    pub struct WriteHalf {
        /// Borrowed native descriptor view; its owning connection must outlive this half.
        descriptor: &mut u64;

        /// Awaits a write from the borrowed slice and returns the actual byte count.
        async fn write(&mut self, buffer: &[u8]) Result<usize, SocketError> {
            write_nonblocking(*(*self).descriptor, buffer).await
        }

}



    /// Owns a nonblocking listening socket for asynchronous accepts.
    pub struct Listener {
        /// Owned native socket storage; the connection/listener closes it on destruction.
        __din_package_socket: PlatformSocket;
        /// Cached local IPv4 endpoint, including any OS-assigned port.
        local_address: SocketAddr;

        /// Binds a TCP listener and prepares its native socket for asynchronous accepts.
        fn bind(address: SocketAddr, backlog: Option<i32>) Result<Listener, SocketError> {
            let limit = match backlog {
                Some(value) => { value },
                None => { 2147483647 },
            };
            let inner = match open_listener(1, address.ipv4_bits(), address.port(), limit) {
                Ok(value) => { value },
                Err(error) => { return Err(error); },
            };
            match prepare_async(&inner) {
                Ok(()) => {}, Err(error) => { return Err(error); },
            };
            let local = match inner.endpoint(0) {
                Ok(value) => { value },
                Err(error) => { return Err(error); },
            };
            Ok(Listener { __din_package_socket: inner, local_address: local })
        }

        /// Returns the local IPv4 address and port, including a port assigned by the OS.
        fn addr(&self) SocketAddr {
            let local = &(*self).local_address;
            from_parts(local.ipv4_bits(), local.port())
        }

        /// Awaits an incoming TCP connection and returns its owned socket wrapper.
        async fn accept(&mut self) Result<Connection, SocketError> {
            let inner = &mut (*self).__din_package_socket;
            let accepted = match accept_nonblocking(inner).await {
                Ok(value) => { value },
                Err(error) => { return Err(error); },
            };
            connection(accepted)
        }

}

    /// Builds the async connection wrapper and records its local and peer endpoints.
    fn connection(inner: PlatformSocket) Result<Connection, SocketError> {
        let local = match inner.endpoint(0) {
            Ok(value) => { value },
            Err(error) => { return Err(error); },
        };
        let remote = match inner.endpoint(1) {
            Ok(value) => { value },
            Err(error) => { return Err(error); },
        };
        let descriptor = socket_descriptor(&inner);
        Ok(Connection {
            __din_package_socket: inner, local_address: local, remote_address: remote,
            read_descriptor: copy(descriptor), write_descriptor: descriptor,
        })
    }

    /// Awaits a nonblocking TCP connection to the supplied endpoint.
    pub async fn connect(address: SocketAddr) Result<Connection, SocketError> {
        let inner = match connect_nonblocking(address.ipv4_bits(), address.port()).await {
            Ok(value) => { value },
            Err(error) => { return Err(error); },
        };
        connection(inner)
    }



#(endif)
