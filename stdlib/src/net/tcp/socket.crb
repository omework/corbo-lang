//! Blocking IPv4 TCP connections and listeners over the platform socket API.

#(if: target.os == "linux" && target.arch == "x86_64" && target.pointer_width == "64" || target.os == "macos" && target.arch == "aarch64" || target.os == "macos" && target.arch == "x86_64" || target.os == "windows" && target.arch == "aarch64" || target.os == "windows" && target.arch == "x86_64")
    use std::net::SocketError;
    use std::net::ipv4::{SocketAddr, from_parts};
    use std::sys::net::{PlatformSocket, open_connection, open_listener};

    /// Owns a connected IPv4 TCP socket.
    pub struct Connection {
        /// Owned native socket storage; the connection/listener closes it on destruction.
        __din_package_socket: PlatformSocket;
        /// Cached local IPv4 endpoint, including any OS-assigned port.
        local_address: SocketAddr;
        /// Cached remote IPv4 endpoint.
        remote_address: SocketAddr;

        /// Returns the local IPv4 address and port, including a port assigned by the OS.
        pub fn addr(&self) SocketAddr {
            let local = &(*self).local_address;
            from_parts(local.ipv4_bits(), local.port())
        }

        /// Returns the remote IPv4 address and port associated with the connection.
        pub fn peer(&self) SocketAddr {
            let remote = &(*self).remote_address;
            from_parts(remote.ipv4_bits(), remote.port())
        }

        /// Writes bytes from the caller's slice and returns the number accepted, which may be less than its length.
        pub fn write(&mut self, buffer: &[u8]) Result<usize, SocketError> {
            if buffer.len() == 0 { return Ok(0); }
            let inner = &mut (*self).__din_package_socket;
            inner.send(buffer)
        }

        /// Reads into the caller's slice and returns the bytes copied. An empty buffer returns zero.
        pub fn read(&mut self, buffer: &mut [u8]) Result<usize, SocketError> {
            let inner = &mut (*self).__din_package_socket;
            inner.receive(buffer)
        }

}

    /// Owns a TCP listening socket and accepts incoming connections.
    pub struct Listener {
        /// Owned native socket storage; the connection/listener closes it on destruction.
        __din_package_socket: PlatformSocket;
        /// Cached local IPv4 endpoint, including any OS-assigned port.
        local_address: SocketAddr;

        /// Binds and listens at the supplied endpoint. Use port zero for an assigned port and None for the system maximum backlog.
        pub fn bind(address: SocketAddr, backlog: Option<i32>) Result<Listener, SocketError> {
            let limit = match backlog {
                Some(value) => { value },
                None => { 2147483647 },
            };
            let inner = match open_listener(1, address.ipv4_bits(), address.port(), limit) {
                Ok(value) => { value },
                Err(error) => { return Err(error); },
            };
            let local = match inner.endpoint(0) {
                Ok(value) => { value },
                Err(error) => { return Err(error); },
            };
            Ok(Listener { __din_package_socket: inner, local_address: local })
        }

        /// Returns the local IPv4 address and port, including a port assigned by the OS.
        pub fn addr(&self) SocketAddr {
            let local = &(*self).local_address;
            from_parts(local.ipv4_bits(), local.port())
        }

        /// Blocks until it can return an owned accepted TCP connection or an error.
        pub fn accept(&mut self) Result<Connection, SocketError> {
            let inner = &mut (*self).__din_package_socket;
            let accepted = match inner.accept() {
                Ok(value) => { value },
                Err(error) => { return Err(error); },
            };
            connection(accepted)
        }

}

    /// Wraps a connected platform socket with its local and peer endpoints.
    fn connection(inner: PlatformSocket) Result<Connection, SocketError> {
        let local = match inner.endpoint(0) {
            Ok(value) => { value },
            Err(error) => { return Err(error); },
        };
        let remote = match inner.endpoint(1) {
            Ok(value) => { value },
            Err(error) => { return Err(error); },
        };
        Ok(Connection { __din_package_socket: inner, local_address: local, remote_address: remote })
    }

    /// Establishes a blocking TCP connection to the supplied endpoint.
    pub fn connect(address: SocketAddr) Result<Connection, SocketError> {
        let inner = match open_connection(1, address.ipv4_bits(), address.port()) {
            Ok(value) => { value },
            Err(error) => { return Err(error); },
        };
        connection(inner)
    }



#(endif)

#(if: target.os == "macos" && target.arch == "aarch64")
    /// Exposes the native socket representation needed by standard-library package code.
    pub fn __din_package_socket(connection: &Connection) u64 {
        let inner = &(*connection).__din_package_socket;
        std::sys::net::socket_descriptor(inner)
    }
#(endif)
