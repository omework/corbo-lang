// SPDX-License-Identifier: MIT OR Apache-2.0
//! Client and server handshake state machines for the blocking P-256 TLS 1.3 profile.

#(if: target.os == "linux" && target.arch == "x86_64" && target.pointer_width == "64" || target.os == "macos" && target.arch == "aarch64" || target.os == "macos" && target.arch == "x86_64" || target.os == "windows" && target.arch == "aarch64" || target.os == "windows" && target.arch == "x86_64")
    use std::net::tcp::Connection;
    use std::crypto::p256::{EphemeralKey, SigningKey, PublicKey};
    use std::crypto::random::fill;
    use std::crypto::x509::{PublicKey as X509PublicKey, valid_dns_name};
    use std::net::tls::keys::{Transcript, Traffic, early_secret, handshake_secret,
        master_secret, traffic_secret, aes128_key, traffic_iv, finished_verify_data, verify_finished};
    use std::net::tls::record::{RecordCipher, HANDSHAKE, APPLICATION_DATA};

    /// Holds the read and write ciphers established by a successful TLS handshake.
    pub struct Session {
        /// Owned inbound record cipher established by the handshake.
        reader: RecordCipher;
        /// Owned outbound record cipher established by the handshake.
        writer: RecordCipher;

        /// Protects and sends an application record on the original TCP connection.
        fn write_application(&mut self, socket: &mut Connection, content: &[u8],
                             fragment: &mut [u8], wire: &mut [u8]) Result<(), HandshakeError> {
            let writer = &mut (*self).writer;
            match writer.send_record(&mut *socket, APPLICATION_DATA, &content[0..content.len()],
                        0, &mut fragment[0..fragment.len()], &mut wire[0..wire.len()]) {
                Ok(()) => {},
                Err(error) => { drop(error); return Err(HandshakeError::Transport); },
            };
            Ok(())
        }

        /// Receives and authenticates an application record, or returns zero on authenticated closure.
        fn read_application(&mut self, socket: &mut Connection, wire: &mut [u8],
                            output: &mut [u8]) Result<u64, HandshakeError> {
            let reader = &mut (*self).reader;
            let capacity = wire.len();
            let space = output.len();
            while true {
                let record = match reader.receive_record(&mut *socket, &mut wire[0..capacity],
                        &mut output[0..space]) {
                    Ok(value) => { value },
                    Err(error) => { drop(error); return Err(HandshakeError::Transport); },
                };
                if record.is_close_notify() { return Ok(0); }
                if record.kind() != APPLICATION_DATA { return Err(HandshakeError::Protocol); }
                let count = record.len();
                if count != 0 { return Ok(count); }
            }
            Err(HandshakeError::Protocol)
        }

        /// Sends the authenticated TLS close_notify alert.
        fn shutdown(&mut self, socket: &mut Connection, fragment: &mut [u8],
                    wire: &mut [u8]) Result<(), HandshakeError> {
            let writer = &mut (*self).writer;
            match writer.close_notify(&mut *socket, &mut fragment[0..fragment.len()],
                      &mut wire[0..wire.len()]) {
                Ok(()) => {},
                Err(error) => { drop(error); return Err(HandshakeError::Transport); },
            };
            Ok(())
        }

}


    /// Constructs a directional record cipher from the corresponding traffic secret.
    fn cipher(secret: &[u8], sending: bool) Result<RecordCipher, HandshakeError> {
        let size = secret.len();
        let key = match aes128_key(&secret[0..size]) {
            Ok(value) => { value },
            Err(error) => { drop(error); return Err(HandshakeError::Crypto); },
        };
        let iv = match traffic_iv(&secret[0..size]) {
            Ok(value) => { value },
            Err(error) => { drop(error); return Err(HandshakeError::Crypto); },
        };
        if sending {
            let writer = RecordCipher::writer(&key, &iv);
            return Ok(writer);
        }
        let reader = RecordCipher::reader(&key, &iv);
        Ok(reader)
    }

    /// Derives the P-256 ECDHE secret from the local key and peer public point.
    fn shared_secret(ephemeral: EphemeralKey, encoded: &[u8]) Result<[u8; 32], HandshakeError> {
        let size = encoded.len();
        let peer = match PublicKey::from_sec1_uncompressed(&encoded[0..size]) {
            Ok(value) => { value },
            Err(error) => { drop(error); return Err(HandshakeError::Authentication); },
        };
        let mut shared: [u8; 32] = [0; 32];
        match ephemeral.agree(&peer, &mut shared) {
            Ok(()) => {},
            Err(error) => { drop(error); return Err(HandshakeError::Crypto); },
        };
        let early = match early_secret() {
            Ok(value) => { value },
            Err(error) => { drop(error); return Err(HandshakeError::Crypto); },
        };
        let secret = match handshake_secret(&early[..], &shared[..]) {
            Ok(value) => { value },
            Err(error) => { drop(error); return Err(HandshakeError::Crypto); },
        };
        Ok(secret)
    }

    /// Derives the application traffic secrets and installs directional record ciphers.
    fn application_session(master: &[u8], hash: &[u8], server: bool) Result<Session, HandshakeError> {
        let client = match traffic_secret(&master[0..32], &hash[0..32], Traffic::ClientApplication) {
            Ok(value) => { value },
            Err(error) => { drop(error); return Err(HandshakeError::Crypto); },
        };
        let peer = match traffic_secret(&master[0..32], &hash[0..32], Traffic::ServerApplication) {
            Ok(value) => { value },
            Err(error) => { drop(error); return Err(HandshakeError::Crypto); },
        };
        if server {
            let reader = match cipher(&client[..], false) {
                Ok(value) => { value },
                Err(error) => { return Err(error); },
            };
            let writer = match cipher(&peer[..], true) {
                Ok(value) => { value },
                Err(error) => { return Err(error); },
            };
            let result = Session { reader: reader, writer: writer };
            return Ok(result);
        }
        let reader = match cipher(&peer[..], false) {
            Ok(value) => { value },
            Err(error) => { return Err(error); },
        };
        let writer = match cipher(&client[..], true) {
            Ok(value) => { value },
            Err(error) => { return Err(error); },
        };
        let result = Session { reader: reader, writer: writer };
        Ok(result)
    }

    /// Builds a Finished message from the transcript and traffic secret.
    fn encode_finished(secret: &[u8], hash: &[u8], message: &mut [u8]) Result<(), HandshakeError> {
        let data = match finished_verify_data(&secret[0..32], &hash[0..32]) {
            Ok(value) => { value },
            Err(error) => { drop(error); return Err(HandshakeError::Crypto); },
        };
        handshake_header(&mut message[0..36], 20, 36);
        place(&mut message[0..36], 4, &data[..]);
        Ok(())
    }

    /// Validates Finished framing and verifies the peer's authentication data.
    fn check_finished(secret: &[u8], hash: &[u8], message: &[u8]) Result<(), HandshakeError> {
        if message.len() != 36 { return Err(HandshakeError::Protocol); }
        let valid = match verify_finished(&secret[0..32], &hash[0..32], &message[4..36]) {
            Ok(value) => { value },
            Err(error) => { drop(error); return Err(HandshakeError::Authentication); },
        };
        if !valid { return Err(HandshakeError::Authentication); }
        Ok(())
    }

    // Compatibility entry point for a caller that provisions the exact leaf and its key.
    /// Runs the client handshake using a configured leaf certificate and public key pin.
    pub fn client_handshake(socket: &mut Connection, pin: &[u8], peer_key: &PublicKey,
                            wire: &mut [u8], fragment: &mut [u8], message: &mut [u8])
                             Result<Session, HandshakeError> {
        let encoded = peer_key.to_sec1_uncompressed();
        let empty: [u8; 0] = [];
        client_negotiate(&mut *socket, &pin[0..pin.len()], &empty[..], &encoded[..], 0,
            &mut wire[0..wire.len()], &mut fragment[0..fragment.len()], &mut message[0..message.len()])
    }

    // Validate the peer against a caller-supplied DER trust anchor and Unix time in seconds.
    /// Runs the client handshake with an explicit trust anchor and DNS identity check.
    pub fn client_handshake_x509(socket: &mut Connection, hostname: &[u8], anchor: &[u8], now: i64,
                                 wire: &mut [u8], fragment: &mut [u8], message: &mut [u8])
                                  Result<Session, HandshakeError> {
        let size = hostname.len();
        if !valid_dns_name(&hostname[0..size]) || anchor.len() == 0 {
            return Err(HandshakeError::Authentication);
        }
        let empty: [u8; 0] = [];
        client_negotiate(&mut *socket, &anchor[0..anchor.len()], &hostname[0..size], &empty[..], now,
            &mut wire[0..wire.len()], &mut fragment[0..fragment.len()], &mut message[0..message.len()])
    }

    /// Validates the presented certificate evidence and returns the server verification key.
    fn authenticate_server(certificate: &[u8], identity: &[u8], hostname: &[u8], pinned_key: &[u8],
                           now: i64) Result<X509PublicKey, HandshakeError> {
        let size = certificate.len();
        let identity_size = identity.len();
        let decoded = match Certificate::from_message(&certificate[0..size]) {
            Ok(value) => { value },
            Err(error) => { return Err(error); },
        };
        if !decoded.supports_server_certificate() { return Err(HandshakeError::Protocol); }
        if pinned_key.len() != 0 {
            let (start, end) = decoded.der_range(0);
            if decoded.count() != 1 || !equal_bytes(&certificate[start..end], &identity[0..identity_size]) {
                return Err(HandshakeError::Authentication);
            }
            let key = match X509PublicKey::from_p256_sec1(&pinned_key[0..65]) {
                Ok(value) => { value },
                Err(error) => { drop(error); return Err(HandshakeError::Authentication); },
            };
            return Ok(key);
        }
        decoded.server_key(&certificate[0..size], &identity[0..identity_size],
                           &hostname[0..hostname.len()], now)
    }

    /// Executes the client-side handshake and installs application keys after verification.
    fn client_negotiate(socket: &mut Connection, identity: &[u8], hostname: &[u8], pinned_key: &[u8], now: i64,
                        wire: &mut [u8], fragment: &mut [u8], message: &mut [u8])
                         Result<Session, HandshakeError> {
        let w = wire.len();
        let f = fragment.len();
        let m = message.len();
        let identity_size = identity.len();
        let host_size = hostname.len();
        let key_size = pinned_key.len();
        if !has_workspace(copy(w), copy(f), copy(m)) || m < 154 + host_size {
            return Err(HandshakeError::BufferTooSmall);
        }
        if key_size != 0 && (identity_size == 0 || identity_size > m - 13) {
            return Err(HandshakeError::BufferTooSmall);
        }
        let mut transcript = Transcript::new();
        let mut random: [u8; 32] = [0; 32];
        match fill(&mut random[..]) {
            Ok(()) => {},
            Err(error) => { drop(error); return Err(HandshakeError::Crypto); },
        };
        let ephemeral = match EphemeralKey::generate() {
            Ok(value) => { value },
            Err(error) => { drop(error); return Err(HandshakeError::Crypto); },
        };
        let public_key = ephemeral.public_key();
        let point = public_key.to_sec1_uncompressed();
        let hello = encode_client_hello(&random[..], &point[..], &hostname[0..host_size], &mut message[0..m]);
        match send_hello(&mut *socket, true, &message[0..hello], &mut wire[0..w]) {
            Ok(()) => {},
            Err(error) => { return Err(error); },
        };
        match append_message(&mut transcript, &message[0..hello]) {
            Ok(()) => {},
            Err(error) => { return Err(error); },
        };

        let reply = match receive_hello(&mut *socket, 2, &mut wire[0..w], &mut message[0..m]) {
            Ok(value) => { value },
            Err(error) => { return Err(error); },
        };
        let share = server_share(&message[0..reply]);
        if share == 0 { return Err(HandshakeError::Protocol); }
        let handshake = match shared_secret(ephemeral, &message[share..share + 65]) {
            Ok(value) => { value },
            Err(error) => { return Err(error); },
        };
        match append_message(&mut transcript, &message[0..reply]) {
            Ok(()) => {},
            Err(error) => { return Err(error); },
        };
        let hello_hash = transcript.digest();
        let client_traffic = match traffic_secret(&handshake[..], &hello_hash[..], Traffic::ClientHandshake) {
            Ok(value) => { value },
            Err(error) => { drop(error); return Err(HandshakeError::Crypto); },
        };
        let server_traffic = match traffic_secret(&handshake[..], &hello_hash[..], Traffic::ServerHandshake) {
            Ok(value) => { value },
            Err(error) => { drop(error); return Err(HandshakeError::Crypto); },
        };
        let master = match master_secret(&handshake[..]) {
            Ok(value) => { value },
            Err(error) => { drop(error); return Err(HandshakeError::Crypto); },
        };
        let mut flight = new_flight();
        let mut reader = match cipher(&server_traffic[..], false) {
            Ok(value) => { value },
            Err(error) => { return Err(error); },
        };
        let mut writer = match cipher(&client_traffic[..], true) {
            Ok(value) => { value },
            Err(error) => { return Err(error); },
        };

        let ee = match receive_handshake_message(&mut *socket, &mut reader, &mut flight, 8, &mut wire[0..w], &mut fragment[0..f], &mut message[0..m]) {
            Ok(value) => { value },
            Err(error) => { return Err(error); },
        };
        if !valid_encrypted_extensions(&message[0..ee], host_size != 0) { return Err(HandshakeError::Protocol); }
        match append_message(&mut transcript, &message[0..ee]) {
            Ok(()) => {},
            Err(error) => { return Err(error); },
        };
        let certificate = match receive_handshake_message(&mut *socket, &mut reader, &mut flight, 11, &mut wire[0..w], &mut fragment[0..f], &mut message[0..m]) {
            Ok(value) => { value },
            Err(error) => { return Err(error); },
        };
        let peer_key = match authenticate_server(&message[0..certificate], &identity[0..identity_size],
                                                 &hostname[0..host_size], &pinned_key[0..key_size], now) {
            Ok(value) => { value },
            Err(error) => { return Err(error); },
        };
        match append_message(&mut transcript, &message[0..certificate]) {
            Ok(()) => {},
            Err(error) => { return Err(error); },
        };
        let cv = match receive_handshake_message(&mut *socket, &mut reader, &mut flight, 15, &mut wire[0..w], &mut fragment[0..f], &mut message[0..m]) {
            Ok(value) => { value },
            Err(error) => { return Err(error); },
        };
        if cv < 9 || get16(&message[0..cv], 4) != 1027 || get16(&message[0..cv], 6) != cv - 8 {
            return Err(HandshakeError::Protocol);
        }
        let cv_hash = transcript.digest();
        let input = certificate_input(&cv_hash[..]);
        let signature_ok = match peer_key.verify_ecdsa_sha256(&input[..], &message[8..cv]) {
            Ok(value) => { value },
            Err(error) => { drop(error); return Err(HandshakeError::Authentication); },
        };
        if !signature_ok { return Err(HandshakeError::Authentication); }
        match append_message(&mut transcript, &message[0..cv]) {
            Ok(()) => {},
            Err(error) => { return Err(error); },
        };
        let server_finished = match receive_handshake_message(&mut *socket, &mut reader, &mut flight, 20, &mut wire[0..w], &mut fragment[0..f], &mut message[0..m]) {
            Ok(value) => { value },
            Err(error) => { return Err(error); },
        };
        if !flight_empty(&flight) { return Err(HandshakeError::Protocol); }
        let before = transcript.digest();
        match check_finished(&server_traffic[..], &before[..], &message[0..server_finished]) {
            Ok(()) => {},
            Err(error) => { return Err(error); },
        };
        match append_message(&mut transcript, &message[0..server_finished]) {
            Ok(()) => {},
            Err(error) => { return Err(error); },
        };
        let app_hash = transcript.digest();
        match encode_finished(&client_traffic[..], &app_hash[..], &mut message[0..m]) {
            Ok(()) => {},
            Err(error) => { return Err(error); },
        };
        match send_handshake_message(&mut *socket, &mut writer, &message[0..36], &mut fragment[0..f], &mut wire[0..w]) {
            Ok(()) => {},
            Err(error) => { return Err(error); },
        };
        match append_message(&mut transcript, &message[0..36]) {
            Ok(()) => {},
            Err(error) => { return Err(error); },
        };
        application_session(&master[..], &app_hash[..], false)
    }
    /// Runs the server handshake with one DER certificate and its signing key.
    pub fn server_handshake(socket: &mut Connection, certificate: &[u8], signing_key: &SigningKey,
                            wire: &mut [u8], fragment: &mut [u8], message: &mut [u8])
                             Result<Session, HandshakeError> {
        server_negotiate(&mut *socket, &certificate[0..certificate.len()], false, &*signing_key,
            &mut wire[0..wire.len()], &mut fragment[0..fragment.len()], &mut message[0..message.len()])
    }

    /// Runs the server handshake with a framed leaf-first certificate list and its signing key.
    pub fn server_handshake_chain(socket: &mut Connection, chain: &[u8], signing_key: &SigningKey,
                                  wire: &mut [u8], fragment: &mut [u8], message: &mut [u8])
                                   Result<Session, HandshakeError> {
        let size = chain.len();
        if !valid_outgoing_chain(&chain[0..size]) { return Err(HandshakeError::Protocol); }
        server_negotiate(&mut *socket, &chain[0..size], true, &*signing_key,
            &mut wire[0..wire.len()], &mut fragment[0..fragment.len()], &mut message[0..message.len()])
    }

    /// Executes the server-side handshake and verifies the client's Finished.
    fn server_negotiate(socket: &mut Connection, certificate: &[u8], is_chain: bool, signing_key: &SigningKey,
                        wire: &mut [u8], fragment: &mut [u8], message: &mut [u8])
                         Result<Session, HandshakeError> {
        let w = wire.len();
        let f = fragment.len();
        let m = message.len();
        let cert_size = certificate.len();
        if !has_workspace(copy(w), copy(f), copy(m)) || cert_size == 0 || cert_size > 16777215 - 9
           || cert_size > m - 13 { return Err(HandshakeError::BufferTooSmall); }
        let mut transcript = Transcript::new();
        let hello = match receive_hello(&mut *socket, 1, &mut wire[0..w], &mut message[0..m]) {
            Ok(value) => { value },
            Err(error) => { return Err(error); },
        };
        let share = client_share(&message[0..hello]);
        if share == 0 { return Err(HandshakeError::Protocol); }
        let session_size = message[38] as usize;
        let mut session: [u8; 32] = [0; 32];
        place(&mut session[..], 0, &message[39..39 + session_size]);
        match append_message(&mut transcript, &message[0..hello]) {
            Ok(()) => {},
            Err(error) => { return Err(error); },
        };

        let mut random: [u8; 32] = [0; 32];
        match fill(&mut random[..]) {
            Ok(()) => {},
            Err(error) => { drop(error); return Err(HandshakeError::Crypto); },
        };
        let ephemeral = match EphemeralKey::generate() {
            Ok(value) => { value },
            Err(error) => { drop(error); return Err(HandshakeError::Crypto); },
        };
        let public_key = ephemeral.public_key();
        let point = public_key.to_sec1_uncompressed();
        let handshake = match shared_secret(ephemeral, &message[share..share + 65]) {
            Ok(value) => { value },
            Err(error) => { return Err(error); },
        };
        let reply = encode_server_hello(&random[..], &point[..], &session[..session_size], &mut message[0..m]);
        match send_hello(&mut *socket, false, &message[0..reply], &mut wire[0..w]) {
            Ok(()) => {},
            Err(error) => { return Err(error); },
        };
        match append_message(&mut transcript, &message[0..reply]) {
            Ok(()) => {},
            Err(error) => { return Err(error); },
        };
        let hello_hash = transcript.digest();
        let client_traffic = match traffic_secret(&handshake[..], &hello_hash[..], Traffic::ClientHandshake) {
            Ok(value) => { value },
            Err(error) => { drop(error); return Err(HandshakeError::Crypto); },
        };
        let server_traffic = match traffic_secret(&handshake[..], &hello_hash[..], Traffic::ServerHandshake) {
            Ok(value) => { value },
            Err(error) => { drop(error); return Err(HandshakeError::Crypto); },
        };
        let master = match master_secret(&handshake[..]) {
            Ok(value) => { value },
            Err(error) => { drop(error); return Err(HandshakeError::Crypto); },
        };
        let mut flight = new_flight();
        let mut reader = match cipher(&client_traffic[..], false) {
            Ok(value) => { value },
            Err(error) => { return Err(error); },
        };
        let mut writer = match cipher(&server_traffic[..], true) {
            Ok(value) => { value },
            Err(error) => { return Err(error); },
        };

        handshake_header(&mut message[0..6], 8, 6);
        put16(&mut message[0..6], 4, 0);
        match send_handshake_message(&mut *socket, &mut writer, &message[0..6], &mut fragment[0..f], &mut wire[0..w]) {
            Ok(()) => {},
            Err(error) => { return Err(error); },
        };
        match append_message(&mut transcript, &message[0..6]) {
            Ok(()) => {},
            Err(error) => { return Err(error); },
        };

        let encoded_certificate: usize = if is_chain {
            encode_certificate_list(&certificate[0..cert_size], &mut message[0..m])
        } else {
            encode_certificate(&certificate[0..cert_size], &mut message[0..m])
        };
        match send_handshake_message(&mut *socket, &mut writer, &message[0..encoded_certificate], &mut fragment[0..f], &mut wire[0..w]) {
            Ok(()) => {},
            Err(error) => { return Err(error); },
        };
        match append_message(&mut transcript, &message[0..encoded_certificate]) {
            Ok(()) => {},
            Err(error) => { return Err(error); },
        };
        let cv_hash = transcript.digest();
        let input = certificate_input(&cv_hash[..]);
        let mut signature: [u8; 72] = [0; 72];
        let signed = match signing_key.sign_sha256(&input[..], &mut signature) {
            Ok(value) => { value },
            Err(error) => { drop(error); return Err(HandshakeError::Crypto); },
        };
        let cv_size = 8 + signed;
        handshake_header(&mut message[0..cv_size], 15, copy(cv_size));
        put16(&mut message[0..cv_size], 4, 1027);
        put16(&mut message[0..cv_size], 6, copy(signed));
        place(&mut message[0..cv_size], 8, &signature[..signed]);
        match send_handshake_message(&mut *socket, &mut writer, &message[0..cv_size], &mut fragment[0..f], &mut wire[0..w]) {
            Ok(()) => {},
            Err(error) => { return Err(error); },
        };
        match append_message(&mut transcript, &message[0..cv_size]) {
            Ok(()) => {},
            Err(error) => { return Err(error); },
        };

        let before = transcript.digest();
        match encode_finished(&server_traffic[..], &before[..], &mut message[0..m]) {
            Ok(()) => {},
            Err(error) => { return Err(error); },
        };
        match send_handshake_message(&mut *socket, &mut writer, &message[0..36], &mut fragment[0..f], &mut wire[0..w]) {
            Ok(()) => {},
            Err(error) => { return Err(error); },
        };
        match append_message(&mut transcript, &message[0..36]) {
            Ok(()) => {},
            Err(error) => { return Err(error); },
        };
        let app_hash = transcript.digest();
        let client_finished = match receive_handshake_message(&mut *socket, &mut reader, &mut flight, 20, &mut wire[0..w], &mut fragment[0..f], &mut message[0..m]) {
            Ok(value) => { value },
            Err(error) => { return Err(error); },
        };
        if !flight_empty(&flight) { return Err(HandshakeError::Protocol); }
        match check_finished(&client_traffic[..], &app_hash[..], &message[0..client_finished]) {
            Ok(()) => {},
            Err(error) => { return Err(error); },
        };
        match append_message(&mut transcript, &message[0..client_finished]) {
            Ok(()) => {},
            Err(error) => { return Err(error); },
        };
        application_session(&master[..], &app_hash[..], true)
    }
#(endif)
