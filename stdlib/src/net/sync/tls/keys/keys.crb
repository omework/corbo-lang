//! TLS 1.3 SHA-256 transcript and key schedule for TLS_AES_128_GCM_SHA256.

use std::crypto::sha256::{digest, hkdf_expand, hkdf_extract, hmac, Sha256};

/// Reports an invalid key schedule input, hash failure or output length error.
pub enum KeyError {
    /// The TLS HKDF label exceeds its encoded length limit.
    InvalidLabel,
    /// The TLS HKDF context exceeds its encoded length limit.
    InvalidContext,
    /// The supplied TLS secret has an invalid size.
    InvalidSecret,
    /// Requested output exceeds the derivation's algorithmic limit.
    OutputTooLong,
    /// The underlying transcript/HMAC operation failed.
    HashFailed,
}

/// Selects the role and handshake or application phase of a traffic secret.
pub enum Traffic {
    /// Selects client handshake traffic secrets.
    ClientHandshake,
    /// Selects server handshake traffic secrets.
    ServerHandshake,
    /// Selects client application traffic secrets.
    ClientApplication,
    /// Selects server application traffic secrets.
    ServerApplication,
}

/// Accumulates the ordered handshake bytes in a streaming SHA-256 state.
pub struct Transcript {
    /// Streaming handshake transcript hash; record headers are not appended.
    hash: Sha256,
}

impl Transcript {
    /// Starts an empty handshake transcript.
    fn new() -> Transcript {
        let hash = Sha256::new();
        Transcript { hash: hash }
    }

    // Hash the encoded handshake bytes, including handshake headers.
    // The caller supplies fragments in wire order without record headers.
    /// Adds handshake bytes in protocol order without record headers.
    fn append(&mut self, message: &[u8]) -> Result<(), KeyError> {
        let hash = &mut (*self).hash;
        let length = message.len();
        match hash.update(&message[0..length]) {
            Ok(()) => { Ok(()) },
            Err(error) => { drop(error); Err(KeyError.HashFailed) },
        }
    }

    /// Returns a snapshot of the current transcript hash.
    fn digest(&self) -> [u8; 32] {
        let hash = &(*self).hash;
        hash.snapshot()
    }
}

/// Extracts the low byte of a bounded label or output length.
fn octet(value: usize) -> u8 {
    let mut word = value;
    let mut byte: u8 = 0;
    let mut bit: usize = 0;
    while bit < 8 {
        let low: u8 = if (word & 1) == 0 { 0 } else { 1 };
        byte = byte | (low << bit);
        word = word >> 1;
        bit = bit + 1;
    }
    byte
}

/// Derives output using the TLS 1.3 label prefix and serialized length and context.
pub fn hkdf_expand_label(secret: &[u8], label: &[u8], context: &[u8],
                         output: &mut [u8]) -> Result<(), KeyError> {
    let label_size = label.len();
    let context_size = context.len();
    let output_size = output.len();
    if secret.len() != 32 { return Err(KeyError.InvalidSecret); }
    if label_size == 0 || label_size > 249 { return Err(KeyError.InvalidLabel); }
    if context_size > 255 { return Err(KeyError.InvalidContext); }
    if output_size > 8160 { return Err(KeyError.OutputTooLong); }

    let prefix: [u8; 6] = [116, 108, 115, 49, 51, 32]; // "tls13 "
    let mut info: [u8; 514] = [0; 514];
    info[0] = octet(output_size >> 8);
    info[1] = octet(copy(output_size));
    info[2] = octet(6 + label_size);
    let mut i: usize = 0;
    while i < 6 {
        info[3 + i] = prefix[i];
        i = i + 1;
    }
    i = 0;
    while i < label_size {
        info[9 + i] = label[i];
        i = i + 1;
    }
    info[9 + label_size] = octet(copy(context_size));
    i = 0;
    while i < context_size {
        info[10 + label_size + i] = context[i];
        i = i + 1;
    }
    match hkdf_expand(&secret[0..32], &info[..10 + label_size + context_size], &mut output[0..output_size]) {
        Ok(()) => { Ok(()) },
        Err(error) => { drop(error); Err(KeyError.HashFailed) },
    }
}

/// Derives a fixed 32-byte HKDF output with a TLS label.
fn expand_32(secret: &[u8], label: &[u8], context: &[u8]) -> Result<[u8; 32], KeyError> {
    let mut output: [u8; 32] = [0; 32];
    let size = label.len();
    let context_size = context.len();
    let key_size = secret.len();
    match hkdf_expand_label(&secret[0..key_size], &label[0..size], &context[0..context_size], &mut output[..]) {
        Ok(()) => { Ok(output) },
        Err(error) => { Err(error) },
    }
}

/// Computes the HKDF extraction step used by the TLS key schedule.
fn extract(salt: &[u8], input: &[u8]) -> Result<[u8; 32], KeyError> {
    let salt_size = salt.len();
    let size = input.len();
    match hkdf_extract(&salt[0..salt_size], &input[0..size]) {
        Ok(value) => { Ok(value) },
        Err(error) => { drop(error); Err(KeyError.HashFailed) },
    }
}

// The initial profile does not negotiate a PSK.
/// Derives the initial TLS early secret without a configured PSK.
pub fn early_secret() -> Result<[u8; 32], KeyError> {
    let zeros: [u8; 32] = [0; 32];
    extract(&zeros[..], &zeros[..])
}

/// Derives a 32-byte secret from the given label and transcript hash.
pub fn derive_secret(secret: &[u8], label: &[u8], transcript_hash: &[u8]) -> Result<[u8; 32], KeyError> {
    if transcript_hash.len() != 32 { return Err(KeyError.InvalidContext); }
    let label_size = label.len();
    let key_size = secret.len();
    expand_32(&secret[0..key_size], &label[0..label_size], &transcript_hash[0..32])
}

/// Derives the intermediate secret used as salt for the next extraction step.
pub fn derived_secret(secret: &[u8]) -> Result<[u8; 32], KeyError> {
    let label: [u8; 7] = [100, 101, 114, 105, 118, 101, 100]; // "derived"
    let empty: [u8; 0] = [];
    let empty_hash = match digest(&empty[..]) {
        Ok(value) => { value },
        Err(error) => { drop(error); return Err(KeyError.HashFailed); },
    };
    let size = secret.len();
    derive_secret(&secret[0..size], &label[..], &empty_hash[..])
}

/// Mixes the ECDHE shared secret into the key schedule.
pub fn handshake_secret(early: &[u8], shared: &[u8]) -> Result<[u8; 32], KeyError> {
    if shared.len() != 32 { return Err(KeyError.InvalidSecret); }
    let size = early.len();
    let salt = match derived_secret(&early[0..size]) {
        Ok(value) => { value },
        Err(error) => { return Err(error); },
    };
    extract(&salt[..], &shared[0..32])
}

/// Derives the master secret for application traffic and subsequent derivations.
pub fn master_secret(handshake: &[u8]) -> Result<[u8; 32], KeyError> {
    let zeros: [u8; 32] = [0; 32];
    let size = handshake.len();
    let salt = match derived_secret(&handshake[0..size]) {
        Ok(value) => { value },
        Err(error) => { return Err(error); },
    };
    extract(&salt[..], &zeros[..])
}

/// Derives the requested client or server traffic secret for the selected phase.
pub fn traffic_secret(secret: &[u8], transcript_hash: &[u8], traffic: Traffic) -> Result<[u8; 32], KeyError> {
    let size = secret.len();
    let hash_size = transcript_hash.len();
    let mut label: [u8; 12] = [99, 32, 104, 115, 32, 116, 114, 97, 102, 102, 105, 99]; // "c hs traffic"
    match traffic {
        Traffic.ClientHandshake => {},
        Traffic.ServerHandshake => { label[0] = 115; },
        Traffic.ClientApplication => { label[2] = 97; label[3] = 112; },
        Traffic.ServerApplication => { label[0] = 115; label[2] = 97; label[3] = 112; },
    };
    derive_secret(&secret[0..size], &label[..], &transcript_hash[0..hash_size])
}

/// Derives the 16-byte record encryption key from a traffic secret.
pub fn aes128_key(traffic: &[u8]) -> Result<[u8; 16], KeyError> {
    let label: [u8; 3] = [107, 101, 121]; // "key"
    let empty: [u8; 0] = [];
    let size = traffic.len();
    let mut key: [u8; 16] = [0; 16];
    match hkdf_expand_label(&traffic[0..size], &label[..], &empty[..], &mut key[..]) {
        Ok(()) => { Ok(key) },
        Err(error) => { Err(error) },
    }
}

/// Derives the 12-byte static record IV from a traffic secret.
pub fn traffic_iv(traffic: &[u8]) -> Result<[u8; 12], KeyError> {
    let label: [u8; 2] = [105, 118]; // "iv"
    let empty: [u8; 0] = [];
    let size = traffic.len();
    let mut iv: [u8; 12] = [0; 12];
    match hkdf_expand_label(&traffic[0..size], &label[..], &empty[..], &mut iv[..]) {
        Ok(()) => { Ok(iv) },
        Err(error) => { Err(error) },
    }
}

/// Derives the key for Finished authentication.
pub fn finished_key(handshake_traffic: &[u8]) -> Result<[u8; 32], KeyError> {
    let label: [u8; 8] = [102, 105, 110, 105, 115, 104, 101, 100]; // "finished"
    let empty: [u8; 0] = [];
    let size = handshake_traffic.len();
    expand_32(&handshake_traffic[0..size], &label[..], &empty[..])
}

/// Computes Finished verify_data over the transcript before Finished.
pub fn finished_verify_data(handshake_traffic: &[u8], transcript_hash: &[u8]) -> Result<[u8; 32], KeyError> {
    if transcript_hash.len() != 32 { return Err(KeyError.InvalidContext); }
    let size = handshake_traffic.len();
    let key = match finished_key(&handshake_traffic[0..size]) {
        Ok(value) => { value },
        Err(error) => { return Err(error); },
    };
    match hmac(&key[..], &transcript_hash[0..32]) {
        Ok(value) => { Ok(value) },
        Err(error) => { drop(error); Err(KeyError.HashFailed) },
    }
}

/// Checks received verify_data against the expected Finished authentication value.
pub fn verify_finished(handshake_traffic: &[u8], transcript_hash: &[u8], received: &[u8]) -> Result<bool, KeyError> {
    if received.len() != 32 { return Ok(false); }
    let size = handshake_traffic.len();
    let hash_size = transcript_hash.len();
    let expected = match finished_verify_data(&handshake_traffic[0..size], &transcript_hash[0..hash_size]) {
        Ok(value) => { value },
        Err(error) => { return Err(error); },
    };
    let mut differences: u8 = 0;
    let mut i: usize = 0;
    while i < 32 {
        differences = differences | (expected[i] ^ received[i]);
        i = i + 1;
    }
    Ok(differences == 0)
}
