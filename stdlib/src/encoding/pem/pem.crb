//! Labelled PEM encoding and decoding with caller-owned buffers.

use std::encoding::base64::{decode_wrapped, encode as encode_base64, Error as Base64Error};
use std::encoding::der::bytes_equal;

/// Reports a malformed PEM envelope, invalid Base64, or an undersized output buffer.
pub enum Error {
    /// The PEM/DER container is malformed or uses an unsupported envelope.
    InvalidEnvelope;
    /// The PEM body is not valid Base64.
    InvalidBase64;
    /// The caller-provided output buffer cannot hold the result.
    BufferTooSmall;
}

/// Recognizes space, tab, carriage return and line feed in the envelope.
fn whitespace(byte: u8) bool {
    byte == 9 || byte == 10 || byte == 13 || byte == 32
}

/// Checks a marker prefix, its exact label and its closing dashes at a given offset.
fn boundary(input: &[u8], at: usize, prefix: &[u8], label: &[u8]) usize {
    let size = input.len();
    let prefix_size = prefix.len();
    let label_size = label.len();
    let dash: [u8; 5] = [45; 5];
    let length = prefix_size + label_size + 5;
    if size - at < length { return 0; }
    let name = at + prefix_size;
    let end = name + label_size;
    if !bytes_equal(&input[at..name], &prefix[0..prefix_size])
       || !bytes_equal(&input[name..end], &label[0..label_size])
       || !bytes_equal(&input[end..end + 5], &dash[..]) { return 0; }
    end + 5
}

// Read one labelled block. The body is decoded into caller-owned storage.
/// Decodes one nonempty PEM block with the expected label and returns the DER byte count.
pub fn decode(input: &[u8], label: &[u8], output: &mut [u8]) Result<usize, Error> {
    let size = input.len();
    let label_size = label.len();
    if label_size == 0 || label_size > 64 { return Err(Error.InvalidEnvelope); }
    let begin: [u8; 11] = [45,45,45,45,45,66,69,71,73,78,32]; // "-----BEGIN "
    let close: [u8; 9] = [45,45,45,45,45,69,78,68,32]; // "-----END "
    let mut cursor: usize = 0;
    while cursor < size && whitespace(input[cursor]) { cursor = cursor + 1; }
    let mut start = boundary(&input[0..size], cursor, &begin[..], &label[0..label_size]);
    if start == 0 || start == size { return Err(Error.InvalidEnvelope); }
    if input[start] == 13 {
        start = start + 1;
        if start < size && input[start] == 10 { start = start + 1; }
    } else if input[start] == 10 {
        start = start + 1;
    } else { return Err(Error.InvalidEnvelope); }
    let mut end = copy(start);
    while end < size && input[end] != 45 { end = end + 1; }
    if end == start || end == size || (input[end - 1] != 10 && input[end - 1] != 13) {
        return Err(Error.InvalidEnvelope);
    }
    cursor = boundary(&input[0..size], copy(end), &close[..], &label[0..label_size]);
    if cursor == 0 { return Err(Error.InvalidEnvelope); }
    while cursor < size && whitespace(input[cursor]) { cursor = cursor + 1; }
    if cursor != size { return Err(Error.InvalidEnvelope); }

    let capacity = output.len();
    match decode_wrapped(&input[start..end], &mut output[0..capacity]) {
        Ok(length) => {
            if length == 0 { return Err(Error.InvalidEnvelope); }
            Ok(length)
        },
        Err(error) => {
            match error {
                Base64Error.BufferTooSmall => { Err(Error.BufferTooSmall) },
                Base64Error.InvalidLength => { Err(Error.InvalidBase64) },
                Base64Error.InvalidCharacter => { Err(Error.InvalidBase64) },
                Base64Error.InvalidPadding => { Err(Error.InvalidBase64) },
            }
        },
    }
}

/// Checks the supported PEM label spelling and prevents delimiter injection.
fn valid_label(label: &[u8]) bool {
    let size = label.len();
    if size == 0 || size > 64 { return false; }
    let mut previous_separator = true;
    let mut i: usize = 0;
    while i < size {
        let byte = label[i];
        let separator = byte == 32 || byte == 45;
        if separator {
            if previous_separator { return false; }
        } else if (byte < 65 || byte > 90) && (byte < 48 || byte > 57) { return false; }
        previous_separator = separator;
        i = i + 1;
    }
    !previous_separator
}

/// Writes a pre-sized PEM boundary with its terminating line feed.
fn write_boundary(prefix: &[u8], label: &[u8], output: &mut [u8]) {
    let prefix_size = prefix.len();
    let label_size = label.len();
    let mut i: usize = 0;
    while i < prefix_size {
        output[i] = prefix[i];
        i = i + 1;
    }
    i = 0;
    while i < label_size {
        output[prefix_size + i] = label[i];
        i = i + 1;
    }
    i = 0;
    while i < 5 {
        output[prefix_size + label_size + i] = 45;
        i = i + 1;
    }
    output[prefix_size + label_size + 5] = 10;
}

/// Writes one PEM block with 64 Base64 characters per full line and returns the bytes written.
/// The input must be nonempty. Labels use uppercase ASCII letters and digits with single spaces or hyphens between groups.
/// Invalid input or insufficient capacity leaves the output unchanged.
pub fn encode(input: &[u8], label: &[u8], output: &mut [u8]) Result<usize, Error> {
    let size = input.len();
    let label_size = label.len();
    if size == 0 || !valid_label(&label[0..label_size]) { return Err(Error.InvalidEnvelope); }

    let begin: [u8; 11] = [45,45,45,45,45,66,69,71,73,78,32]; // "-----BEGIN "
    let close: [u8; 9] = [45,45,45,45,45,69,78,68,32]; // "-----END "
    let first = 11 + label_size + 6;
    let last = 9 + label_size + 6;
    let capacity = output.len();
    let lines = (size - 1) / 48 + 1;
    let groups = (size - 1) / 3 + 1;
    let envelope = first + last;
    if capacity < envelope || lines > capacity - envelope || groups > (capacity - envelope - lines) / 4 {
        return Err(Error.BufferTooSmall);
    }

    write_boundary(&begin[..], &label[0..label_size], &mut output[0..first]);
    let mut read: usize = 0;
    let mut written = first;
    while read < size {
        let available = size - read;
        let chunk: usize = if available < 48 { available } else { 48 };
        let width = ((chunk - 1) / 3 + 1) * 4;
        match encode_base64(&input[read..read + chunk], &mut output[written..written + width]) {
            Ok(length) => { drop(length); },
            Err(error) => { drop(error); return Err(Error.BufferTooSmall); },
        };
        read = read + chunk;
        written = written + width;
        output[written] = 10;
        written = written + 1;
    }
    write_boundary(&close[..], &label[0..label_size], &mut output[written..written + last]);
    Ok(written + last)
}
