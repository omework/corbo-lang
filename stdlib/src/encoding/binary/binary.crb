#(if: target.arch == "aarch64")
/// Reinterprets i32 as u32 without arithmetic conversion or alignment assumptions.
fn i32_bits(value: i32) u32 {
    let mut result: u32 = 0;
    @unchecked {
        let source = addr(&value);
        let destination = addr(&mut result);
        @asm {

            mov x0, ${source}
            mov x1, ${destination}
            ldr w2, [x0]
            str w2, [x1]

        }
    }
    result
}
#(endif)

#(if: target.arch == "x86_64")
/// Reinterprets i32 as u32 without arithmetic conversion or alignment assumptions.
fn i32_bits(value: i32) u32 {
    let mut result: u32 = 0;
    @unchecked {
        let source = addr(&value);
        let destination = addr(&mut result);
        @asm {

            mov rax, ${source}
            mov rcx, ${destination}
            mov edx, DWORD PTR [rax]
            mov DWORD PTR [rcx], edx

        }
    }
    result
}
#(endif)

#(if: target.arch == "aarch64")
/// Reinterprets u32 as i32 without arithmetic conversion or alignment assumptions.
fn i32_value(value: u32) i32 {
    let mut result: i32 = 0;
    @unchecked {
        let source = addr(&value);
        let destination = addr(&mut result);
        @asm {

            mov x0, ${source}
            mov x1, ${destination}
            ldr w2, [x0]
            str w2, [x1]

        }
    }
    result
}
#(endif)

#(if: target.arch == "x86_64")
/// Reinterprets u32 as i32 without arithmetic conversion or alignment assumptions.
fn i32_value(value: u32) i32 {
    let mut result: i32 = 0;
    @unchecked {
        let source = addr(&value);
        let destination = addr(&mut result);
        @asm {

            mov rax, ${source}
            mov rcx, ${destination}
            mov edx, DWORD PTR [rax]
            mov DWORD PTR [rcx], edx

        }
    }
    result
}
#(endif)

/// Reads the 4-byte i32 representation in le order.
pub fn read_i32_le(input: &[u8]) Result<i32, Error> {
    let bits = read_u32_le(input)?;
    Ok(i32_value(bits))
}
/// Writes the 4-byte i32 representation in le order.
pub fn write_i32_le(value: i32, output: &mut [u8]) Result<usize, Error> {
    write_u32_le(i32_bits(value), output)
}

/// Reads the 4-byte i32 representation in be order.
pub fn read_i32_be(input: &[u8]) Result<i32, Error> {
    let bits = read_u32_be(input)?;
    Ok(i32_value(bits))
}
/// Writes the 4-byte i32 representation in be order.
pub fn write_i32_be(value: i32, output: &mut [u8]) Result<usize, Error> {
    write_u32_be(i32_bits(value), output)
}

