//! Explicit byte-order conversion of primitive values using caller-owned slices.
//! Operations use the first width bytes and leave trailing bytes unchanged.
//! Float encodings preserve IEEE-754 bits, including signed zero and NaN payloads.

/// Reports insufficient bytes or a noncanonical boolean encoding.
pub enum Error {
    /// The input or output slice contains fewer than the required bytes.
    BufferTooSmall;
    /// A boolean byte is neither zero nor one.
    InvalidBoolean;
}

/// Reads 1 bytes as u8.
pub fn read_u8(input: &[u8]) Result<u8, Error> {
    if input.len() < 1 { return Err(Error::BufferTooSmall); }

    Ok(input[0])
}

/// Writes 1 bytes of u8; short-buffer errors leave output unchanged.
pub fn write_u8(value: u8, output: &mut [u8]) Result<usize, Error> {
    if output.len() < 1 { return Err(Error::BufferTooSmall); }

    output[0] = value;

    Ok(1)
}

/// Reads 2 bytes as u16 in le order.
pub fn read_u16_le(input: &[u8]) Result<u16, Error> {
    if input.len() < 2 { return Err(Error::BufferTooSmall); }

    let mut value: u16 = 0;
    let mut i: usize = 0;
    while i < 2 {

        let shift: usize = i * 8;
        let widened = input[i] as u16;
        value |= widened << shift;
        i += 1;
    }
    Ok(value)
}

/// Writes 2 bytes of u16; short-buffer errors leave output unchanged.
pub fn write_u16_le(value: u16, output: &mut [u8]) Result<usize, Error> {
    if output.len() < 2 { return Err(Error::BufferTooSmall); }

    let mut i: usize = 0;
    while i < 2 {

        let shift: usize = i * 8;
        let byte: u16 = (copy(value) >> shift) & 255;
        let narrowed = match u8::try_from(byte) { Ok(v) => { v }, Err(e) => { drop(e); return Err(Error::BufferTooSmall); }, };
        output[i] = narrowed;
        i += 1;
    }

    Ok(2)
}

/// Reads 2 bytes as u16 in be order.
pub fn read_u16_be(input: &[u8]) Result<u16, Error> {
    if input.len() < 2 { return Err(Error::BufferTooSmall); }

    let mut value: u16 = 0;
    let mut i: usize = 0;
    while i < 2 {

        let shift: usize = (2 - 1 - i) * 8;
        let widened = input[i] as u16;
        value |= widened << shift;
        i += 1;
    }
    Ok(value)
}

/// Writes 2 bytes of u16; short-buffer errors leave output unchanged.
pub fn write_u16_be(value: u16, output: &mut [u8]) Result<usize, Error> {
    if output.len() < 2 { return Err(Error::BufferTooSmall); }

    let mut i: usize = 0;
    while i < 2 {

        let shift: usize = (2 - 1 - i) * 8;
        let byte: u16 = (copy(value) >> shift) & 255;
        let narrowed = match u8::try_from(byte) { Ok(v) => { v }, Err(e) => { drop(e); return Err(Error::BufferTooSmall); }, };
        output[i] = narrowed;
        i += 1;
    }

    Ok(2)
}

