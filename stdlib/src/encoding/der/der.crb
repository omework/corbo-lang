//! Bounds-checked DER framing and validation of common ASN.1 values.

// Offsets into a caller-owned DER slice. End zero denotes malformed input.
/// Holds the content and end offsets of a DER element. End zero denotes malformed input.
pub struct Der {
    /// Start of the parsed DER value body.
    pub body: u64;
    /// Exclusive end of the parsed DER value.
    pub end: u64;
}

/// Returns the sentinel for a malformed or missing DER element.
pub fn invalid_der() Der { Der { body: 0, end: 0 } }

/// Parses one element with the expected tag and a canonical definite length within the supplied limit.
pub fn der(input: &[u8], at: u64, limit: u64, tag: u8) Der {
    if limit > input.len() as u64 || at > limit || limit - at < 2 || input[at] != tag { return invalid_der(); }
    let mut body = at + 2;
    let mut length = input[at + 1] as u64;
    if length >= 128 {
        let width = length - 128;
        if width == 0 || width > 4 || width > limit - body || input[body] == 0 {
            return invalid_der();
        }
        length = 0;
        let end = body + width;
        while body < end {
            length = length * 256 + (input[body] as u64);
            body = body + 1;
        }
        if length < 128 { return invalid_der(); }
    }
    if length > limit - body { return invalid_der(); }
    let end = body + length;
    Der { body: body, end: end }
}

/// Compares the length and contents of two byte slices.
pub fn bytes_equal(a: &[u8], b: &[u8]) bool {
    let length = a.len();
    if length != b.len() { return false; }
    let mut i: usize = 0;
    while i < length {
        if a[i] != b[i] { return false; }
        i = i + 1;
    }
    true
}

/// Checks that a byte range is a minimally encoded nonnegative DER integer.
pub fn uint_valid(input: &[u8], start: u64, end: u64) bool {
    if start >= end || end > input.len() as u64 || input[start] >= 128 { return false; }
    if end - start > 1 && input[start] == 0 && input[start + 1] < 128 { return false; }
    true
}

/// Checks the base-128 component encoding and termination of a DER object identifier.
pub fn oid_valid(input: &[u8], start: u64, end: u64) bool {
    if start >= end || end > input.len() as u64 { return false; }
    let mut i = start;
    let mut first = true;
    while i < end {
        let byte = input[i];
        if first && byte == 128 { return false; }
        first = byte < 128;
        i = i + 1;
    }
    first
}

/// Returns the width of a DER tag and definite length, or zero when the length exceeds 32 bits.
pub fn der_header_size(length: u64) u64 {
    if length < 128 { return 2; }
    if length <= 255 { return 3; }
    if length <= 65535 { return 4; }
    if length <= 16777215 { return 5; }
    if length <= 4294967295 { return 6; }
    0
}

/// Returns the octet at the supplied position of a word.
pub fn der_octet(word: u64, shift: u64) u8 {
    let mut value = word >> shift;
    let mut byte: u8 = 0;
    let mut bit: u64 = 0;
    while bit < 8 {
        let low: u8 = if (value & 1) == 0 { 0 } else { 1 };
        byte = byte | (low << bit);
        value = value >> 1;
        bit = bit + 1;
    }
    byte
}

/// Writes a DER header and returns its width, or zero when the header cannot fit.
pub fn write_der_header(tag: u8, length: u64, output: &mut [u8]) u64 {
    let width = der_header_size(copy(length));
    if width == 0 || width > output.len() as u64 { return 0; }
    output[0] = tag;
    if width == 2 {
        output[1] = der_octet(length, 0);
    } else {
        output[1] = 128 + der_octet(width - 2, 0);
        let mut at: u64 = 2;
        while at < width {
            output[at] = der_octet(copy(length), (width - at - 1) * 8);
            at = at + 1;
        }
    }
    width
}

/// Copies a byte slice into caller-owned storage, returning zero on insufficient capacity.
pub fn copy_der(input: &[u8], output: &mut [u8]) usize {
    let length = input.len();
    if length > output.len() { return 0; }
    let mut at: usize = 0;
    while at < length {
        output[at] = input[at];
        at = at + 1;
    }
    length
}
