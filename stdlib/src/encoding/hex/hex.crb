//! Hexadecimal encoding and decoding into caller-owned buffers.

/// Reports an undersized output, an odd input length, or a non-hexadecimal digit.
pub enum Error {
    /// The caller-provided output buffer cannot hold the result.
    BufferTooSmall;
    /// The input length is incompatible with this encoding.
    InvalidLength;
    /// An input byte is outside the encoding alphabet.
    InvalidCharacter;
}

/// Maps a nibble to its lowercase ASCII hexadecimal digit.
fn digit(value: u8) u8 {
    if value < 10 { return value + 48; }
    value - 10 + 97
}

/// Decodes either case of an ASCII hexadecimal digit and returns 16 for invalid input.
fn nibble(byte: u8) u8 {
    if byte >= 48 && byte <= 57 { return byte - 48; }
    if byte >= 97 && byte <= 102 { return byte - 97 + 10; }
    if byte >= 65 && byte <= 70 { return byte - 65 + 10; }
    16
}

/// Writes lowercase hexadecimal and returns the bytes written. Errors leave the output unchanged.
pub fn encode(input: &[u8], output: &mut [u8]) Result<usize, Error> {
    let size = input.len();
    if size > output.len() / 2 { return Err(Error.BufferTooSmall); }
    let mut i: usize = 0;
    while i < size {
        output[2 * i] = digit(input[i] >> 4);
        output[2 * i + 1] = digit(input[i] & 15);
        i = i + 1;
    }
    Ok(size * 2)
}

/// Decodes an even number of hexadecimal digits in either case. Errors leave the output unchanged.
pub fn decode(input: &[u8], output: &mut [u8]) Result<usize, Error> {
    let size = input.len();
    if size % 2 != 0 { return Err(Error.InvalidLength); }
    let mut i: usize = 0;
    while i < size {
        if nibble(input[i]) == 16 { return Err(Error.InvalidCharacter); }
        i = i + 1;
    }
    let written = size / 2;
    if written > output.len() { return Err(Error.BufferTooSmall); }
    i = 0;
    while i < written {
        output[i] = (nibble(input[2 * i]) << 4) | nibble(input[2 * i + 1]);
        i = i + 1;
    }
    Ok(written)
}
