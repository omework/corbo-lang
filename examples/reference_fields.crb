enum View { Item { data: &i32 } }

fn use_view(view: &View) {
    match &view {
        View.Item { data: value } => { print(value); }
    }
}

fn main() {
    let mut data_pool = Pool<i32>::new(1);
    let mut view_pool = Pool<View>::new(1);
    let data = data_pool.new(42);
    let target = data.vref();
    let view = view_pool.new(View.Item { data: target });
    use_view(view.vref());
    drop(data); // L'emprunt stocké ne doit plus servir.
}
