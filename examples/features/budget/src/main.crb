use std::Vector;

fn main() {
    let count: i64 = 1000;

    #(stack_region: max_size=64K, count=1) {
        let mut numbers: Vector<i64> = Vector::new();
        let mut number: i64 = 0;
        while number < count {
            numbers.push(number);
            number += 1;
        }
        print(numbers.len());
    }
}
