struct Token {
    kind: u8
}

fn sum(values: &[i64]) -> i64 {
    let mut index: usize = 0;
    let mut result: i64 = 0;
    while index < values.len() {
        result += values[index];
        index += 1;
    }
    result
}

fn main() {
    let mut values: [i64; 3] = [10, 20, 30];
    values[1] = 2;
    let middle = &mut values[1];
    *middle += 1;
    print(sum(&values[..]));

    let tokens: [Token; 2] = [Token { kind: 7 }; 2];
    print(tokens[1].kind);
}
