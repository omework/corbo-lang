use std::Vector;

fn main() {
    let mut vectors = Pool<Vector<i64>>::new(1);
    let mut values = vectors.new();
    values.push(10);
    values.push(20);
    print(values[0]);
    match values.pop() {
        Some(value) => { print(value); },
        None => { print(0); },
    }
    print(values.len());
}
