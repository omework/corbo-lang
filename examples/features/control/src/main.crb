fn main() {
    let selected = if true { 40 } else { 0 };
    let mut total: i64 = 0;
    let mut index: i64 = 0;

    while index < 4 {
        index += 1;
        if index == 2 { continue; }
        total += index;
    }

    let result = loop {
        break selected + 2;
    };

    print(total);
    print(result);
}
