enum Reading {
    Value(i64);
    Missing;
}

fn main() {
    let reading = Reading::Value(42);
    let saved = reading;
    print(reading == saved);

    if let Reading::Value(value) = reading {
        print(value);
    } else {
        print(0);
    }

    match saved {
        Reading::Value(value) => { print(value); },
        Reading::Missing => { print(0); },
    }
}
