use std::HashMap;

fn main() {
    let mut values = HashMap<i64, i64>::new();
    let key: i64 = 7;
    drop(values.insert(copy(key), 42));
    match values.get(&key) {
        Some(value) => { print(*value); },
        None => { print(0); },
    }
    match values.remove(&key) {
        Some(value) => { print(value); },
        None => { print(0); },
    }
}
