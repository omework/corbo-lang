struct Counter {
    value: i64
}

impl Counter {
    const STEP: i64 = 1;

    fn increment(&mut self) {
        let value = &mut (*self).value;
        *value += Counter::STEP;
    }

    fn finish(self: Counter) -> i64 {
        self.value
    }
}

fn main() {
    let mut counter = Counter { value: 41 };
    counter.increment();
    print(counter.finish());
}
