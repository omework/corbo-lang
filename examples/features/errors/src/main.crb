fn checked(value: i64) -> Result<i64, bool> {
    if value < 0 { return Err(false); }
    Ok(value)
}

fn calculate() -> Result<i64, bool> {
    let value = checked(21)?;
    Ok(value * 2)
}

fn main() {
    match calculate() {
        Ok(value) => { print(value); },
        Err(error) => { print(error); },
    }
}
