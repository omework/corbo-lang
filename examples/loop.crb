fn main() {
    let mut memory = pool<i32>(1);
    let mut controls = pool<i32>(1);
    let mut state = controls.new(0);

    loop {
        let mut temporary = memory.new(42);
        address(temporary);
        print(*temporary);

        if *state == 1 {
            break; // Détruit temporary avant de sortir de la boucle.
        }

        state.set(1);
    } // Détruit temporary avant l'itération suivante.

    // Les deux itérations ont utilisé le même slot.
    print(*state); // La valeur du parent reste vivante.
}
