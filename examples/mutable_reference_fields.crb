enum Writer { Bound { data: &mut i32 } }
fn make(writers: &mut Pool<Writer>, data: &mut i32) -> A<Writer> {
    writers.new(Writer.Bound { data: data })
}
fn main() {
    let mut memory = Pool<i32>::new(1);
    let mut writers = Pool<Writer>::new(1);
    let mut nombre = memory.new(10);
    let writer = make(&mut writers, nombre.mut_vref());
    print(writer);
    nombre = 20;
    print(*nombre);
}
