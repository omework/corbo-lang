fn main() {
    let mut memory = pool<i32>(1);
    let mut controls = pool<i32>(1);
    let mut state = controls.new(0);

    while *state < 2 {
        let mut temporary = memory.new(42);
        address(temporary);
        if *state == 0 {
            state.set(1);
            continue; // Nettoie temporary, puis réévalue *state < 2.
        }
        print(*temporary);
        state.set(2);
    }
    print(*state);
}
