fn read(data: &i32) -> i32 {
    return *data;
}

fn main() {
    let mut memory = Pool<i32>::new(1);
    let mut nombre = memory.new(10);
    address(nombre);

    nombre = 20;
    nombre.set(30);
    address(nombre);

    let mut vue = &mut nombre;
    *vue = 40;
    print(*vue);

    let copie = read(&nombre);
    print(copie);
    drop(nombre);
}
