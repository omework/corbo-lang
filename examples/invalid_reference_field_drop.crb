enum View { Item { data: &i32 } }
fn use_view(view: &View) { print(view); }

fn main() {
    let mut data_pool = pool<i32>(1);
    let mut view_pool = pool<View>(1);
    let data = data_pool.new(42);
    let target = data.vref();
    let view = view_pool.new(View.Item { data: target });
    drop(data); // Refusé : view doit encore lire data.
    use_view(view.vref());
}
