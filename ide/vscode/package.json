{
  "name": "corbo",
  "displayName": "Corbo",
  "description": "Syntax highlighting and editing support for Corbo source files",
  "version": "0.1.1",
  "publisher": "omework",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/omework/corbo-lang.git"
  },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [{
      "id": "corbo",
      "aliases": ["Corbo", "corbo"],
      "extensions": [".crb"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "corbo",
      "scopeName": "source.corbo",
      "path": "./syntaxes/corbo.tmLanguage.json",
      "embeddedLanguages": {
        "meta.embedded.block.c.corbo": "c"
      }
    }]
  }
}
