// Replacing a reference ends the old reference's use; only the new target remains.
struct View {
    target: &i64;
}

fn main() {
    let first: i64 = 1;
    let second: i64 = 2;
    let mut view = View { target: &first };
    view.target = &second;
    drop(first);
    let observed = *view.target;
}
