// A primitive counter is initialized before both loops; no path moves or drops it.
fn scan(limit: u64, choose: bool) u64 {
    let mut index: u64 = 0;
    while index < limit {
        index = index + 1;
    }
    if choose {
        index = 0;
        while index < limit && index != 3 {
            index = index + 1;
        }
    }
    index
}

fn main() {
    let observed = scan(4, true);
}
