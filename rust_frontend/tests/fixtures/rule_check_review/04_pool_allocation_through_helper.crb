// An allocation retains its pool as a storage source, not as a permanent exclusive loan.
fn allocate(pool: &mut Pool<i64>) A<i64> {
    pool.new(42)
}

fn main() {
    let mut pool = Pool<i64>::new(2);
    let first = allocate(&mut pool);
    let second = allocate(&mut pool);
    let observed = *first + *second;
}
