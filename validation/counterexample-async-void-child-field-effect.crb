struct View{data:&Int}
  fn change(v:&mut View,n:&Int){v.data=&*n;}
  fn read(n:&Int)->Int{let local=View{data:&*n};return *local.data;}
  async fn update(v:&mut View,n:&Int)->Int{change(v,n);yield;return *v.data;}
async fn write(v:&mut View,n:&Int){change(v,n);yield;}
async fn work(v:&mut View,n:&Int)->Int{write(v,n).await;return read(v.data);}fn main(){let mut p=pool<Int>(3);
          let mut a=p.new(7);let mut b=p.new(9);let mut c=p.new(11);
          print(c);let mut v=View{data:&a};let h=runtime::spawn(->work(&mut v,&b));match h.join(){Ok(n)=>{print(n);},Err(_)=>{}}drop(->b);print(*v.data);}