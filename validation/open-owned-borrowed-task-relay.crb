struct View { data: &Int }
async fn read(view: -> View) -> Int {
    yield;
    return *view.data;
}
fn relay(t:->read)-><-read{return <-t;}fn main() {
    let mut numbers = pool<Int>(1);
    let number = numbers.new(7);
    let view = View { data: &number };
    let task=read(->view);let forwarded=relay(->task);let execution=runtime::spawn(->forwarded);
    match execution.join() {
        Ok(value) => { print(value); },
        Err(_) => { print(99); }
    }
    drop(->number);
}
