use std::time::{Instant,Duration,Timer,sleep,Error};
fn run()->Result<(),Error>{let start=Instant::now()?;sleep(Duration::from_millis(2))?;let elapsed=start.elapsed()?;print(elapsed.as_nanos()>=2000000);let timer=Timer::after(Duration::from_nanos(0))?;timer.wait()?;Ok(())} fn main(){match run(){Ok(())=>{print(1);},Err(e)=>{drop(e);print(-1);},}}
