use std::time::{Duration, Error};use std::time::{sleep,Timer};
async fn work()->i64{match sleep(Duration::from_millis(2)).await{Ok(())=>{},Err(e)=>{drop(e);return -1;},}let timer=match Timer::after(Duration::from_nanos(0)){Ok(v)=>{v},Err(e)=>{drop(e);return -2;},};match timer.wait().await{Ok(())=>{},Err(e)=>{drop(e);return -3;},}42}fn main(){let h=runtime::spawn(work());match h.join(){Ok(v)=>{print(v);},Err(e)=>{drop(e);print(-4);},}}
