use std::encoding::binary;
fn main(){let mut b:[u8;8]=[0;8];match binary::write_u32_be(16909060,&mut b[..]){Ok(n)=>{print(n);},Err(e)=>{drop(e);return;},}print(b[0]);print(b[3]);match binary::read_u32_le(&b[..]){Ok(v)=>{print(v);},Err(e)=>{drop(e);},}match binary::write_f64_le(-1.5,&mut b[..]){Ok(n)=>{drop(n);},Err(e)=>{drop(e);},}match binary::read_f64_le(&b[..]){Ok(v)=>{print(v == -1.5);},Err(e)=>{drop(e);},}match binary::write_i64_be(-42,&mut b[..]){Ok(n)=>{drop(n);},Err(e)=>{drop(e);},}match binary::read_i64_be(&b[..]){Ok(v)=>{print(v);},Err(e)=>{drop(e);},}}
