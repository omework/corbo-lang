use std::{String,BoundedStringError};
struct Customer { id:u64,name:String<4> }
fn main(){let mut text=String<4>::new();print(text.capacity());match text.set("éé"){Ok(())=>{print(text.len());},Err(e)=>{drop(e);print(-1);},}match text.set("hello"){Ok(())=>{print(-2);},Err(e)=>{match e{BoundedStringError.TooLong=>{print(1);},}},}let bytes=text.as_bytes();print(bytes[0]);let value=Customer{id:7,name:text};print(value.id);let name=&value.name;print(name.len());}
