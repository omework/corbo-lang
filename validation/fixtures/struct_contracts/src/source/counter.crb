pub struct Counter { position: i64 }
impl Counter {
    fn new() -> Counter { Counter { position: 0 } }
    fn next(&mut self) -> Option<i64> {
        let value = (*self).position;
        if copy(value) == 2 { return None; }
        let position = &mut (*self).position;
        *position = copy(value) + 1;
        Some(value)
    }
    fn read(&mut self, bytes: &mut [u8]) -> Result<usize, bool> {
        bytes[0] = 7;
        Ok(1)
    }
    fn write(&mut self, bytes: &[u8]) -> Result<usize, bool> { Ok(bytes.len()) }
}
