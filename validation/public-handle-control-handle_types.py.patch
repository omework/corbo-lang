+def common_public_handle(nominals, definitions):
+    """Unify distinct execution frames only when their public payload agrees."""
+    names = set(nominals)
+    if len(names) < 2:
+        return None
+    from async_lowering import public_handle_type
+    payloads = set()
+    for name in names:
+        declaration = definitions[name]
+        if isinstance(declaration, tuple):
+            declaration = declaration[0]
+        payloads.add(public_handle_type(declaration.args[2]))
+    if len(payloads) == 1:
+        public = payloads.pop()
+        if public_signature(public) is not None:
+            return public
+    return None
+
