struct Item{value:&Int}
fn exchange(v:&mut Vector<A<Item>>,next:->A<Item>,i:Int)-><-Result<A<Item>,A<Item>>{return <-v.replace(i,->next);}
fn main(){let mut ns=pool<Int>(2);let a=ns.new(7);let b=ns.new(9);
let mut p=pool<Item>(2);let mut vp=pool<Vector<A<Item>>>(1);let mut v=vp.new();v.push(->p.new(value:&a));
let next=p.new(value:&b);let result=exchange(&mut v,->next,0);
match (->result){Ok(old)=>{print(*old.value);drop(->old);},Err(incoming)=>{print(*incoming.value);drop(->incoming);}}
drop(->v);drop(->a);drop(->b);}
