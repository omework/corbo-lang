--- before/tests/test_vector_payload_options.py
+++ after/tests/test_vector_payload_options.py
@@ -0,0 +1,95 @@
+"""Option returns retain the borrowed and owned graph of a vector element."""
+from pathlib import Path
+import unittest
+import test_select_source as harness
+
+BASE=Path(__file__).resolve().parents[1].joinpath('validation/open-vector-payload-option-contract.crust').read_text()
+FILL='v.push(->p.new(value:&n));'
+READ='print(*item.value);'
+MATCH='match (->result){Some(item)=>{print(*item.value);drop(->item);},None=>{print(0);}}'
+RELAY='fn relay(r:->Option<A<Item>>)-><-Option<A<Item>>{return <-r;}'
+
+
+class VectorPayloadOptionTests(unittest.TestCase):
+    run_source=harness.SelectSourceTests.run_source
+    run_c_oracle=harness.SelectSourceTests.run_c_oracle
+    refused=harness.SelectSourceTests.refused
+
+    def test_some_none_and_relay(self):
+        for relay in (False,True):
+            source=RELAY+BASE if relay else BASE
+            if relay:
+                source=source.replace('let result=take(&mut v);',
+                    'let original=take(&mut v);let result=relay(->original);')
+            for full in (True,False):
+                program=source if full else source.replace(FILL,'')
+                run=self.run_source(program)
+                self.assertEqual(run.stdout,'7\n' if full else '0\n')
+                self.assertEqual(run.stderr.count('=Item\n'),int(full))
+            for marker in ('match (->result)',READ):
+                self.refused(source.replace('drop(->n);','').replace(marker,'drop(->n);'+marker),
+                             'emprunt|réserv|référenc')
+
+    def test_empty_vector_can_die_before_result(self):
+        source=BASE.replace('drop(->v);','').replace('match (->result)','drop(->v);match (->result)')
+        self.assertEqual(self.run_source(source).stdout,'7\n')
+        scoped=BASE.replace('let mut ns=pool<Int>(1);let n=ns.new(7);','').replace(
+            '    v.push','    {let mut ns=pool<Int>(1);let n=ns.new(7);v.push').replace(
+            'let result=take(&mut v);','}let result=take(&mut v);').replace('drop(->n);','')
+        self.refused(scoped,'scope|survi|durable|emprunt')
+
+    def test_drop_and_required_transfer(self):
+        source=RELAY+BASE.replace('let result=take(&mut v);','let original=take(&mut v);let result=relay(->original);')
+        self.refused(source.replace('relay(->original)','relay(original)'),'transfert|->|mode attendu')
+        self.refused(source.replace(MATCH,''),'sans usage explicite')
+        source=source.replace(MATCH,'drop(->result);')
+        run=self.run_source(source)
+        self.assertEqual(run.stdout,'')
+        self.assertEqual(run.stderr.count('=Item\n'),1)
+        self.refused(source.replace('drop(->result);','drop(->result);drop(->result);'),'utilisable|consomm')
+
+    def test_mutable_target_reserved_through_option(self):
+        source=BASE.replace('value:&Int','value:&mut Int').replace('let n=','let mut n=').replace('value:&n','value:&mut n')
+        self.assertEqual(self.run_source(source).stdout,'7\n')
+        for op in ('print(*n);','n=20;'):
+            self.refused(source.replace('match (->result)',op+'match (->result)'),'emprunt|réserv|référenc')
+
+    def test_nested_owned_payload(self):
+        source=RELAY+BASE.replace('struct Item{value:&Int}','struct Inner{value:&Int}struct Item{inner:A<Inner>}')
+        source=source.replace('let mut p=pool<Item>(1);','let mut ip=pool<Inner>(1);let mut p=pool<Item>(1);')
+        source=source.replace(FILL,'let inner=ip.new(value:&n);v.push(->p.new(inner:<-inner));')
+        source=source.replace('let result=take(&mut v);','let original=take(&mut v);let result=relay(->original);')
+        source='fn read(i:&Inner)->Int{return *i.value;}'+source.replace(READ,'print(read(&*item.inner));')
+        run=self.run_source(source)
+        self.assertEqual(run.stdout,'7\n')
+        self.assertEqual(run.stderr.count('=Inner\n'),1)
+        self.assertEqual(run.stderr.count('=Item\n'),1)
+        empty=source.replace('let inner=ip.new(value:&n);v.push(->p.new(inner:<-inner));','')
+        self.assertEqual(self.run_source(empty).stdout,'0\n')
+        expression=empty.replace(MATCH.replace(READ,'print(read(&*item.inner));'),
+            'let number=match (->result){Some(item)=>{let out=read(&*item.inner);drop(->item);out},None=>{0}};print(number);')
+        self.assertNotEqual(expression,empty)
+        self.assertEqual(self.run_source(expression).stdout,'0\n')
+        self.refused(source.replace('drop(->n);','').replace('match (->result)','drop(->n);match (->result)'),
+                     'emprunt|réserv|référenc')
+
+    def test_consumer_returns_payload_or_fresh_fallback(self):
+        helper='''fn consume(r:->Option<A<Item>>,p:&mut Pool<Item>,n:&Int)-><-A<Item>{
+            match (->r){Some(item)=>{return <-item;},None=>{return <-p.new(value:n);}}}'''
+        source=helper+BASE.replace(MATCH,'let item=consume(->result,&mut p,&n);'+READ+'drop(->item);')
+        for full in (True,False):
+            program=source if full else source.replace(FILL,'')
+            run=self.run_source(program)
+            self.assertEqual(run.stdout,'7\n')
+            self.assertEqual(run.stderr.count('=Item\n'),1)
+        self.refused(source.replace('drop(->n);','').replace(READ,'drop(->n);'+READ),'emprunt|réserv|référenc')
+
+    def test_parent_receiver_and_pool_lifetime(self):
+        source=BASE.replace('let mut vp=','let result={let mut vp=').replace(
+            'let result=take(&mut v);','let local=take(&mut v);<-local};').replace('drop(->v);','')
+        self.assertEqual(self.run_source(source).stdout,'7\n')
+        self.refused(source.replace('let mut p=pool<Item>(1);let result={',
+            'let result={let mut p=pool<Item>(1);'),'pool|source|survi')
+
+
+if __name__=='__main__':unittest.main()
