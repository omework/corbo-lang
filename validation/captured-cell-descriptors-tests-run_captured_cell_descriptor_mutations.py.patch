--- before/tests/run_captured_cell_descriptor_mutations.py
+++ after/tests/run_captured_cell_descriptor_mutations.py
@@ -0,0 +1,56 @@
+"""Targeted capture/ABI faults in isolated compiler copies."""
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[1]
+MUTATIONS = (
+    ('forget_requirement', 'async_lowering.py',
+     'node.cell_reference_parameters.add(index)', 'pass',
+     'test_captured_cell_and_mutable_cell', ('AssertionError',), 'CONTRACT'),
+    ('stop_before_fixed_point', 'crust.py',
+     "if all(previous[name] == node.cell_reference_parameters\n                   for name, node in async_functions.items()):",
+     'if True:', 'test_requirements_reach_fixed_point_independent_of_declaration_order',
+     ('AssertionError',), 'CONTRACT_OR_C_ABI'),
+    ('forget_factory_requirement', 'results.py',
+     "if index in getattr(declaration, 'cell_reference_parameters', ()):", 'if False:',
+     'test_synchronous_factory_and_relay_keep_requirements', ('AssertionError',), 'CONTRACT'),
+    ('drop_capture_descriptor', 'async_lowering.py',
+     "initialize += f'    frame->capture_cell_{i} = capture_cell_{i};\\n'",
+     "initialize += f'    (void)capture_cell_{i}; frame->capture_cell_{i} = NULL;\\n'",
+     'test_captured_cell_and_mutable_cell', ('AssertionError',), 'EXECUTION'),
+    ('wrong_child_target', 'async_lowering.py',
+     'selected = candidates[-1]', 'selected = candidates[0]',
+     'test_child_selects_real_cell_from_multiple_captured_targets', ('AssertionError',), 'EXECUTION'),
+)
+
+
+def main():
+    success = True
+    for name, filename, before, after, method, diagnostics, stage in MUTATIONS:
+        with tempfile.TemporaryDirectory(prefix='crust-capture-cell-') as directory:
+            target = Path(directory)
+            for path in ROOT.glob('*.py'):
+                shutil.copy2(path, target/path.name)
+            path = target/filename
+            original = path.read_text()
+            assert original.count(before) == 1, (name, original.count(before))
+            path.write_text(original.replace(before, after))
+            script = f'''import sys,unittest
+sys.path[:0]=[{directory!r},{str(ROOT/'tests')!r}]
+r=unittest.TextTestRunner(verbosity=2).run(unittest.defaultTestLoader.loadTestsFromName(
+'test_captured_cell_descriptors.CapturedCellDescriptorTests.{method}'))
+sys.exit(not r.wasSuccessful())'''
+            result = subprocess.run([sys.executable, '-c', script], cwd=directory,
+                                    capture_output=True, text=True, timeout=90)
+        detected = result.returncode == 1 and any(message in result.stderr for message in diagnostics)
+        print(name, 'DETECTED_'+stage if detected else 'SURVIVED' if result.returncode == 0 else 'INCONCLUSIVE', flush=True)
+        print(result.stdout+result.stderr, flush=True)
+        success &= detected
+    return int(not success)
+
+
+if __name__ == '__main__':
+    sys.exit(main())
