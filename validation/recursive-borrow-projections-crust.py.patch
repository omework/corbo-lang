+    def prepare_recursive_reference_fields(self, holder):
+        """Materialize only declared loans of an opaque symbolic descendant."""
+        if not holder.recursive_projection_sources:
+            return
+        fields = dict(holder.dependencies)
+        for arm, members in self.enums.get(holder.typ, {}).items():
+            for name, declared in members:
+                capability = reference_type(declared)
+                key = arm + '.' + name
+                if capability is None or key in fields:
+                    continue
+                targets = []
+                for origin, _ in holder.recursive_projection_sources:
+                    cache_key = origin, key
+                    if cache_key not in self.symbolic_borrow_projections:
+                        typ = capability[1]
+                        source_scope = holder.sources[0].scope
+                        source = MemorySource(self.uid(), source_scope, 'symbolic', key, 'NULL', element_type=typ)
+                        target = Allocation(self.uid(), source_scope, key, (source,), typ=typ,
+                                            variants=frozenset(self.enums.get(typ, {})))
+                        if typ in self.struct_fields:
+                            # Stored nominal references may designate an interior
+                            # structure. Keep the descriptor ABI, not just its root.
+                            self.origin_sources[target.id] = source
+                            target = replace(target, id=self.uid(), inline_root=target, inline_path='')
+                        reachable, pending = {typ}, [typ]
+                        sources = {typ: source}
+                        while pending:
+                            current = pending.pop()
+                            for nested in self.enums.get(current, {}).values():
+                                for _, field_type in nested:
+                                    if field_type.startswith('A<') and field_type[2:-1] not in reachable:
+                                        child_type = field_type[2:-1]
+                                        reachable.add(child_type); pending.append(child_type)
+                                        sources[child_type] = MemorySource(self.uid(), source_scope, 'symbolic',
+                                            key, 'NULL', element_type=child_type)
+                        target.recursive_projection_sources = ((target.id, tuple(sources.items())),)
+                        self.origin_sources[target.id] = source
+                        self.symbolic_borrow_projections[cache_key] = target
+                    targets.append(self.symbolic_borrow_projections[cache_key])
+                fields[key] = tuple(targets)
+        holder.dependencies = tuple(fields.items())
 
