async fn count(values: &Vector<A<Int>>) -> &Int {
    let view = &*values[0];
    yield;
    return view;
}
fn main() {
    let mut numbers = pool<Int>(1);
    let mut vectors = pool<Vector<A<Int>>>(1);
    let mut values = vectors.new();
    values.push(-> numbers.new(7));
    let h = runtime::spawn(-> count(&values));
    match h.join() { Ok(n) => { print(*n); }, Err(_) => { print(99); } }
    drop(-> values);
    let reused = numbers.new(8);
    print(*reused);
}
