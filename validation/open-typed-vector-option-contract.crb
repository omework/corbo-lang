struct Point{x:Int}
fn pop(v:&mut Vector<A<Point>>)-><-Option<A<Point>>{return <-v.pop();}
fn main(){let mut p=pool<Point>(1);let mut vectors=pool<Vector<A<Point>>>(1);
let mut v=vectors.new();v.push(->p.new(x:7));let result=pop(&mut v);
match (->result){Some(n)=>{print(n.x);drop(->n);},None=>{print(0);}}
drop(->v);let reused=p.new(x:9);print(reused.x);}
