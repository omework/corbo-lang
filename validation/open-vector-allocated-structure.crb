struct Point{x:Int}
fn main(){
    let mut points=pool<Point>(1);
    let mut vectors=pool<Vector<A<Point>>>(1);
    let mut values=vectors.new();
    let p=points.new(x:7);
    values.push(->p);
    let result=<-values.pop();
    match (->result){Some(point)=>{print(point.x);drop(->point);},None=>{print(0);}}
    drop(->values);
    let reused=points.new(x:8);print(reused.x);
}
