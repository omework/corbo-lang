+    def inline_structure_projection(self, binding, path, mode, c=''):
+        from structure_views import contained_field
+        layout = contained_field(self.enums, binding.alloc.typ, path)
+        if layout is None:
+            self.fail(f"sous-structure inconnue '{path}' dans {binding.alloc.typ}")
+        if any(typ != 'Int' for _, typ in self.enums[layout.typ]['']):
+            self.fail('prototype : vue de sous-structure à champs non Int non encore raccordée')
+        targets, parents = [], []
+        for holder in binding.referents or (binding.alloc,):
+            root = holder.inline_root or holder
+            full_path = holder.inline_path + '.' + path if holder.inline_root else path
+            key = root.id, full_path
+            if key not in self.inline_views:
+                self.inline_views[key] = Allocation(self.uid(), root.scope, full_path, root.sources,
+                    typ=layout.typ, variants=frozenset({''}), inline_root=root, inline_path=full_path)
+            view = self.inline_views[key]
+            view.scope, view.sources = root.scope, root.sources
+            targets.append(view)
+            parents.append(Binding(binding.name, mode, binding.c, root,
+                borrow_parents=(binding,), match_reservation=True, reserved_field=full_path))
+        return self.reference_descriptor(c, targets, parents)
