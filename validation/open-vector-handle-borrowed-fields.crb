struct Item{value:&Int}
fn main(){let mut numbers=pool<Int>(1);let number=numbers.new(7);
    let mut items=pool<Item>(1);let item=items.new(value:&number);
    let mut vectors=pool<Vector<A<Item>>>(1);let mut values=vectors.new();
    values.push(->item);let extracted=<-values.remove(0);
    print(*extracted.value);drop(->extracted);drop(->values);drop(->number);
    let reused=numbers.new(9);print(*reused);}
