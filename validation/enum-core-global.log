ll *cell, int resetting) {\n    Source *source = cell->source;\n    const char *label = cell->label;\n    data_slots_lock();\n    if (cell->reservation_depth) {\n        cell->label = NULL;\n        data_slots_unlock();\n        return;\n    }\n    cell->alive = 0;\n    source->live--;\n    if (!source->stack) {\n        if (cell->prev) cell->prev->next = cell->next;\n        if (cell->next) cell->next->prev = cell->prev;\n        if (source->tail == cell) source->tail = cell->prev;\n        free(cell);\n        if (label) fprintf(stderr, "free %s\\n", label);\n    } else if (!(resetting && source->pool)) {\n        if (source->pool) {\n            cell->free_next = source->free_head;\n            if (source->free_head) source->free_head->free_prev = cell;\n            source->free_head = cell;\n        }\n        /* A dead interior cell is reclaimed when the suffix above it dies. */\n        if (source->tail->alive) {\n            data_slots_unlock();\n            return;\n        }\n        while (source->tail && !source->tail->alive) {\n            Cell *dead = source->tail;\n            if (source->pool) pool_unlink_free(source, dead);\n            source->tail = dead->prev;\n            if (source->tail) source->tail->next = NULL;\n            if (dead->label) fprintf(stderr, "reclaim %s\\n", dead->label);\n        }\n        source->used = source->tail\n            ? (size_t)((unsigned char *)source->tail - source->base) + source->tail->storage_size : 0;\n    }\n    data_slots_unlock();\n}\nstatic void local_reservation_end(Cell *cell) {\n    if (!cell->reservation_depth) fail("inactive local reservation");\n    cell->reservation_depth--;\n    if (!cell->reservation_depth && !cell->label) cell_release_storage(cell, 0);\n}\nstatic void cell_drop_impl(Cell *cell, int resetting) {\n    /* Demonstration destructor: memory is still valid here. */\n    Source *source = cell->source;\n    const Source *layout = cell->layout;\n    if (layout->drop_payload) layout->drop_payload(cell);\n    if (source->vectors) vector_drop(cell);\n    if (layout->field_kinds)\n        for (size_t i = layout->field_count; i > 0; --i)\n            if (layout->field_kinds[i - 1] == 2) {\n                Cell *child = cell_load_ref(cell, layout->field_offsets[i - 1]);\n                if (child) cell_drop_impl(child, 0);\n            }\n    if (cell->label && layout->enum_name)\n        fprintf(stderr, "destroy %s=%s%s%s\\n", cell->label, layout->enum_name,\n                *layout->arm_name ? "." : "", layout->arm_name);\n    else if (cell->label)\n        fprintf(stderr, "destroy %s=%d\\n", cell->label, cell->value);\n    cell_release_storage(cell, resetting);\n}\nstatic void cell_drop(Cell *cell) {\n    cell_drop_impl(cell, 0);\n}\nstatic void source_check_empty(Source *source) {\n    if (source->live) fail("internal error: source still has live allocations");\n    for (size_t i = 0; i < source->arm_count; i++) source_check_empty(&source->arms[i]);\n}\nstatic void source_close(Source *source) {\n    source_check_empty(source);\n    if (source->vectors) vector_storage_close(source->vectors);\n    for (size_t i = 0; i < source->arm_count; i++) source_close(&source->arms[i]);\n    if (source->stack && munmap(source->base, source->mapping_size) != 0)\n        fail("virtual memory release failed");\n}\n\n/* Internal storage primitives. A span descriptor stays at a fixed address\n * while it occupies a front; the caller destroys its contents before release. */\ntypedef enum { GROWTH_LOW, GROWTH_HIGH } GrowthFront;\ntypedef struct GrowthSpan GrowthSpan;\ntypedef struct {\n    Source mapping;\n    size_t low, high;\n    GrowthSpan *fronts[2];\n} GrowthStack;\nstruct GrowthSpan {\n    GrowthStack *stack;\n    GrowthFront front;\n    size_t saved_cursor, element_size;\n};\n\nstatic GrowthStack growth_stack(size_t capacity) {\n    return (GrowthStack){.mapping = source_stack(capacity), .high = capacity};\n}\n\nstatic int growth_open(GrowthStack *stack, GrowthSpan *span, GrowthFront front,\n                       size_t element_size, size_t alignment) {\n    if (stack->mapping.capacity == 0 || (front != GROWTH_LOW && front != GROWTH_HIGH) ||\n            stack->fronts[front] || span->stack) return 0;\n    if (alignment == 0 || (alignment & (alignment - 1)) || element_size == 0 ||\n            element_size % alignment != 0 || (uintptr_t)stack->mapping.base % alignment != 0)\n        return 0;\n    size_t saved = front == GROWTH_LOW ? stack->low : stack->high;\n    size_t residue = saved & (alignment - 1);\n    size_t padding = front == GROWTH_LOW && residue ? alignment - residue : residue;\n    if (padding > stack->high - stack->low) return 0;\n    if (front == GROWTH_LOW) stack->low += padding;\n    else stack->high -= padding;\n    *span = (GrowthSpan){stack, front, saved, element_size};\n    stack->fronts[front] = span;\n    return 1;\n}\n\nstatic unsigned char *growth_extend(GrowthSpan *span, size_t count) {\n    GrowthStack *stack = span->stack;\n    if (!stack || stack->fronts[span->front] != span) return NULL;\n    size_t available = stack->high - stack->low;\n    if (count > available / span->element_size) return NULL;\n    size_t bytes = count * span->element_size;\n    if (span->front == GROWTH_LOW) {\n        size_t offset = stack->low;\n        stack->low += bytes;\n        return stack->mapping.base + offset;\n    }\n    stack->high -= bytes;\n    return stack->mapping.base + stack->high;\n}\n\nstatic void growth_release(GrowthSpan *span) {\n    GrowthStack *stack = span->stack;\n    if (!stack || stack->fronts[span->front] != span) fail("front de croissance inactif");\n    if (span->front == GROWTH_LOW) stack->low = span->saved_cursor;\n    else stack->high = span->saved_cursor;\n    stack->fronts[span->front] = NULL;\n    *span = (GrowthSpan){0};\n}\n\nstatic void growth_close(GrowthStack *stack) {\n    if (stack->fronts[GROWTH_LOW] || stack->fronts[GROWTH_HIGH])\n        fail("data stack avec un front encore vivant");\n    source_close(&stack->mapping);\n    *stack = (GrowthStack){0};\n}\n\ntypedef struct {\n    GrowthSpan span;\n    GrowthStack dedicated;\n} GrowthSpanPlacement;\n\nstatic int growth_place(GrowthSpanPlacement *placement, GrowthStack *preferred,\n                        size_t dedicated_capacity, size_t element_size, size_t alignment) {\n    if (placement->span.stack || alignment == 0 || (alignment & (alignment - 1)) ||\n            element_size == 0 || element_size % alignment) return 0;\n    if (preferred) {\n        for (GrowthFront front = GROWTH_LOW; front <= GROWTH_HIGH; ++front) {\n            if (growth_open(preferred, &placement->span, front, element_size, alignment)) {\n                if (element_size <= preferred->high - preferred->low) return 1;\n                growth_release(&placement->span);\n            }\n        }\n    }\n    if (dedicated_capacity < element_size) return 0;\n    placement->dedicated = growth_stack(dedicated_capacity);\n    if (growth_open(&placement->dedicated, &placement->span, GROWTH_LOW, element_size, alignment))\n        return 1;\n    growth_close(&placement->dedicated);\n    return 0;\n}\n\nstatic void growth_unplace(GrowthSpanPlacement *placement) {\n    growth_release(&placement->span);\n    if (placement->dedicated.mapping.capacity) growth_close(&placement->dedicated);\n}\n\ntypedef struct GrowthRegion GrowthRegion;\ntypedef struct {\n    Source slots;\n    size_t region_size, payload_offset;\n} GrowthRegionPool;\nstruct GrowthRegion {\n    GrowthRegionPool *pool;\n    Cell *slot;\n    size_t used, element_size;\n};\n\nstatic size_t growth_region_stride(size_t region_size, size_t *payload_offset) {\n    const size_t alignment = _Alignof(max_align_t);\n    size_t header = sizeof(Cell) + sizeof(GrowthRegion *);\n    size_t offset = (header + alignment - 1) / alignment * alignment;\n    if (region_size == 0 || region_size > SIZE_MAX - offset - (alignment - 1))\n        fail("taille de région invalide");\n    *payload_offset = offset;\n    return (offset + region_size + alignment - 1) / alignment * alignment;\n}\n\nstatic GrowthRegionPool growth_region_pool(size_t slots, size_t region_size) {\n    size_t offset;\n    size_t stride = growth_region_stride(region_size, &offset);\n    Source source = source_pool_layout(slots, stride - sizeof(Cell));\n    if ((uintptr_t)source.base % _Alignof(max_align_t) || source.stride % _Alignof(max_align_t))\n        fail("alignement de région non pris en charge");\n    return (GrowthRegionPool){source, region_size, offset};\n}\n\nstatic void growth_region_set_holder(Cell *slot, GrowthRegion *holder) {\n    memcpy((unsigned char *)slot + sizeof(Cell), &holder, sizeof holder);\n}\n\nstatic int growth_region_is_live(GrowthRegion *region) {\n    if (!region->slot || !region->pool || region->pool->region_size == 0) return 0;\n    Source *source = &region->pool->slots;\n    uintptr_t offset = (uintptr_t)region->slot - (uintptr_t)source->base;\n    if (offset >= source->used || offset % source->stride || !region->slot->alive) return 0;\n    GrowthRegion *holder;\n    memcpy(&holder, (unsigned char *)region->slot + sizeof(Cell), sizeof holder);\n    return holder == region;\n}\n\nstatic int growth_region_open(GrowthRegionPool *pool, GrowthRegion *region,\n                              size_t element_size, size_t alignment) {\n    if (region->slot || pool->region_size == 0 || element_size == 0 || alignment == 0 ||\n            _Alignof(max_align_t) % alignment || element_size % alignment) return 0;\n    Cell *slot = cell_try_new(&pool->slots, 0, NULL);\n    if (!slot) return 0;\n    *region = (GrowthRegion){pool, slot, 0, element_size};\n    growth_region_set_holder(slot, region);\n    return 1;\n}\n\nstatic unsigned char *growth_region_extend(GrowthRegion *region, size_t count) {\n    if (!growth_region_is_live(region)) return NULL;\n    size_t available = region->pool->region_size - region->used;\n    if (count > available / region->element_size) return NULL;\n    unsigned char *block = (unsigned char *)region->slot + region->pool->payload_offset + region->used;\n    region->used += count * region->element_size;\n    return block;\n}\n\nstatic void growth_region_release(GrowthRegion *region) {\n    if (!growth_region_is_live(region)) fail("région de croissance inactive");\n    growth_region_set_holder(region->slot, NULL);\n    cell_drop(region->slot);\n    *region = (GrowthRegion){0};\n}\n\nstatic void growth_region_pool_close(GrowthRegionPool *pool) {\n    if (pool->slots.mapping_size) source_close(&pool->slots);\n    else source_check_empty(&pool->slots);\n    *pool = (GrowthRegionPool){0};\n}\n\n/* The placement descriptor owns its dedicated pool, when one is needed. */\ntypedef struct {\n    GrowthRegion region;\n    GrowthRegionPool dedicated;\n} GrowthRegionPlacement;\n\nstatic int growth_region_place(GrowthRegionPlacement *placement, GrowthRegionPool *preferred,\n                               size_t region_size, size_t element_size, size_t alignment) {\n    if (placement->region.slot || region_size == 0 || element_size == 0 || alignment == 0 ||\n            _Alignof(max_align_t) % alignment || element_size % alignment) return 0;\n    if (preferred && preferred->region_size == region_size &&\n            growth_region_open(preferred, &placement->region, element_size, alignment)) return 1;\n    placement->dedicated = growth_region_pool(1, region_size);\n    if (!growth_region_open(&placement->dedicated, &placement->region, element_size, alignment))\n        fail("impossible d’ouvrir une région dédiée");\n    return 1;\n}\n\nstatic void growth_region_unplace(GrowthRegionPlacement *placement) {\n    growth_region_release(&placement->region);\n    if (placement->dedicated.region_size) growth_region_pool_close(&placement->dedicated);\n}\n\nstruct VectorStorage {\n    GrowthStack stack;\n    Source region_classes;\n    size_t slots, class_count;\n};\n\nenum { VECTOR_STACK_CAPACITY = 4 * 1024 * 1024 };\nenum { VECTOR_STORAGE_UNRESERVED, VECTOR_REGION_RESERVED, VECTOR_FRONT_RESERVED, VECTOR_DEDICATED_RESERVED };\n\ntypedef struct {\n    GrowthSpanPlacement span;\n    GrowthRegionPlacement region;\n    size_t length, element_size;\n    int owns_handles;\n    const Source *element_layout;\n} VectorItems;\n\n_Static_assert(_Alignof(VectorItems) <= _Alignof(Cell),\n               "Vector descriptors require aligned slots");\n\nstatic Source source_vector_pool(size_t count, VectorStorage *storage) {\n    Source source = source_pool_layout(count, sizeof(VectorItems));\n    storage->slots = count;\n    source.vectors = storage;\n    return source;\n}\n\nstatic VectorItems *vector_items(Cell *cell) {\n    return (VectorItems *)((unsigned char *)cell + sizeof(Cell));\n}\n\nstatic void vector_refresh_front_boundary(VectorStorage *storage) {\n    GrowthStack *stack = &storage->stack;\n    if (stack->fronts[GROWTH_HIGH]) return;\n    const GrowthRegionPool *classes = (const GrowthRegionPool *)storage->region_classes.base;\n    stack->high = stack->mapping.capacity;\n    for (size_t i = 0; i < storage->class_count; ++i) {\n        if (!classes[i].slots.base) continue;\n        size_t start = (size_t)(classes[i].slots.base - stack->mapping.base);\n        if (start < stack->high) stack->high = start;\n    }\n}\n\nstatic void vector_discard_empty_classes(VectorStorage *storage) {\n    GrowthRegionPool *classes = (GrowthRegionPool *)storage->region_classes.base;\n    for (size_t i = 0; i < storage->class_count; ++i)\n        if (!classes[i].slots.used) growth_region_pool_close(&classes[i]);\n    vector_refresh_front_boundary(storage);\n}\n\nstatic Source vector_region_slice(VectorStorage *storage, GrowthRegionPool *classes, size_t stride) {\n    GrowthStack *stack = &storage->stack;\n    Source *arena = &stack->mapping;\n    GrowthSpan *high = stack->fronts[GROWTH_HIGH];\n    /* A live descending front may still use the gap below its original edge. */\n    size_t floor = high ? high->saved_cursor : stack->low;\n    // Region strides are aligned, so their high boundary must be aligned too.\n    size_t upper = arena->capacity - arena->capacity % _Alignof(max_align_t);\n    while (upper >= floor && upper - floor >= stride) {\n        /* Search gaps from the high end without shifting occupied classes. */\n        size_t lower = floor, preceding = floor;\n        for (size_t i = 0; i < storage->class_count; ++i) {\n            Source *slots = &classes[i].slots;\n            if (!slots->base) continue;\n            size_t start = (size_t)(slots->base - arena->base);\n            size_t end = start + slots->capacity;\n            if (end <= upper && end > lower) {\n                lower = end;\n                preceding = start;\n            }\n        }\n        size_t count = (upper - lower) / stride;\n        if (count > storage->slots) count = storage->slots;\n        if (count) {\n            size_t capacity = count * stride;\n            return (Source){.base = arena->base + upper - capacity, .capacity = capacity,\n                            .stride = stride, .stack = 1, .pool = 1};\n        }\n        upper = preceding;\n    }\n    return (Source){0};\n}\n\nstatic GrowthRegionPool *vector_region_class(VectorStorage *storage, size_t region_size) {\n    size_t offset;\n    size_t stride = growth_region_stride(region_size, &offset);\n    if (stride > storage->stack.mapping.capacity) return NULL;\n    if (!storage->region_classes.base) {\n        if (storage->slots > SIZE_MAX / sizeof(GrowthRegionPool))\n            fail("table de régions trop grande");\n        storage->region_classes = source_stack(storage->slots * sizeof(GrowthRegionPool));\n    }\n    GrowthRegionPool *classes = (GrowthRegionPool *)storage->region_classes.base;\n    GrowthRegionPool *empty = NULL;\n    for (size_t i = 0; i < storage->class_count; ++i) {\n        if (classes[i].region_size == region_size) return &classes[i];\n        if (!classes[i].slots.used && !empty) empty = &classes[i];\n    }\n    if (empty) {\n        growth_region_pool_close(empty);\n    }\n    Source slots = vector_region_slice(storage, classes, stride);\n    if (!slots.base) {\n        vector_discard_empty_classes(storage);\n        slots = vector_region_slice(storage, classes, stride);\n    }\n    if (!slots.base) return NULL;\n    if (!empty) {\n        if (storage->class_count == storage->slots) return NULL;\n        empty = &classes[storage->class_count++];\n    }\n    *empty = (GrowthRegionPool){slots, region_size, offset};\n    return empty;\n}\n\nstatic int vector_reserve_region_unlocked(Cell *reserved, uint64_t limit, size_t element_size,\n                                 size_t alignment, size_t shorter_slots, int allow_class_creation) {\n    if (!reserved || !limit || limit > SIZE_MAX) return 0;\n    VectorStorage *storage = reserved->source->vectors;\n    if (!storage) return 0;\n    size_t capacity = storage->stack.mapping.capacity ? storage->stack.mapping.capacity : VECTOR_STACK_CAPACITY;\n    if (limit >= capacity) return 0;\n    if (!storage->region_classes.base) {\n        if (!allow_class_creation || storage->slots > SIZE_MAX / sizeof(GrowthRegionPool)) return 0;\n        size_t offset;\n        if (capacity / growth_region_stride((size_t)limit, &offset) <= shorter_slots) return 0;\n        Source mapping = {0}, classes;\n        if (!storage->stack.mapping.capacity && source_stack_mapping(capacity, &mapping)) return 0;\n        if (source_stack_mapping(storage->slots * sizeof(GrowthRegionPool), &classes)) {\n            if (mapping.base) source_close(&mapping);\n            return 0;\n        }\n        if (mapping.base)\n            storage->stack = (GrowthStack){.mapping = mapping, .high = capacity};\n        storage->region_classes = classes;\n    }\n    GrowthRegionPool *classes = (GrowthRegionPool *)storage->region_classes.base;\n    GrowthRegionPool *pool = NULL;\n    if (allow_class_creation) {\n        pool = vector_region_class(storage, (size_t)limit);\n        vector_refresh_front_boundary(storage);\n    } else {\n        for (size_t i = 0; i < storage->class_count; ++i)\n            if (classes[i].region_size == (size_t)limit && classes[i].slots.live) {\n                pool = &classes[i];\n                break;\n            }\n    }\n    if (!pool || pool->slots.capacity / pool->slots.stride - pool->slots.live <= shorter_slots) return 0;\n    VectorItems *items = vector_items(reserved);\n    *items = (VectorItems){.element_size = element_size};\n    return growth_region_open(pool, &items->region.region, element_size, alignment)\n        ? VECTOR_REGION_RESERVED : VECTOR_STORAGE_UNRESERVED;\n}\n\nstatic int vector_reserve_region(Cell *reserved, uint64_t limit, size_t element_size,\n                                 size_t alignment, size_t shorter_slots, int allow_class_creation) {\n    growth_storage_lock();\n    int result = vector_reserve_region_unlocked(reserved, limit, element_size, alignment,\n                                                shorter_slots, allow_class_creation);\n    growth_storage_unlock();\n    return result;\n}\n\nstatic int vector_reserve_front_unlocked(Cell *reserved, size_t element_size, size_t alignment) {\n    if (!reserved || !element_size || !reserved->source->vectors) return VECTOR_STORAGE_UNRESERVED;\n    VectorStorage *storage = reserved->source->vectors;\n    GrowthStack *stack = &storage->stack;\n    if (stack->fronts[GROWTH_LOW] || stack->fronts[GROWTH_HIGH]) return VECTOR_STORAGE_UNRESERVED;\n    if (!stack->mapping.capacity) {\n        Source mapping;\n        if (source_stack_mapping(VECTOR_STACK_CAPACITY, &mapping)) return VECTOR_STORAGE_UNRESERVED;\n        *stack = (GrowthStack){.mapping = mapping, .high = mapping.capacity};\n    }\n    vector_discard_empty_classes(storage);\n    if ((stack->high - stack->low) / element_size < 2) return VECTOR_STORAGE_UNRESERVED;\n    VectorItems *items = vector_items(reserved);\n    *items = (VectorItems){.element_size = element_size};\n    if (!growth_open(stack, &items->span.span, GROWTH_HIGH, element_size, alignment))\n        return VECTOR_STORAGE_UNRESERVED;\n    return VECTOR_FRONT_RESERVED;\n}\n\nstatic int vector_reserve_front(Cell *reserved, size_t element_size, size_t alignment) {\n    growth_storage_lock();\n    int result = vector_reserve_front_unlocked(reserved, element_size, alignment);\n    growth_storage_unlock();\n    return result;\n}\n\nstatic int vector_reserve_dedicated_front(Cell *reserved, size_t element_size, size_t alignment) {\n    if (!reserved || !element_size || element_size > VECTOR_STACK_CAPACITY)\n        return VECTOR_STORAGE_UNRESERVED;\n    Source mapping;\n    if (source_stack_mapping(VECTOR_STACK_CAPACITY, &mapping)) return VECTOR_STORAGE_UNRESERVED;\n    VectorItems *items = vector_items(reserved);\n    *items = (VectorItems){.element_size = element_size};\n    GrowthStack *stack = &items->span.dedicated;\n    *stack = (GrowthStack){.mapping = mapping, .high = mapping.capacity};\n    if (!growth_open(stack, &items->span.span, GROWTH_LOW, element_size, alignment)) {\n        growth_close(stack);\n        return VECTOR_STORAGE_UNRESERVED;\n    }\n    return VECTOR_DEDICATED_RESERVED;\n}\n\nstatic Cell *vector_construct_reserved(Cell *reserved, int storage_reserved, Source *source, uint64_t region_limit,\n                                       size_t element_size, size_t alignment, int forward_only,\n                                       int owns_handles, const char *label) {\n    if (!source->vectors || region_limit > SIZE_MAX) fail("stockage de Vector incompatible");\n    Cell *cell = cell_construct_reserved(reserved, source, 0, label);\n    VectorStorage *storage = source->vectors;\n    VectorItems *items = vector_items(cell);\n    if (storage_reserved == VECTOR_REGION_RESERVED) {\n        if (!growth_region_is_live(&items->region.region) ||\n                items->region.region.pool->region_size != (size_t)region_limit ||\n                items->element_size != element_size)\n            fail("région réservée incompatible avec la construction");\n        items->owns_handles = owns_handles;\n        return cell;\n    }\n    if (storage_reserved == VECTOR_FRONT_RESERVED || storage_reserved == VECTOR_DEDICATED_RESERVED) {\n        int dedicated = storage_reserved == VECTOR_DEDICATED_RESERVED;\n        GrowthStack *stack = dedicated ? &items->span.dedicated : &storage->stack;\n        GrowthFront front = dedicated ? GROWTH_LOW : GROWTH_HIGH;\n        GrowthSpan *span = &items->span.span;\n        if (region_limit || (forward_only && !dedicated) || items->element_size != element_size ||\n                span->stack != stack || stack->fronts[front] != span)\n            fail("front réservé incompatible avec la construction");\n        items->owns_handles = owns_handles;\n        return cell;\n    }\n    *items = (VectorItems){.element_size = element_size, .owns_handles = owns_handles};\n    const size_t capacity = VECTOR_STACK_CAPACITY;\n    growth_storage_lock();\n    if (!storage->stack.mapping.capacity) storage->stack = growth_stack(capacity);\n    if (region_limit) {\n        GrowthRegionPool *regions = vector_region_class(storage, (size_t)region_limit);\n        vector_refresh_front_boundary(storage);\n        if (!growth_region_place(&items->region, regions, (size_t)region_limit, element_size, alignment))\n            fail("impossible de placer la région du Vector");\n    } else {\n        vector_discard_empty_classes(storage);\n        if (forward_only) {\n            if (growth_open(&storage->stack, &items->span.span, GROWTH_LOW, element_size, alignment) &&\n                    element_size > storage->stack.high - storage->stack.low)\n                growth_release(&items->span.span);\n            if (!items->span.span.stack &&\n                    !growth_place(&items->span, NULL, capacity, element_size, alignment))\n                fail("impossible de placer le stockage contigu du Vector");\n        } else if (!growth_place(&items->span, &storage->stack, capacity, element_size, alignment)) {\n            fail("impossible de placer le stockage du Vector");\n        }\n    }\n    growth_storage_unlock();\n    return cell;\n}\n\nstatic Cell *vector_new(Source *source, uint64_t region_limit, size_t element_size,\n                        size_t alignment, int forward_only, const char *label) {\n    return vector_construct_reserved(NULL, 0, source, region_limit, element_size, alignment, forward_only, 0, label);\n}\n\nstatic Cell *vector_new_handles(Source *source, uint64_t region_limit, const char *label) {\n    return vector_construct_reserved(NULL, 0, source, region_limit, sizeof(Cell *), _Alignof(Cell *), 0, 1, label);\n}\n\nstatic unsigned char *vector_base(VectorItems *items) {\n    GrowthRegion *region = &items->region.region;\n    if (region->slot)\n        return (unsigned char *)region->slot + region->pool->payload_offset;\n    GrowthSpan *span = &items->span.span;\n    return span->stack->mapping.base + (span->front == GROWTH_LOW\n        ? span->stack->low - items->length * items->element_size : span->stack->high);\n}\n\nstatic int vector_descends(const VectorItems *items) {\n    return items->span.span.stack && items->span.span.front == GROWTH_HIGH;\n}\n\nstatic unsigned char *vector_item_at(VectorItems *items, size_t index) {\n    if (index >= items->length) return NULL;\n    if (vector_descends(items))\n        index = items->length - index - 1;\n    return vector_base(items) + index * items->element_size;\n}\n\nstatic int vector_values_equal(Cell *left, Cell *right) {\n    VectorItems *a = vector_items(left), *b = vector_items(right);\n    if (a->length != b->length || a->element_size != b->element_size) return 0;\n    for (size_t i = 0; i < a->length; ++i) {\n        const unsigned char *x = vector_item_at(a, i), *y = vector_item_at(b, i);\n        if (a->element_size == sizeof(int)) {\n            int first, second;\n            memcpy(&first, x, sizeof first);\n            memcpy(&second, y, sizeof second);\n            if (first != second) return 0;\n        } else if (memcmp(x, y, a->element_size) != 0) {\n            return 0;\n        }\n    }\n    return 1;\n}\n\nstatic int vector_try_append(VectorItems *items, const void *source, size_t count, int source_descends) {\n    if (count == 0) return 1;\n    unsigned char *added;\n    if (items->region.region.slot) {\n        added = growth_region_extend(&items->region.region, count);\n    } else {\n        growth_storage_lock();\n        added = growth_extend(&items->span.span, count);\n        growth_storage_unlock();\n    }\n    if (!added) return 0;\n    size_t size = items->element_size;\n    if (vector_descends(items) != source_descends) {\n        const unsigned char *element = source;\n        for (size_t i = 0; i < count; ++i)\n            memcpy(added + (count - i - 1) * size, element + i * size, size);\n    } else {\n        memmove(added, source, count * size);\n    }\n    items->length += count;\n    return 1;\n}\n\nstatic int vector_try_extend(VectorItems *items, const void *source, size_t count) {\n    return vector_try_append(items, source, count, 0);\n}\n\n/* Callers validate logical bounds before constructing a view. */\nstatic VectorSlice vector_slice_range(VectorItems *items, size_t first, size_t last) {\n    if (first == last) return (VectorSlice){0};\n    int descends = vector_descends(items);\n    return (VectorSlice){vector_item_at(items, descends ? last - 1 : first),\n                         last - first, descends};\n}\n\nstatic VectorSlice vector_slice(Cell *cell, int start, int end, int has_end) {\n    VectorItems *items = vector_items(cell);\n    if (start < 0 || (has_end && end < start)) fail("bornes de tranche de Vector invalides");\n    size_t first = (size_t)start;\n    size_t last = has_end ? (size_t)end : items->length;\n    if (last > items->length || first > last) fail("bornes de tranche de Vector invalides");\n    return vector_slice_range(items, first, last);\n}\n\nstatic VectorSlice vector_subslice(VectorSlice slice, int start, int end, int has_end, size_t element_size) {\n    if (start < 0 || (has_end && end < start)) fail("bornes de tranche de Vector invalides");\n    size_t first = (size_t)start;\n    size_t last = has_end ? (size_t)end : slice.length;\n    if (last > slice.length || first > last) fail("bornes de tranche de Vector invalides");\n    if (first == last) return (VectorSlice){0};\n    size_t offset = slice.descends ? slice.length - last : first;\n    return (VectorSlice){slice.base + offset * element_size, last - first, slice.descends};\n}\n\ntypedef struct {\n    VectorSlice left, right;\n} VectorSplit;\n\n/* The verifier must reserve the parent while either view can be used. */\nstatic VectorSplit vector_split_at_mut(Cell *cell, int index) {\n    VectorItems *items = vector_items(cell);\n    if (index < 0 || (size_t)index > items->length)\n        fail("indice de séparation de Vector hors limites");\n    size_t middle = (size_t)index;\n    return (VectorSplit){vector_slice_range(items, 0, middle),\n                         vector_slice_range(items, middle, items->length)};\n}\n\nstatic VectorSplit vector_subsplit(VectorSlice slice, int index, size_t element_size) {\n    return (VectorSplit){vector_subslice(slice, 0, index, 1, element_size),\n                         vector_subslice(slice, index, 0, 0, element_size)};\n}\n\nstatic const unsigned char *vector_slice_address(VectorSlice slice, int index, size_t element_size) {\n    if (index < 0 || (size_t)index >= slice.length) fail("indice de tranche de Vector hors limites");\n    size_t offset = (size_t)index;\n    if (slice.descends) offset = slice.length - offset - 1;\n    return slice.base + offset * element_size;\n}\n\nstatic const unsigned char *vector_slice_byte_address(VectorSlice slice, int index) {\n    return vector_slice_address(slice, index, 1);\n}\n\nstatic CrustTextResult text_from_vector_slice(VectorSlice slice) {\n    if (!slice.descends) return text_from_utf8(slice.base, slice.length);\n    CrustText text = {slice.base, slice.length, 1};\n    for (size_t offset = 0; offset < text.length;) {\n        CrustChar scalar;\n        size_t width = text_decode(text, offset, &scalar);\n        if (width == 0) return (CrustTextResult){5, {0}};\n        offset += width;\n    }\n    return (CrustTextResult){0, text};\n}\n\nstatic int vector_len(Cell *cell) {\n    size_t length = vector_items(cell)->length;\n    if (length > INT_MAX) fail("longueur de Vector hors limites Int32");\n    return (int)length;\n}\n\nenum { CRUST_VECTOR_OK = 0, CRUST_VECTOR_REJECTED = 5, CRUST_VECTOR_CAPACITY = 9 };\n\nstatic int vector_try_push(Cell *cell, const void *value) {\n    return vector_try_extend(vector_items(cell), value, 1) ? CRUST_VECTOR_OK : CRUST_VECTOR_REJECTED;\n}\n\nstatic CrustStatus vector_try_extend_bytes(Cell *cell, const unsigned char *bytes, size_t count) {\n    return (CrustStatus){vector_try_extend(vector_items(cell), bytes, count) ?\n                         CRUST_VECTOR_OK : CRUST_VECTOR_CAPACITY};\n}\n\nstatic CrustStatus vector_try_extend_slice(Cell *cell, VectorSlice slice) {\n    return (CrustStatus){vector_try_append(vector_items(cell), slice.base, slice.length, slice.descends) ?\n                         CRUST_VECTOR_OK : CRUST_VECTOR_CAPACITY};\n}\n\nstatic void vector_push(Cell *cell, const void *value) {\n    if (!vector_try_extend(vector_items(cell), value, 1)) fail("capacité de Vector dépassée");\n}\n\nstatic void vector_push_owned_value(Cell *cell, Cell *value) {\n    vector_push(cell, value->fields);\n    /* Layouts are static; only field handles, never the carrier, are retained. */\n    vector_items(cell)->element_layout = value->layout;\n}\n\nstatic void *vector_push_new(Cell *cell, const void *initial) {\n    vector_push(cell, initial);\n    VectorItems *items = vector_items(cell);\n    return vector_item_at(items, items->length - 1);\n}\n\nstatic unsigned char *vector_checked_item(Cell *cell, int index) {\n    unsigned char *item = index < 0 ? NULL : vector_item_at(vector_items(cell), (size_t)index);\n    if (!item) fail("indice de Vector hors limites");\n    return item;\n}\n\nstatic void vector_read(Cell *cell, int index, void *value) {\n    memcpy(value, vector_checked_item(cell, index), vector_items(cell)->element_size);\n}\n\nstatic void vector_truncate(VectorItems *items, size_t length) {\n    if (length > items->length) fail("réduction de Vector hors limites");\n    size_t removed = (items->length - length) * items->element_size;\n    if (items->region.region.slot) {\n        items->region.region.used -= removed;\n    } else {\n        growth_storage_lock();\n        if (items->span.span.front == GROWTH_LOW) items->span.span.stack->low -= removed;\n        else items->span.span.stack->high += removed;\n        growth_storage_unlock();\n    }\n    items->length = length;\n}\n\nstatic CrustCharStatus vector_pop(Cell *cell, void *value) {\n    VectorItems *items = vector_items(cell);\n    if (!items->length) return CRUST_CHAR_NONE;\n    size_t last = items->length - 1;\n    memcpy(value, vector_item_at(items, last), items->element_size);\n    vector_truncate(items, last);\n    return CRUST_CHAR_OK;\n}\n\ntypedef struct { int status; Cell *value; } VectorHandleResult;\n\nstatic VectorHandleResult vector_pop_local(Cell *vector, Source *source,\n                                            const Source *layout, size_t size, const char *label, Cell *reserved) {\n    VectorHandleResult result = {CRUST_CHAR_NONE, NULL};\n    if (vector_len(vector)) {\n        result.value = reserved ? cell_construct_reserved(reserved, reserved->source, 0, label)\n                                : local_cell_new(source, layout, size, label);\n        result.status = vector_pop(vector, size ? (void *)result.value->fields : (void *)&(int){0});\n    }\n    return result;\n}\ntypedef struct { int status; VectorHandleResult value; } CrustOptionJoinResult;\ntypedef CrustOptionJoinResult CrustExchangeJoinResult;\n\nstatic int vector_replace(Cell *cell, int index, void *value) {\n    VectorItems *items = vector_items(cell);\n    unsigned char *item = index < 0 ? NULL : vector_item_at(items, (size_t)index);\n    if (!item) return CRUST_VECTOR_REJECTED;\n    for (size_t i = 0; i < items->element_size; ++i) {\n        unsigned char incoming = ((unsigned char *)value)[i];\n        ((unsigned char *)value)[i] = item[i];\n        item[i] = incoming;\n    }\n    return CRUST_VECTOR_OK;\n}\n\ntypedef enum {\n    VECTOR_READ_DATA, VECTOR_READ_EOF, VECTOR_READ_FULL, VECTOR_READ_ERROR\n} VectorReadStatus;\n\ntypedef struct {\n    VectorReadStatus status;\n    size_t count;\n    int error;\n} VectorReadResult;\n\nstatic VectorReadResult vector_read_fd(Cell *cell, int fd) {\n    VectorItems *items = vector_items(cell);\n    if (items->element_size != 1) fail("la lecture externe exige un Vector<u8>");\n    GrowthRegion *region = &items->region.region;\n    GrowthSpan *span = &items->span.span;\n    unsigned char *buffer;\n    size_t available;\n    if (region->slot) {\n        buffer = growth_region_extend(region, 0);\n        if (!buffer) fail("région de croissance inactive");\n        available = region->pool->region_size - region->used;\n    } else {\n        GrowthStack *stack = span->stack;\n        if (!stack || stack->fronts[span->front] != span) fail("front de croissance inactif");\n        available = stack->high - stack->low;\n        buffer = stack->mapping.base + stack->low;\n    }\n    if (!available) return (VectorReadResult){.status = VECTOR_READ_FULL};\n    size_t limit = available > INT_MAX ? INT_MAX : available;\n    ssize_t count = read(fd, buffer, limit);\n    if (count < 0) return (VectorReadResult){.status = VECTOR_READ_ERROR, .error = errno};\n    if (!count) return (VectorReadResult){.status = VECTOR_READ_EOF};\n\n    size_t received = (size_t)count;\n    if (region->slot) {\n        growth_region_extend(region, received);\n    } else {\n        unsigned char *published = growth_extend(span, received);\n        if (span->front == GROWTH_HIGH) {\n            memmove(published, buffer, received);\n            for (size_t i = 0; i < received / 2; ++i) {\n                unsigned char first = published[i];\n                published[i] = published[received - i - 1];\n                published[received - i - 1] = first;\n            }\n        }\n    }\n    items->length += received;\n    return (VectorReadResult){.status = VECTOR_READ_DATA, .count = received};\n}\n\nstatic CrustIntPayload vector_read_int(Cell *cell, int fd) {\n    VectorReadResult result = vector_read_fd(cell, fd);\n    switch (result.status) {\n        case VECTOR_READ_DATA: return (CrustIntPayload){0, (int)result.count};\n        case VECTOR_READ_EOF: return (CrustIntPayload){10, 0};\n        case VECTOR_READ_FULL: return (CrustIntPayload){11, 0};\n        case VECTOR_READ_ERROR: return (CrustIntPayload){12, 0};\n    }\n    fail("état de lecture externe inconnu");\n}\n\nstatic void vector_remove(Cell *cell, int index, void *value) {\n    VectorItems *items = vector_items(cell);\n    vector_read(cell, index, value);\n    for (size_t i = (size_t)index; i + 1 < items->length; ++i)\n        memcpy(vector_item_at(items, i), vector_item_at(items, i + 1), items->element_size);\n    vector_truncate(items, items->length - 1);\n}\n\nstatic Cell *string_new(Source *source, uint64_t region_limit, const char *label) {\n    return vector_new(source, region_limit, 1, 1, 1, label);\n}\n\nstatic CrustText string_view(Cell *cell) {\n    VectorItems *items = vector_items(cell);\n    return (CrustText){vector_base(items), items->length, vector_descends(items)};\n}\n\nstatic int string_byte_len(Cell *cell) {\n    size_t length = vector_items(cell)->length;\n    if (length > INT_MAX) fail("longueur de String hors limites Int32");\n    return (int)length;\n}\n\nstatic void string_push_str(Cell *cell, CrustText text) {\n    if (!vector_try_append(vector_items(cell), text.bytes, text.length, text.descends))\n        fail("capacité de String dépassée");\n}\n\nstatic void string_push(Cell *cell, CrustChar value) {\n    unsigned char encoded[4];\n    int width = char_encode(value, encoded);\n    string_push_str(cell, (CrustText){encoded, (size_t)width, 0});\n}\n\nstatic CrustCharResult string_pop(Cell *cell) {\n    VectorItems *items = vector_items(cell);\n    CrustText text = string_view(cell);\n    if (text.length == 0) return (CrustCharResult){CRUST_CHAR_NONE, 0};\n    size_t start = text.length - 1;\n    while (start > 0 && !text_is_boundary(text, start)) --start;\n    CrustChar value;\n    size_t width = text_decode(text, start, &value);\n    if (width == 0 || width != text.length - start) fail("invariant interne : String UTF-8 invalide");\n    vector_truncate(items, start);\n    return (CrustCharResult){CRUST_CHAR_OK, value};\n}\n\nstatic uint8_t byte_result_value(CrustByteResult result) {\n    if (result.status != 0) fail("résultat UTF-8 sans octet");\n    return result.value;\n}\n\n/* Validate the prospective bytes through a four-byte window. No write to\n * the live String is needed until the complete replacement is known valid. */\nstatic unsigned char replacement_byte(VectorSlice replacement, size_t index) {\n    return replacement.base[replacement.descends ? replacement.length - index - 1 : index];\n}\n\nstatic int text_replacement_valid(CrustText text, size_t start, VectorSlice replacement) {\n    for (size_t pos = 0; pos < text.length;) {\n        unsigned char window[4];\n        size_t size = text.length - pos;\n        if (size > sizeof window) size = sizeof window;\n        for (size_t i = 0; i < size; ++i) {\n            size_t index = pos + i;\n            window[i] = index >= start && index - start < replacement.length\n                ? replacement_byte(replacement, index - start) : *text_address(text, index);\n        }\n        CrustChar scalar;\n        size_t width = utf8_decode(window, size, &scalar);\n        if (!width) return 0;\n        pos += width;\n    }\n    return 1;\n}\n\nstatic CrustByteResult string_replace_slice(Cell *cell, int index, VectorSlice replacement) {\n    CrustText text = string_view(cell);\n    size_t count = replacement.length;\n    if (index < 0 || (size_t)index > text.length || count > text.length - (size_t)index)\n        return (CrustByteResult){7, 0};\n    if (count == 0) return (CrustByteResult){0, 0};\n    if (!text_replacement_valid(text, (size_t)index, replacement))\n        return (CrustByteResult){8, 0};\n    size_t first = (size_t)index;\n    uint8_t previous = *text_address(text, first);\n    size_t offset = text.descends ? text.length - first - count : first;\n    unsigned char *target = (unsigned char *)text.bytes + offset;\n    if (replacement.descends != text.descends) {\n        for (size_t i = 0; i < count; ++i)\n            target[count - i - 1] = replacement.base[i];\n    } else {\n        memmove(target, replacement.base, count);\n    }\n    return (CrustByteResult){0, previous};\n}\n\nstatic CrustByteResult string_replace_bytes(Cell *cell, int index,\n                                            const unsigned char *replacement, size_t count) {\n    return string_replace_slice(cell, index, (VectorSlice){replacement, count, 0});\n}\n\nstatic CrustByteResult string_replace_byte(Cell *cell, int index, uint8_t replacement) {\n    return string_replace_bytes(cell, index, &replacement, 1);\n}\n\nstatic void vector_drop(Cell *cell) {\n    VectorItems *items = vector_items(cell);\n    if (items->owns_handles) {\n        for (size_t i = items->length; i > 0; --i) {\n            Cell *element;\n            memcpy(&element, vector_item_at(items, i - 1), sizeof element);\n            cell_drop(element);\n        }\n    }\n    if (items->element_layout) {\n        const Source *layout = items->element_layout;\n        for (size_t i = items->length; i > 0; --i)\n            for (size_t field = layout->field_count; field > 0; --field)\n                if (layout->field_kinds[field - 1] == 2) {\n                    Cell *child;\n                    memcpy(&child, (unsigned char *)vector_item_at(items, i - 1)\n                           + layout->field_offsets[field - 1], sizeof child);\n                    cell_drop(child);\n                }\n    }\n    growth_storage_lock();\n    if (items->region.region.slot) growth_region_unplace(&items->region);\n    else growth_unplace(&items->span);\n    VectorStorage *storage = cell->source->vectors;\n    if (storage->stack.fronts[GROWTH_LOW] || storage->stack.fronts[GROWTH_HIGH])\n        vector_discard_empty_classes(storage);\n    else\n        vector_refresh_front_boundary(storage);\n    growth_storage_unlock();\n}\n\nstatic void vector_storage_close(VectorStorage *storage) {\n    GrowthRegionPool *classes = (GrowthRegionPool *)storage->region_classes.base;\n    for (size_t i = 0; i < storage->class_count; ++i) growth_region_pool_close(&classes[i]);\n    if (classes) source_close(&storage->region_classes);\n    storage->region_classes = (Source){0};\n    storage->class_count = 0;\n    if (storage->stack.mapping.capacity) growth_close(&storage->stack);\n}\n\n/* A view carries its root and offset by value. It never points at another\n   view descriptor, so returning it cannot retain a callee\'s stack variable. */\nstatic CrustStructureView structure_view(Cell *root, size_t offset, size_t size,\n                                         const Source *layout) {\n    if (!root || !root->alive || !layout || root->storage_size < sizeof(Cell))\n        fail("invalid structure view root");\n    size_t available = root->storage_size - sizeof(Cell);\n    if (offset > available || size > available - offset)\n        fail("structure view outside allocation");\n    return (CrustStructureView){root, offset, size, layout};\n}\n\nstatic CrustStructureView structure_subview(CrustStructureView parent, size_t offset,\n                                            size_t size, const Source *layout) {\n    if (offset > parent.size || size > parent.size - offset || offset > SIZE_MAX - parent.offset)\n        fail("structure subview outside parent");\n    return structure_view(parent.root, parent.offset + offset, size, layout);\n}\n\nstatic CrustStructureView structure_whole_view(Cell *cell) {\n    return structure_view(cell, 0, cell->storage_size - sizeof(Cell), cell->layout);\n}\nstatic CrustStructureView structure_reference_identity(CrustStructureView view) { return view; }\nstatic Cell *cell_reference_identity(Cell *cell) { return cell; }\n\n/* The destination\'s type is fixed after all branches have been checked.\n   Convert only the representation, without allocating or moving the target. */\n#define structure_reference_for(destination,value) _Generic((destination), \\\n    CrustStructureView: _Generic((value), CrustStructureView: structure_reference_identity, default: structure_whole_view), \\\n    default: cell_reference_identity)(value)\n\nstatic unsigned char *structure_view_address(CrustStructureView view, size_t offset,\n                                             size_t width) {\n    if (!view.root || !view.root->alive)\n        fail("inactive structure view root");\n    if (offset > view.size || width > view.size - offset)\n        fail("structure field outside view");\n    return (unsigned char *)view.root->fields + view.offset + offset;\n}\n\nstatic void *structure_reference_address(CrustStructureView view) {\n    unsigned char *payload = structure_view_address(view, 0, 0);\n    return view.offset == 0 && view.layout == view.root->layout ? (void *)view.root : (void *)payload;\n}\n\nstatic int structure_view_load_int(CrustStructureView view, size_t offset) {\n    int value;\n    memcpy(&value, structure_view_address(view, offset, sizeof value), sizeof value);\n    return value;\n}\n\nstatic void structure_view_store_int(CrustStructureView view, size_t offset, int value) {\n    memcpy(structure_view_address(view, offset, sizeof value), &value, sizeof value);\n}\n\nstatic Cell *structure_view_load_ref(CrustStructureView view, size_t offset) {\n    Cell *value;\n    memcpy(&value, structure_view_address(view, offset, sizeof value), sizeof value);\n    return value;\n}\n\nstatic void structure_view_store_ref(CrustStructureView view, size_t offset, Cell *value) {\n    (void)structure_view_address(view, offset, sizeof value);\n    cell_store_ref(view.root, view.offset + offset, value);\n}\n\nstatic CrustStructureView cell_load_view(Cell *cell, size_t offset) {\n    CrustStructureView value;\n    memcpy(&value, (unsigned char *)cell->fields + offset, sizeof value);\n    return structure_view(value.root, value.offset, value.size, value.layout);\n}\n\nstatic void cell_store_view(Cell *cell, size_t offset, CrustStructureView value) {\n    memcpy((unsigned char *)cell->fields + offset, &value, sizeof value);\n}\n\nstatic CrustStructureView structure_view_load_view(CrustStructureView view, size_t offset) {\n    (void)structure_view_address(view, offset, sizeof(CrustStructureView));\n    return cell_load_view(view.root, view.offset + offset);\n}\n\nstatic void structure_view_store_view(CrustStructureView view, size_t offset, CrustStructureView value) {\n    (void)structure_view_address(view, offset, sizeof value);\n    cell_store_view(view.root, view.offset + offset, value);\n}\n\nstatic void structure_view_print(CrustStructureView view) {\n    printf("%s(", view.layout->enum_name);\n    for (size_t i=0;i<view.layout->field_count;++i) {\n        size_t offset=view.layout->field_offsets[i];\n        unsigned char kind = view.layout->field_kinds[i];\n        if (i) fputs(", ", stdout);\n        if (kind >= 4) cell_print_numeric_field(kind, structure_view_address(view, offset, 0));\n        else printf("%d", kind ? structure_view_load_ref(view,offset)->value : structure_view_load_int(view,offset));\n    }\n    puts(")");\n}\n\n/* Bodies 