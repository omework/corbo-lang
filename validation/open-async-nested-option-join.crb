async fn wrapped(v:&mut Vector<A<Int>>)-><-Result<Option<A<Int>>,runtime::Error>{let h=runtime::spawn(->extract(v));return <-h.await;}
async fn extract(v:&mut Vector<A<Int>>)-><-Option<A<Int>>{yield;return <-v.pop();}
fn main(){let mut p=pool<Int>(1);let mut vp=pool<Vector<A<Int>>>(1);let mut v=vp.new();
v.push(->p.new(7));let h=runtime::spawn(->wrapped(&mut v));
let result=h.join();drop(->result);
drop(->v);let next=p.new(8);print(*next);}
