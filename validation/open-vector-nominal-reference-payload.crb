struct Point{x:Int}
struct Item{value:&Point}
fn inspect(p:&Point)->Int{return p.x;}
fn main(){let mut points=pool<Point>(1);let p=points.new(x:7);
 let mut items=pool<Item>(1);let mut vectors=pool<Vector<A<Item>>>(1);
 let mut v=vectors.new();v.push(->items.new(value:&p));
 let item=<-v.remove(0);drop(->v);print(inspect(item.value));drop(->item);drop(->p);}
