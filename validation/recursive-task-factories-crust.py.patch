+    def inherited_async_storage(self, symbols, params, bindings):
+        """Instantiate a finite graph carried by a parameter, including its root."""
+        groups = []
+        for symbol in symbols:
+            if symbol.kind not in ('allocation_parameter', 'allocation_field_parameter',
+                                   'task_result_parameter', 'task_result_field_parameter'):
+                continue
+            binding = bindings[params[symbol.index][0]]
+            if symbol.kind.startswith('allocation'):
+                roots = binding.referents or (binding.alloc,)
+                if symbol.kind == 'allocation_field_parameter':
+                    roots = tuple(child for root in roots
+                                  for child in self.aggregate_field_targets(root, symbol.name))
+                for root in roots:
+                    groups.append((AsyncFieldStorage('', root.sources, root.origins, root.variants),
+                                   *self.owned_field_storage(root.owned_fields)))
+            else:
+                allocation = binding.alloc
+                if symbol.kind == 'task_result_parameter':
+                    groups.append((AsyncFieldStorage('', allocation.task_result_sources,
+                        allocation.task_result_origins, allocation.task_result_variants),
+                        *allocation.task_result_fields))
+                else:
+                    prefix = symbol.name + '/'
+                    groups.append(tuple(AsyncFieldStorage(path[len(prefix):] if path.startswith(prefix) else '',
+                        sources, origins, getattr(record, 'variants', frozenset()))
+                        for record in allocation.task_result_fields
+                        for path, sources, origins in (record,)
+                        if path == symbol.name or path.startswith(prefix)))
+        return self.merge_async_result_fields(*groups)
+
+    def instantiate_async_result_fields(self, summary, params, bindings, fresh_origins):
+        fields = {record.path: record for record in self.inherited_async_storage(
+            summary.task_result_sources, params, bindings) if record.path}
+        for path, symbols in summary.task_result_fields:
+            inherited = self.inherited_async_storage(symbols, params, bindings)
+            root = next((record for record in inherited if not record.path), None)
+            sources, origins = self.resolve_async_sources(symbols, params, bindings, fresh_origins)
+            fields[path] = AsyncFieldStorage(path, sources, origins,
+                                             root.variants if root else frozenset())
+            for record in inherited:
+                if record.path:
+                    nested_path = path + '/' + record.path
+                    fields[nested_path] = replace(record, path=nested_path)
+        return tuple(fields[path] for path in sorted(fields))
 
