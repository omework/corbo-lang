struct Point { x: Int, y: Int }
struct Segment { debut: Point, fin: Point }

fn modifier(point: &mut Point) {
    point.x = 20;
}

fn main() {
    let mut segment = Segment {
        debut: Point { x: 1, y: 2 },
        fin: Point { x: 3, y: 4 }
    };
    let mut vue = &mut segment.debut;
    modifier(vue);
    print(segment.fin.x);
    print(vue.x);
}
