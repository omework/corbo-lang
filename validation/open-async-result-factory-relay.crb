struct Point{x:Int}fn make(n:Int)-><-Point{let p=Point{x:n};return <-p;}async fn leaf(n:Int)-><-Point{let p=make(n);yield;return <-p;}fn prepare(n:Int)-><-leaf{let t=leaf(n);return <-t;}async fn relay(n:Int)-><-Point{return <-prepare(n).await;}fn main(){let h=runtime::spawn(->relay(7));match h.join(){Ok(q)=>{print(q.x);drop(->q);},Err(_)=>{}}}
