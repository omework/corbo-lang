struct Point{x:Int}async fn take(mut v:->A<Vector<Point>>)-><-Option<Point>{yield;return <-v.pop();}
fn main(){let mut p=pool<Vector<Point>>(1);let mut v=p.new();v.push(->Point{x:7});
let h=runtime::spawn(->take(->v));match h.join(){Ok(out)=>{match (->out){Some(point)=>{print(point.x);drop(->point);},None=>{print(0);}}},Err(_)=>{print(99);}}}