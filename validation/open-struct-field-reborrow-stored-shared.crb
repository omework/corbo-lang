struct Writer{data:&mut Int}
struct View{left:Int,data:&Int,right:Int}
           async fn work(v:& View)->&Int{yield;return v.data;}
          fn main(){let mut memory=pool<Int>(1);let mut data=memory.new(7);
            let mut writers=pool<Writer>(1);let mut writer=writers.new(data:&mut data);
let parent=&mut *writer.data;let mut views=pool<View>(1);let mut v=views.new(left:2,data:&*parent,right:3);
            let h=runtime::spawn(->work(& v));
            let r=match h.join(){Ok(n)=>{n},Err(_)=>{return;}};
            drop(->v);print(r);drop(->writer); print(data);}
