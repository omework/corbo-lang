struct Point{x:Int}async fn work()->Int{
let mut p=pool<Point>(1);let mut ints=pool<Int>(1);let mut vectors=pool<Vector<A<Point>>>(1);
let mut v=vectors.new();v.push(->p.new(x:7));let incoming=ints.new(8);
let r=<-v.replace(0,->incoming);drop(->r);drop(->v);return 1;}
fn main(){let h=runtime::spawn(->work());match h.join(){Ok(n)=>{print(n);},Err(_)=>{}}}