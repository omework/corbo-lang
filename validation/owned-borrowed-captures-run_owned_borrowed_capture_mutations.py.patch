+"""Mutate capture dependencies and cleanup in disposable compiler copies."""
+from pathlib import Path
+import shutil,sys,tempfile
+from run_suspended_cleanup_mutations import run
+ROOT=Path(__file__).resolve().parents[1]
+MUTATIONS=(
+ ('forget_concrete_capture','crust.py',
+  "dependencies.append((f'{access}.{index}', (borrowed,)))",'pass',
+  'test_direct_launch_failure_and_inactive_cleanup'),
+ ('downgrade_mutable_capture','crust.py',
+  'access = self.dependency_mode(carrier, borrowed)',"access = 'ref'",
+  'test_mutable_field_exclusive_until_join'),
+ ('forget_factory_field','results.py',
+  "origins = self.owned_capture_field_targets(value, field)\n                                captures.append((f'{access}.{index}', origins))",
+  "origins = self.owned_capture_field_targets(value, field)\n                                pass",
+  'test_factory_and_relay_keep_field_contract'),
+ ('forget_task_parameter_fields','results.py',
+  "fields += tuple((f'{access}.{position}',", "fields += () if True else tuple((f'{access}.{position}',",
+  'test_task_relay_keeps_owned_capture_loans'),
+ ('forget_child_loans','async_lowering.py',
+  'loans.extend(loan for group in owned_capture_field_loans(value, typ).values() for loan in group)',
+  'pass', 'test_async_caller_transfers_field_loans'),
+ ('forget_bridge_targets','crust.py',
+  "                if declared in ('&Int', '&mut Int'):\n                    target_pointer =",
+  '                if False:\n                    target_pointer =',
+  'test_async_caller_transfers_field_loans'),
+ ('leak_inactive_owner','async_lowering.py',
+  "inactive_cleanup.append(f'if ({cell}) cell_drop({cell});')",'pass',
+  'test_direct_launch_failure_and_inactive_cleanup'),
+ ('impose_native_pool','native_threads.py',
+  "if m == 'owned' and t not in self.structures", "if m == 'owned'",
+  'test_native_thread_capture'),
+)
+def main():
+ suite='test_async_owned_borrowed_captures.OwnedBorrowedCaptureTests'
+ baseline=run(ROOT,suite)
+ print('BASELINE',baseline.returncode,baseline.stdout+baseline.stderr,flush=True)
+ if baseline.returncode:return 1
+ success=True
+ for name,filename,before,after,method in MUTATIONS:
+  with tempfile.TemporaryDirectory(prefix='crust-owned-borrowed-mutant-') as directory:
+   target=Path(directory)
+   for p in ROOT.glob('*.py'):shutil.copy2(p,target/p.name)
+   path=target/filename;source=path.read_text()
+   assert source.count(before)==1,(name,source.count(before))
+   path.write_text(source.replace(before,after));result=run(target,suite+'.'+method)
+  detected=result.returncode==1 and ('AssertionError' in result.stderr or 'crust.Error:' in result.stderr)
+  print(name,'DETECTED' if detected else 'SURVIVED' if not result.returncode else 'INCONCLUSIVE',flush=True)
+  print(result.stdout+result.stderr,flush=True);success &= detected
+ return int(not success)
+if __name__=='__main__':sys.exit(main())
