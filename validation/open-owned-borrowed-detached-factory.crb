struct Pair { left: &Int, right: &Int }
async fn detach(v: -> Pair) -> &Int { yield; return v.left; }
fn make(v: -> Pair) -> <- detach { return <- detach(->v); }
fn main() {
    let mut ns = pool<Int>(2);
    let a = ns.new(7);
    let b = ns.new(9);
    let v = Pair { left: &a, right: &b };
    let h = runtime::spawn(->make(->v));
    let view = match h.join() { Ok(view) => { view }, Err(_) => { return; } };
    drop(->b);
    print(*view);
    drop(->a);
}
