struct View{value:&Int}async fn work()->Int{let mut p=pool<Int>(1);let number=p.new(7);
let mut views=pool<Vector<View>>(1);let mut values=views.new();
let item=View{value:&number};values.push(->item);
let result=<-values.remove(0);drop(->values);print(*result.value);return 0;}
fn main(){let h=runtime::spawn(->work());match h.join(){Ok(n)=>{print(n);},Err(_)=>{print(99);}}}
