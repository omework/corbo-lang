struct Item{value:&Int}
fn make(p:&mut Pool<Item>,vp:&mut Pool<Vector<A<Item>>>,n:&Int)-><-A<Vector<A<Item>>>{let mut v=vp.new();v.push(->p.new(value:n));return <-v;}
fn main(){let mut ns=pool<Int>(1);let n=ns.new(7);let mut p=pool<Item>(1);let mut vp=pool<Vector<A<Item>>>(1);
let mut v=make(&mut p,&mut vp,&n);let item=<-v.remove(0);print(*item.value);drop(->item);drop(->v);drop(->n);}
