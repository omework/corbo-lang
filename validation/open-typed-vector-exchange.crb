struct Point{x:Int}
fn main(){
    let mut points=pool<Point>(2);
    let mut vectors=pool<Vector<A<Point>>>(1);
    let mut values=vectors.new();
    let first=points.new(x:7);values.push(->first);
    let incoming=points.new(x:9);
    let result=<-values.replace(0,->incoming);
    drop(->result);drop(->values);
}
