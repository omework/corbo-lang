+    @staticmethod
+    def merge_task_variants(groups):
+        groups = tuple(groups)
+        # An unknown alternative must not be narrowed by a known one.
+        return frozenset().union(*groups) if groups and all(groups) else frozenset()
+
+    def resolve_task_variants(self, summary, params, bindings):
+        definition = self.async_definitions[summary.typ][0]
+        output = definition.args[2][1]
+        all_variants = frozenset(self.enums.get(output, {}))
+        if not all_variants:
+            return frozenset()
+        groups = []
+        for source in summary.task_result_sources:
+            if source.kind in ('task_result_parameter', 'task_parameter'):
+                groups.append(bindings[params[source.index][0]].alloc.task_result_variants or all_variants)
+            elif source.kind == 'allocation_parameter' and params[source.index][2] == output:
+                groups.append(bindings[params[source.index][0]].alloc.variants or all_variants)
+            else:
+                effect = getattr(definition, 'field_effect_summary', None)
+                result = effect.completion_result if effect and effect.complete else None
+                groups.append(result.fresh_variants if result and result.fresh_variants
+                              and all(c.kind == 'fresh' for c in result.candidates) else all_variants)
+        return self.merge_task_variants(groups) or all_variants
+
+    def owned_path_possible(self, allocation, path):
+        """Exclude only a path whose arm is proven absent on every owned route."""
+        field, separator, rest = path.partition('/')
+        arm = field.partition('.')[0]
+        if allocation.variants and arm not in allocation.variants:
+            return False
+        if not separator:
+            return True
+        children = dict(allocation.owned_fields).get(field, ())
+        return not children or any(self.owned_path_possible(child, rest) for child in children)
