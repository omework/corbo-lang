+  "state['origins'] | state['item_origins']", 'test_recorded_and_target_lifetime'),
+ ('omit_nested_output_destination','async_result_storage.py',
+  "if node.args[2][0] not in ('owned', 'join_owned', 'join_nested') or node.args[2][1] not in structures",
+  "if node.args[2][0] != 'owned' or node.args[2][1] not in structures",
+  'test_direct_await_envelope_preserves_loans'),
+ ('forget_constraint_result_asset','constraints.py',
+  "if plan.destination:\n                    output = self.born(('task_output', id(expr)),",
+  "if False:\n                    output = self.born(('task_output', id(expr)),",
+  'test_named_envelope_and_relay'),
+ ('erase_feature_payload_storage','type_features.py',
+  "return (tuple(normalized(mode, concrete if index == 0 and concrete is not None else typ,\n                                 name in node.handle_parameters or joined.get(name) == 'pool')\n                      for index, (name, mode, typ) in enumerate(params)),\n                normalized(*result, node.handle_result or getattr(node, 'join_storage_result', None) == 'pool', result=True))",
+  "return (tuple(normalized(mode, concrete if index == 0 and concrete is not None else typ,\n                                 name in node.handle_parameters)\n                      for index, (name, mode, typ) in enumerate(params)),\n                normalized(*result, node.handle_result, result=True))",
+  'test_feature_signatures_keep_payload_storage'),
+)
+
+def main():
+ suite='test_local_result_envelopes.LocalResultEnvelopeTests'
+ baseline=run(ROOT,suite)
+ print('BASELINE',baseline.returncode,baseline.stdout+baseline.stderr,flush=True)
+ if baseline.returncode:return 1
+ success=True
+ for name,filename,before,after,method in MUTATIONS:
+  with tempfile.TemporaryDirectory(prefix='crust-local-envelope-mutant-') as directory:
+   target=Path(directory)
+   for path in ROOT.glob('*.py'):shutil.copy2(path,target/path.name)
+   path=target/filename;source=path.read_text()
+   assert source.count(before)==1,(name,source.count(before))
+   path.write_text(source.replace(before,after));result=run(target,suite+'.'+method)
+  detected=result.returncode==1 and ('AssertionError' in result.stderr or 'crust.Error:' in result.stderr)
+  print(name,'DETECTED' if detected else 'SURVIVED' if not result.returncode else 'INCONCLUSIVE',flush=True)
+  print(result.stdout+result.stderr,flush=True);success &= detected
+ return int(not success)
+
+if __name__=='__main__':sys.exit(main())
