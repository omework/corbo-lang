+"""Fault injection for Result payload storage and borrowed-target contracts."""
+from pathlib import Path
+import shutil
+import sys
+import tempfile
+from run_suspended_cleanup_mutations import run
+
+ROOT=Path(__file__).resolve().parents[1]
+MUTATIONS=(
+ ('invent_absent_payload_identity','crust.py',
+  '            payload.origins = frozenset()',
+  '            payload.origins = frozenset({payload.id})',
+  'test_proven_absent_local_payload_through_contracts'),
+ ('forget_absence_constraint_contract','constraints.py',
+  'absent_owned_payload=not assets and (result.absent_owned_payload or',
+  'absent_owned_payload=False and (result.absent_owned_payload or',
+  'test_proven_absent_local_payload_through_contracts'),
+ ('forget_absence_loop_result','crust.py',
+  'absent=all(a.absent_owned_payload for a in values)', 'absent=False',
+  'test_proven_absent_local_payload_through_contracts'),
+ ('erase_possible_completion','results.py',
+  'effects.may_complete is False or\n                            effects.completion_result.absent_owned_payload',
+  'True or\n                            effects.completion_result.absent_owned_payload',
+  'test_possible_completion_preserves_local_payload'),
+ # Removing only the early return check survives because result construction
+ # checks the declared storage again. That historical mutant and its fallback
+ # diagnostic are retained in validation/local-result-envelopes-*-audit.log.
+ ('omit_join_storage_compatibility','crust.py',
+  '        if len(kinds) > 1:', '        if False:',
+  'test_control_results_preserve_loans_and_storage_type'),
+ ('omit_annotation_storage_check','crust.py',
+  "if any((source.kind == 'local_stack') != (expected[2] == 'local') for source in allocation.sources):",
+  'if False:', 'test_loop_envelope_reuse_and_annotations'),
+ ('omit_parameter_storage_requirements','storage_requirements.py',
+  "joined = dict(getattr(node, 'join_storage_parameters', ()))", 'joined = {}',
+  'test_two_storage_kind_model'),
+ ('omit_contract_result_storage','contracts.py',
+  "join_storage_result=getattr(node, 'join_storage_result', None)", 'join_storage_result=None',
+  'test_modular_bridge_and_declared_storage'),
+ ('omit_modular_borrowed_fields','crust.py',
+  "dependencies, variants, parents = self.resolve_borrowed_result(result, params, bindings) if result.mode in ('owned', *JOIN_RESULT_TYPES) else ((), frozenset(), ())",
+  "dependencies, variants, parents = self.resolve_borrowed_result(result, params, bindings) if result.mode == 'owned' else ((), frozenset(), ())",
+  'test_named_envelope_and_relay'),
+ ('omit_join_payload_borrows','crust.py',
+  '        payload.dependencies = borrowed_fields', '        payload.dependencies = ()',
+  'test_recorded_and_target_lifetime'),
