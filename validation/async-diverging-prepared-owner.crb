async fn hold(junk:->Int,n:Int){print(*junk);print(n);}
async fn pick(flag:Int,a:&mut Int,junk:->Int)->&mut Int{
 let inactive=hold(->junk,if flag==1{yield;return a;}else{yield;return a;});
 inactive.await;return a;
}
fn main(){let mut p=pool<Int>(1);let mut a=p.new(10);
 let mut garbage=pool<Int>(1);let junk=garbage.new(77);
 let h=runtime::spawn(->pick(1,&mut a,->junk));
 match h.join(){Ok(r)=>{let reused=garbage.new(88);print(reused);*r=42;},Err(_)=>{print(999);}}
 print(a);
}