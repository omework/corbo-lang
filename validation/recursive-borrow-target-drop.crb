enum Node{End{value:&Int},Link{next:A<Node>}}fn peek(n:&Node){match &n{
Node.End{value:v}=>{print(*v);},Node.Link{next:a}=>{match &a{
Node.End{value:v}=>{print(*v);},Node.Link{next:b}=>{match &b{
Node.End{value:v}=>{print(*v);},Node.Link{next:_}=>{print(0);}}}}}}}async fn work()->Int{let mut numbers=pool<Int>(1);let mut number=numbers.new(7);let mut ends=pool<Node>(1);let mut links=pool<Node>(2);
let end=new(ends) Node.End{value:&number};let mid=new(links) Node.Link{next:<-end};
let top=new(links) Node.Link{next:<-mid};drop(->number);yield;peek(&top);drop(->top);return 8;}
        fn main(){let h=runtime::spawn(->work());match h.join(){Ok(r)=>{print(r);},Err(_)=>{print(99);}}}