struct Item{value:&Int}
fn take(v:&mut Vector<A<Item>>)-><-Option<A<Item>>{return <-v.pop();}
fn main(){let mut ns=pool<Int>(1);let n=ns.new(7);
    let mut p=pool<Item>(1);let mut vp=pool<Vector<A<Item>>>(1);let mut v=vp.new();
    v.push(->p.new(value:&n));let result=take(&mut v);match (->result){Some(item)=>{print(*item.value);drop(->item);},None=>{print(0);}}
    drop(->v);drop(->n);}
