async fn work(n:->A<Int>)-><-A<Int>{yield;return <-n;}async fn wrapped1(n:->A<Int>)-><-Result<A<Int>,runtime::Error>{let h=runtime::spawn(->work(->n));return <-h.await;}async fn wrapped2(n:->A<Int>)-><-Result<Result<A<Int>,runtime::Error>,runtime::Error>{let h=runtime::spawn(->wrapped1(->n));return <-h.await;}fn main(){let mut p=pool<Int>(1);let n=p.new(7);
        let h=runtime::spawn(->wrapped2(->n));match h.join(){Ok(inner2)=>{match inner2{Ok(inner1)=>{match inner1{Ok(value)=>{print(*value);drop(->value);},Err(_)=>{print(90);}}},Err(_)=>{print(91);}}},Err(_)=>{print(92);}}
        let next=p.new(8);print(*next);}