struct View { data: &Int }
async fn read(view: -> View) -> Int {
    yield;
    return *view.data;
}
fn make(v:->View)-><-read{let t=read(->v);return <-t;}fn main() {
    let mut numbers = pool<Int>(1);
    let number = numbers.new(7);
    let view = View { data: &number };
    let execution = runtime::spawn(->make(->view));
    drop(->number);match execution.join() {
        Ok(value) => { print(value); },
        Err(_) => { print(99); }
    }
    
}
