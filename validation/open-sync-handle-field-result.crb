struct Point{x:Int,y:Int}
async fn leaf(p:&Point)->&Int{yield;return &p.x;}
fn launch(p:&Point)-><-runtime::Handle<&Int>{let h=runtime::spawn(->leaf(p));return <-h;}
async fn parent(p:&Point)->&Int{let h=launch(p);match h.await{Ok(v)=>{return v;},Err(_)=>{return &p.x;}}}
fn main(){let p=Point{x:7,y:8};let h=runtime::spawn(->parent(&p));match h.join(){Ok(v)=>{print(*v);},Err(_)=>{}}}
