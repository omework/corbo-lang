fn take(r:->Result<A<Point>,A<Point>>)-><-Point{match (->r){Ok(n)=>{return <-n;},Err(n)=>{return <-n;}}}struct Point{x:Int}fn main(){let mut p=pool<Point>(1);let mut q=pool<Point>(1);
    let mut vectors=pool<Vector<A<Point>>>(1);let mut v=vectors.new();
    let first=p.new(x:7);v.push(->first);let incoming=q.new(x:9);
    let r=<-v.replace(0,->incoming); let item=take(->r);print(item.x);drop(->item);
    let current=<-v.remove(0);print(current.x);drop(->current);drop(->v);
    let a=p.new(x:10);let b=q.new(x:11);print(a.x);print(b.x);}