urce->pool ? "pool capacity exceeded" : "data stack capacity exceeded");\n    return cell;\n}\nstatic Cell *local_cell_new(Source *stack, const Source *layout, size_t payload_size,\n                            const char *label) {\n    size_t alignment = _Alignof(Cell);\n    if (!stack->stack || stack->pool) fail("local value requires a data stack");\n    if (payload_size > SIZE_MAX - sizeof(Cell) - (alignment - 1))\n        fail("local value layout too large");\n    size_t size = (sizeof(Cell) + payload_size + alignment - 1) / alignment * alignment;\n    data_slots_lock();\n    Cell *cell = cell_try_new_sized_unlocked(stack, size, 0, label);\n    if (cell) cell->layout = layout;\n    data_slots_unlock();\n    if (!cell) fail("data stack capacity exceeded");\n    return cell;\n}\nstatic Cell *cell_reserve_for_transfer(Source *source, size_t shorter_slots) {\n    data_slots_lock();\n    Cell *cell = NULL;\n    size_t available = source->pool ? source->capacity / source->stride - source->live\n                                    : (source->capacity - source->used) / source->stride;\n    if (available > shorter_slots)\n        cell = cell_try_new_unlocked(source, 0, NULL);\n    data_slots_unlock();\n    return cell;\n}\nstatic Cell *cell_construct_reserved(Cell *reserved, Source *source, int value, const char *label) {\n    if (!reserved) return cell_new(source, value, label);\n    if (reserved->source != source || !reserved->alive || reserved->label)\n        fail("réservation de slot incompatible avec la construction");\n    reserved->value = value;\n    reserved->label = label;\n    return reserved;\n}\nstatic Cell *enum_new(Source *source, size_t tag, const char *label) {\n    if (!source->arms || tag >= source->arm_count) fail("internal error: invalid enum pool");\n    return cell_new(&source->arms[tag], 0, label);\n}\nstatic int cell_has_source(Cell *cell, Source *source) {\n    if (cell->source == source) return 1;\n    /* Enum cells point at their private arm, 