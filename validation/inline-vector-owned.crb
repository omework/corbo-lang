struct Item{value:A<Int>}
fn main(){let mut numbers=pool<Int>(1);let number=numbers.new(7);
 let mut vectors=pool<Vector<Item>>(1);let mut v=vectors.new();
 let item=Item{value:<-number};v.push(->item);
 let out=<-v.remove(0);drop(->v);print(*out.value);drop(->out);
 let again=numbers.new(9);print(*again);}