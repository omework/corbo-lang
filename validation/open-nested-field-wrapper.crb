struct Inner { view: &Int }
struct Outer { inner: A<Inner> }
fn change(value: &mut Inner, target: &Int) { value.view = &*target; }
fn change_outer(value:&mut Outer,target:&Int){change(&mut *value.inner,target);}
async fn consume(value: -> Outer) -> Int { yield; drop(->value); return 1; }
fn make(value: -> Outer) -> <-consume { return <-consume(->value); }
async fn work() -> Int {
    let mut numbers = pool<Int>(2);
    let first = numbers.new(7);
    let second = numbers.new(9);
    let mut inners = pool<Inner>(1);
    let inner = inners.new(view: &first);
    let mut outer = Outer { inner: <-inner };
    change_outer(&mut outer,&second);
    let task = make(->outer);
    drop(->first);
    let result = task.await;
    drop(->second);
    return result;
}
fn main() {
    let handle = runtime::spawn(->work());
    match handle.join() { Ok(n) => { print(n); }, Err(_) => { print(99); } }
}
